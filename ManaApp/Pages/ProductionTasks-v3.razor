<!-- ProductionTasks-v3.razor -->

@page "/productiontasks-v3"

@using ManaApp.Components
@using ManaApp.Models
@using ManaApp.Components.Production
@inject HttpClient Http
@inject NavigationManager Nav



<div class="ptv3-root">

    <!-- TOOLBAR -->
    <ProductionTasksToolbar
        BatchList="GetBatchList()"
        ParentCategoryId="@ParentCategoryIdFilter"
        ParentCategoryIdChanged="@(v => ParentCategoryIdFilter = v)"
        ItemTypeFilter="@ItemTypeFilter"
        ItemTypeFilterChanged="@(v => ItemTypeFilter = v)"
        @bind-SelectedBatch="SelectedBatchFilter"
        @bind-DetailFilter="DetailFilter"
        @bind-AssemblyFilter="AssemblyFilter"
        @bind-ShowCompleted="ShowCompleted"
        @bind-SearchText="SearchText"
        ShowRelatedRows="ShowRelatedRows"
        CanShowRelated="CanShowRelatedRows"
        ToggleRelatedRowsClicked="ToggleRelatedRows"
        OnFiltersChanged="ResetSelection" />

    <!-- MAIN CONTENT -->
<div class="ptv3-main">

    <table class="ptv3-table">

        <thead>
<tr>
    <th class="ptv3-batch-main">Batch</th>
    <th class="ptv3-batch-flag"></th>
    <th>Kategorija</th>
    <th>Nosaukums</th>
    <th>Detaļa</th>
    <th>Kods</th>
    <th>Versija</th>
    <th>Plānots</th>
    <th>Sold</th>
    <th>Done</th>

    <th>Detaļas</th>
    <th class="ptv3-details-plus">Det +</th>
    <th class="ptv3-col-small">Detail</th>
    <th class="ptv3-col-small">Assembly</th>
    <th>Fin</th>
    <th class="ptv3-col-wide">Finishing</th>
    <th class="ptv3-fin-plus">F+</th>
    <th>Komentārs</th>
</tr>
</thead>

<tbody>

@foreach (var b in ProductBatches
    .Where(x =>

            (
                !ShowRelatedRows

                || SelectedBatch == null

                || (
                    x.BatchId == SelectedBatch.BatchId
                    && x.VersionId == SelectedBatch.VersionId
                )
            )

            &&
            (string.IsNullOrWhiteSpace(SelectedBatchFilter)
                || x.BatchCode == SelectedBatchFilter)
           &&
                (
                    (ShowCompleted && x.IsCompleted)

                    || (!ShowCompleted && !x.IsCompleted)
                )
            &&
                (
                    ParentCategoryIdFilter == null
                    || x.ParentCategoryId == ParentCategoryIdFilter
                )
            &&
                (
                    string.IsNullOrWhiteSpace(ItemTypeFilter)

                    || (ItemTypeFilter == "product" && x.IsProduct)

                    || (ItemTypeFilter == "detail" && !x.IsProduct)
                )
            &&
                (
                    string.IsNullOrWhiteSpace(DetailFilter)
                    || x.DetailStatus == DetailFilter
                )
            &&
                    (
                        string.IsNullOrWhiteSpace(AssemblyFilter)
                        || x.AssemblyStatus == AssemblyFilter
                    )
            &&
            (
                string.IsNullOrWhiteSpace(SearchText)

                || (x.BatchCode ?? "")
                    .Contains(SearchText, StringComparison.OrdinalIgnoreCase)

                || (x.ProductCode ?? "")
                    .Contains(SearchText, StringComparison.OrdinalIgnoreCase)

                || (AllProducts.FirstOrDefault(p => p.productCode == x.ProductCode)?.productName ?? "")
                    .Contains(SearchText, StringComparison.OrdinalIgnoreCase)

                || (x.DetailName ?? "")
                    .Contains(SearchText, StringComparison.OrdinalIgnoreCase)

                || (x.HiddenDetailNames ?? "")
                    .Contains(SearchText, StringComparison.OrdinalIgnoreCase)
            )
        )
    .ToList())
{
<tr class="@(SelectedBatch?.BatchProductId == b.BatchProductId ? "ptv3-active" : "")"
    @onclick="() => OnRowClick(b)">

    <td class="ptv3-batch-main">@b.BatchCode</td>
    <td class="ptv3-batch-flag">
        @(b.ProductToPartId != null ? "!" : GetBatchFlag(b))
    </td>
    <td>@b.CategoryName</td>
    <td>@AllProducts.FirstOrDefault(x => x.productCode == b.ProductCode)?.productName</td>
    <td>@b.DetailName</td>
    <td>@b.ProductCode</td>
    <td>
        @b.VersionName

        @if (!b.VersionIsActive)
        {
            <span style="color:red;font-weight:700;">*</span>
        }
    </td>
    <td>@b.Planned</td>
    <td>@(b.Planned > 0 ? b.Sold : 0)</td>
    <td>@(b.Planned > 0 ? b.Done : 0)</td>
    <td>
        @(b.ProductToPartId != null
            ? "-"
            : b.DetailsTotal > 0
                ? $"{b.DetailsDone}/{b.DetailsTotal}"
                : "0/0")
    </td>

    <td class="ptv3-details-plus">
        @($"{b.DetailsChildDone}/{b.DetailsChildTotal}")
    </td>

    <td class="ptv3-col-small @(b.DetailFinish != null ? "ptv3-detail-finish" 
                : b.DetailStart != null ? "ptv3-detail-start" 
                : "")">

            @if (b.DetailFinish.HasValue)
                {
                    @b.DetailFinish.Value.ToString("dd.MM.yyyy")
                }
                else if (b.DetailStart.HasValue)
                {
                    @b.DetailStart.Value.ToString("dd.MM.yyyy")
                }

    </td>
    <td class="ptv3-col-small @(b.ProductToPartId != null
        ? "ptv3-disabled-cell"
        : b.AssemblyFinishDate != null
            ? "ptv3-detail-finish"
            : b.AssemblyStart != null
                ? "ptv3-detail-start"
                : "")">

                @if (b.ProductToPartId != null)
                    {
                        <span>-</span>
                    }
                else if (b.AssemblyFinishDate != null)
                    {
                        @b.AssemblyFinishDate?.ToString("dd.MM.yyyy")
                    }
                else if (b.AssemblyStart != null)
                    {
                        @b.AssemblyStart?.ToString("dd.MM.yyyy")
                    }

    </td>

<td class="@GetFinCellClass(b)">
    @($"{b.FinishingInProgress}/{b.AssemblyFinish}")
</td>

<td class="fin-hover ptv3-col-wide">
    <div class="fin-bar">
        @foreach (var seg in GetFinSegments(b))
        {
            <div class="@seg"></div>
        }
    </div>

    <div class="fin-tooltip">
        @GetFinHover(b)
    </div>
</td>
<td class="ptv3-fin-plus"></td>
<td class="ptv3-comment" title="@b.Comment">

    <div class="ptv3-comment-row">

        <span>
            @(string.IsNullOrWhiteSpace(b.Comment) ? "-" : b.Comment)
        </span>

        <button class="ptv3-comment-btn"
                @onclick="() => EditComment(b)">
            ✎
        </button>

    </div>

</td>

</tr>

}

</tbody>

    </table>

</div>

    <!-- DETAIL PANEL -->
@if (SelectedBatch != null)
{
    <div class="ptv3-detail">

        <ProductionTasksDetailPanel
            SelectedBatch="SelectedBatch"
            IsReadOnly="false"
            IsChildRowSelected="false"
            SelectedChildPartId="null"
            OnDataChanged="HandleDetailChanged" />

    </div>
}

</div>

@if (ShowCommentPopup && EditingRow != null)
{
    <div class="orders-popup-overlay">

    <div class="delete-popup">

        <h3>
            Komentārs
        </h3>

            <textarea class="ptv3-popup-text"
                      @bind="EditingComment">
            </textarea>

            <div class="ptv3-popup-buttons">

                <button @onclick="SaveComment">
                    Saglabāt
                </button>

                <button @onclick="CloseCommentPopup">
                    Atcelt
                </button>

            </div>

        </div>

    </div>
}

@code {

[Parameter]
[SupplyParameterFromQuery]
public int? BatchProductId { get; set; }
[Parameter] public bool IsReadOnly { get; set; }
    private ProductBatchRow? SelectedBatch;
    private string SearchText = "";
    private string SelectedBatchFilter = "";
    private string DetailFilter = "";

private void SelectRow(int batchProductId)
{
    SelectedBatch = ProductBatches
        .FirstOrDefault(x => x.BatchProductId == batchProductId);

    if (SelectedBatch != null)
        SelectedBatch.IsReadOnlyChild = false;
}

private List<ProductBatchRow> ProductBatches = new();
private List<ProductRow> AllProducts = new();
private Dictionary<string, ProductRow> ProductsByCode = new();
private Dictionary<int, VersionSummaryDto> VersionSummary = new();
private Dictionary<int, string> BatchCodes = new();
protected override async Task OnInitializedAsync()
{
        ProductBatches = await Http.GetFromJsonAsync<List<ProductBatchRow>>(
            "http://localhost:5270/api/batches/list-production-v2"
        ) ?? new();

    AllProducts = await Http.GetFromJsonAsync<List<ProductRow>>(
        "http://localhost:5270/api/products/planning-list"
    ) ?? new();

    var versionIds = AllProducts
    .Where(x => x.VersionId.HasValue)
    .Select(x => x.VersionId!.Value)
    .Distinct()
    .ToList();

    var summaryUrl = "http://localhost:5270/api/production/overview-by-versions";

    if (versionIds.Any())
    {
        var query = string.Join("&versionIds=", versionIds);
        summaryUrl += $"?versionIds={query}";
    }

    var summaries = await Http.GetFromJsonAsync<List<VersionSummaryDto>>(summaryUrl)
                    ?? new();

    VersionSummary = summaries.ToDictionary(x => x.VersionId);

    VersionSummary = summaries.ToDictionary(x => x.VersionId);

    BatchFlags = await Http.GetFromJsonAsync<Dictionary<string, string>>(
    "http://localhost:5270/api/batches/batch-flags"
) ?? new();

if (BatchProductId.HasValue)
{
    SelectedBatch = ProductBatches
        .FirstOrDefault(x => x.BatchProductId == BatchProductId.Value);

    StateHasChanged();
}
            }

private string GetBatchFlag(ProductBatchRow b)
{
    var key = $"{b.BatchId}_{b.VersionId}";
    return BatchFlags.TryGetValue(key, out var f) ? f : "";
}

private string GetFinCellClass(ProductBatchRow b)
{
    var x = b.FinishingInProgress;
    var y = b.AssemblyFinish;

    if (x == 0 && y > 0)
        return "fin-yellow";

    if (x == y && y > 0)
        return "fin-green";

    if (x < y)
        return "fin-blue";

    return "";
}

private List<string> GetFinSegments(ProductBatchRow b)
{
    
    var segments = new List<string>();

    var total = b.AssemblyFinish;

    for (int i = 0; i < b.FinStatus3; i++)
        segments.Add("fin-seg-green");

    for (int i = 0; i < b.FinStatus2; i++)
        segments.Add("fin-seg-yellow");

    for (int i = 0; i < b.FinStatus1; i++)
        segments.Add("fin-seg-gray");

    while (segments.Count < total)
        segments.Add("fin-seg-white");

    return segments;
}

private string GetFinHover(ProductBatchRow b)
{
    var total = b.AssemblyFinish;
    var done = b.FinStatus3;
    var inProgress = b.FinStatus2;
    var waiting = b.FinStatus1;

    var sent = done + inProgress + waiting;
    var remaining = total - sent;

    return $"Krāsošana:\n" +
       $"🟩 {done} pabeigts\n" +
       $"🟨 {inProgress} procesā\n" +
       $"⬛ {waiting} gaida\n" +
       $"⬜ {remaining} nav nosūtīts\n\n" +
       $"Nosūtīts: {sent}/{total}";

}

private ProductBatchRow? EditingRow;
private string EditingComment = "";
private bool ShowCommentPopup = false;

private void EditComment(ProductBatchRow b)
{
    EditingRow = b;
    EditingComment = b.Comment ?? "";
    ShowCommentPopup = true;
}

private void CloseCommentPopup()
{
    ShowCommentPopup = false;
    EditingRow = null;
    EditingComment = "";
}

private async Task SaveComment()
{
    if (EditingRow == null)
        return;

    var dto = new
    {
        BatchProductId = EditingRow.BatchProductId,
        PlannedQty = EditingRow.Planned,
        Comment = EditingComment
    };

    await Http.PostAsJsonAsync(
        "http://localhost:5270/api/batches/update-line",
        dto);

    EditingRow.Comment = EditingComment;

    CloseCommentPopup();

    await InvokeAsync(StateHasChanged);
}

private async Task HandleCommentKey(KeyboardEventArgs e)
{
    // ESC = atcelt labošanu
    if (e.Key == "Escape")
    {
        EditingRow = null;
        return;
    }

    // Enter bez Shift = saglabāt
    if (e.Key != "Enter" || e.ShiftKey || EditingRow == null)
        return;

    var dto = new
    {
        BatchProductId = EditingRow.BatchProductId,
        PlannedQty = EditingRow.Planned,
        Comment = EditingComment
    };

    await Http.PostAsJsonAsync(
        "http://localhost:5270/api/batches/update-line",
        dto);

    // atjaunojam UI
    EditingRow.Comment = EditingComment;
    EditingRow = null;
}

private async Task ReloadBatches()
{
    ProductBatches = await Http.GetFromJsonAsync<List<ProductBatchRow>>(
        "http://localhost:5270/api/batches/list-production-v2"
    ) ?? new();

    if (SelectedBatch != null)
    {
        SelectedBatch = ProductBatches
            .FirstOrDefault(x => x.BatchProductId == SelectedBatch.BatchProductId);
    }

    await InvokeAsync(StateHasChanged);
}
private async Task ReloadBatchRow(int batchProductId)
{
    var list = await Http.GetFromJsonAsync<List<ProductBatchRow>>(
        "http://localhost:5270/api/batches/list-production-v2"
    ) ?? new();

    var updated = list.FirstOrDefault(x => x.BatchProductId == batchProductId);
    if (updated == null)
        return;

    var index = ProductBatches.FindIndex(x => x.BatchProductId == batchProductId);
    if (index >= 0)
        ProductBatches[index] = updated;

    await InvokeAsync(StateHasChanged);
}

private async Task HandleDetailChanged()
{
    if (SelectedBatch != null)
        await ReloadBatchRow(SelectedBatch.BatchProductId);
}

private Dictionary<string, string> BatchFlags = new();

private List<(int partId, int batchProductId, DateTime date, int qty)> ParseChildFinish(ProductBatchRow b)
{
    var result = new List<(int partId, int batchProductId, DateTime date, int qty)>();

    if (string.IsNullOrWhiteSpace(b.DetailFinishChildList))
        return result;

    var items = b.DetailFinishChildList.Split(',');

    foreach (var item in items)
    {
        var parts = item.Split(':');
        if (parts.Length != 4)
            continue;

        if (int.TryParse(parts[0], out var id)
                && int.TryParse(parts[1], out var batchProductId)
                && DateTime.TryParse(parts[2], out var dt)
                && int.TryParse(parts[3], out var qty))
            {
                result.Add((id, batchProductId, dt, qty));
            }
    }

    return result;
}

private ProductBatchRow? GetEffectiveBatch()
{
    return SelectedBatch;
}

private void SelectChildRow(int batchProductId)
{
    var child = ProductBatches
        .FirstOrDefault(x => x.BatchProductId == batchProductId);

    if (child is null)
        return;

    SelectedBatch = child;
}

private void OnRowClick(ProductBatchRow b)
{
    // noņemam child selection režīmu
    IsChildRowSelected = false;
    SelectedChildPartId = null;
    SelectedChildParentBatchProductId = null;

    SelectRow(b.BatchProductId);
}

private int? SelectedChildPartId;
private int? SelectedChildParentBatchProductId;
private bool IsChildRowSelected = false;

private List<string> GetBatchList()
{
    return ProductBatches
        .Select(x => x.BatchCode ?? "")
        .Where(x => !string.IsNullOrWhiteSpace(x))
        .Distinct()
        .OrderBy(x => x)
        .ToList();
}

private int? ParentCategoryIdFilter;

private string ItemTypeFilter = "";
private bool ShowCompleted;
private string AssemblyFilter = "";

private string GetChildDetailName(int partId)
{
    return ProductBatches
        .FirstOrDefault(x => x.ProductToPartId == partId)
        ?.DetailName ?? "-";
}

private bool ShowRelatedRows = false;

private void ToggleRelatedRows()
{
    ShowRelatedRows = !ShowRelatedRows;
}

private void ResetSelection()
{
    SelectedBatch = null;

    IsChildRowSelected = false;
    SelectedChildPartId = null;
    SelectedChildParentBatchProductId = null;

    ShowRelatedRows = false;
}

private bool CanShowRelatedRows =>
    SelectedBatch != null
    && ProductBatches.Count(x =>
        x.BatchId == SelectedBatch.BatchId
        && x.VersionId == SelectedBatch.VersionId) > 1;

}