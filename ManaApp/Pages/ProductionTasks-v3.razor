@*Production Tasks v3*@ 
@page "/productiontasks-v3"

@using ManaApp.Components
@using ManaApp.Models
@inject HttpClient Http
@inject NavigationManager Nav



<div class="ptv3-root">

    <!-- TOOLBAR -->
    <div class="ptv3-toolbar">
        <input class="ptv3-search"
            placeholder="Meklēt: batch, kods, nosaukums..."
            @bind="SearchText"
            @bind:event="oninput" />
    </div>

    <!-- MAIN CONTENT -->
<div class="ptv3-main">

    <table class="ptv3-table">

        <thead>
<tr>
    <th class="ptv3-batch-main">Batch</th>
    <th class="ptv3-batch-flag"></th>
    <th>Kategorija</th>
    <th>Nosaukums</th>
    <th>Kods</th>
    <th>Versija</th>
    <th>Plānots</th>
    <th>Sold</th>
    <th>Done</th>

    <th>Detaļas</th>
    <th class="ptv3-details-plus">Det +</th>
    <th class="ptv3-col-small">Detail</th>
    <th class="ptv3-col-small">Assembly</th>
    <th>Fin</th>
    <th class="ptv3-col-wide">Finishing</th>
    <th class="ptv3-fin-plus">F+</th>
    <th>Komentārs</th>
</tr>
</thead>

<tbody>

@foreach (var b in ProductBatches
    .Where(x =>
        string.IsNullOrWhiteSpace(SearchText)
        || (x.BatchCode ?? "").Contains(SearchText, StringComparison.OrdinalIgnoreCase)
        || (x.ProductCode ?? "").Contains(SearchText, StringComparison.OrdinalIgnoreCase)
        || (AllProducts.FirstOrDefault(p => p.productCode == x.ProductCode)?.productName ?? "")
            .Contains(SearchText, StringComparison.OrdinalIgnoreCase)
    )
    .ToList())
{
<tr class="@(SelectedBatch?.BatchProductId == b.BatchProductId ? "ptv3-active" : "")"
    @onclick="() => SelectRow(b.BatchProductId)">

    <td class="ptv3-batch-main">@b.BatchCode</td>
    <td class="ptv3-batch-flag">
        @GetBatchFlag(b)
    </td>
    <td>@b.CategoryName</td>
    <td>@AllProducts.FirstOrDefault(x => x.productCode == b.ProductCode)?.productName</td>
    <td>@b.ProductCode</td>
    <td>@b.VersionName</td>
    <td>@b.Planned</td>
    <td>@b.Sold</td>
    <td>@b.Done</td>
    <td>@($"{b.DetailedStarted}/{b.DetailsTotal}")</td>
    <td class="ptv3-details-plus"></td>
    <td class="ptv3-col-small @(b.DetailFinish != null ? "ptv3-detail-finish" 
                : b.DetailStart != null ? "ptv3-detail-start" 
                : "")">

            @if (b.DetailFinish != null)
            {
                @b.DetailFinish?.ToString("dd.MM.yyyy")
            }
            else if (b.DetailStart != null)
            {
                @b.DetailStart?.ToString("dd.MM.yyyy")
            }

    </td>
    <td class="ptv3-col-small @(b.AssemblyFinishDate != null ? "ptv3-detail-finish" 
        : b.AssemblyStart != null ? "ptv3-detail-start" 
        : "")">

                @if (b.AssemblyFinishDate != null)
                {
                    @b.AssemblyFinishDate?.ToString("dd.MM.yyyy")
                }
                else if (b.AssemblyStart != null)
                {
                    @b.AssemblyStart?.ToString("dd.MM.yyyy")
                }

    </td>

<td class="@GetFinCellClass(b)">
    @($"{b.FinishingInProgress}/{b.AssemblyFinish}")
</td>

<td class="fin-hover ptv3-col-wide">
    <div class="fin-bar">
        @foreach (var seg in GetFinSegments(b))
        {
            <div class="@seg"></div>
        }
    </div>

    <div class="fin-tooltip">
        @GetFinHover(b)
    </div>
</td>
<td class="ptv3-fin-plus"></td>
<td class="ptv3-comment"
    title="@b.Comment">

@if (EditingRow?.BatchProductId == b.BatchProductId)
{
    <textarea class="ptv3-comment-edit"
              @bind="EditingComment"
              @bind:event="onchange"
              @onkeydown="@(e => HandleCommentKey(e))">
    </textarea>
}
else
{
    <div @ondblclick="() => EditComment(b)">
        @(string.IsNullOrWhiteSpace(b.Comment) ? "-" : b.Comment)
    </div>
}

</td>

</tr>
}

</tbody>

    </table>

</div>

    <!-- DETAIL PANEL -->
<div class="ptv3-detail">

<ProductionTasksDetailPanel
        SelectedBatch="SelectedBatch"
        OnDataChanged="HandleDetailChanged" />

</div>

</div>

@code {

[Parameter]
[SupplyParameterFromQuery]
public int? BatchProductId { get; set; }

    private ProductBatchRow? SelectedBatch;
    private string SearchText = "";
private void SelectRow(int batchProductId)
{
    SelectedBatch = ProductBatches
        .FirstOrDefault(x => x.BatchProductId == batchProductId);
}

private List<ProductBatchRow> ProductBatches = new();
private List<ProductRow> AllProducts = new();
private Dictionary<string, ProductRow> ProductsByCode = new();
private Dictionary<int, VersionSummaryDto> VersionSummary = new();
private Dictionary<int, string> BatchCodes = new();
protected override async Task OnInitializedAsync()
{
        ProductBatches = await Http.GetFromJsonAsync<List<ProductBatchRow>>(
            "http://localhost:5270/api/batches/list-production"
        ) ?? new();

    AllProducts = await Http.GetFromJsonAsync<List<ProductRow>>(
        "http://localhost:5270/api/products/planning-list"
    ) ?? new();

    var versionIds = AllProducts
    .Where(x => x.VersionId.HasValue)
    .Select(x => x.VersionId!.Value)
    .Distinct()
    .ToList();

    var summaryUrl = "http://localhost:5270/api/production/overview-by-versions";

    if (versionIds.Any())
    {
        var query = string.Join("&versionIds=", versionIds);
        summaryUrl += $"?versionIds={query}";
    }

    var summaries = await Http.GetFromJsonAsync<List<VersionSummaryDto>>(summaryUrl)
                    ?? new();

    VersionSummary = summaries.ToDictionary(x => x.VersionId);

    VersionSummary = summaries.ToDictionary(x => x.VersionId);

    BatchFlags = await Http.GetFromJsonAsync<Dictionary<string, string>>(
    "http://localhost:5270/api/batches/batch-flags"
) ?? new();

if (BatchProductId.HasValue)
{
    SelectedBatch = ProductBatches
        .FirstOrDefault(x => x.BatchProductId == BatchProductId.Value);

    StateHasChanged();
}
            }

private string GetBatchFlag(ProductBatchRow b)
{
    var key = $"{b.BatchId}_{b.VersionId}";
    return BatchFlags.TryGetValue(key, out var f) ? f : "";
}

private string GetFinCellClass(ProductBatchRow b)
{
    var x = b.FinishingInProgress;
    var y = b.AssemblyFinish;

    if (x == 0 && y > 0)
        return "fin-yellow";

    if (x == y && y > 0)
        return "fin-green";

    if (x < y)
        return "fin-blue";

    return "";
}

private List<string> GetFinSegments(ProductBatchRow b)
{
    
    var segments = new List<string>();

    var total = b.AssemblyFinish;

    for (int i = 0; i < b.FinStatus3; i++)
        segments.Add("fin-seg-green");

    for (int i = 0; i < b.FinStatus2; i++)
        segments.Add("fin-seg-yellow");

    for (int i = 0; i < b.FinStatus1; i++)
        segments.Add("fin-seg-gray");

    while (segments.Count < total)
        segments.Add("fin-seg-white");

    return segments;
}

private string GetFinHover(ProductBatchRow b)
{
    var total = b.AssemblyFinish;
    var done = b.FinStatus3;
    var inProgress = b.FinStatus2;
    var waiting = b.FinStatus1;

    var sent = done + inProgress + waiting;
    var remaining = total - sent;

    return $"Krāsošana:\n" +
       $"🟩 {done} pabeigts\n" +
       $"🟨 {inProgress} procesā\n" +
       $"⬛ {waiting} gaida\n" +
       $"⬜ {remaining} nav nosūtīts\n\n" +
       $"Nosūtīts: {sent}/{total}";

}

private ProductBatchRow? EditingRow;
private string EditingComment = "";

private void EditComment(ProductBatchRow b)
{
    EditingRow = b;
    EditingComment = b.Comment ?? "";
}

private async Task HandleCommentKey(KeyboardEventArgs e)
{
    // ESC = atcelt labošanu
    if (e.Key == "Escape")
    {
        EditingRow = null;
        return;
    }

    // Enter bez Shift = saglabāt
    if (e.Key != "Enter" || e.ShiftKey || EditingRow == null)
        return;

    var dto = new
    {
        BatchProductId = EditingRow.BatchProductId,
        PlannedQty = EditingRow.Planned,
        Comment = EditingComment
    };

    await Http.PostAsJsonAsync(
        "http://localhost:5270/api/batches/update-line",
        dto);

    // atjaunojam UI
    EditingRow.Comment = EditingComment;
    EditingRow = null;
}

private async Task ReloadBatches()
{
    ProductBatches = await Http.GetFromJsonAsync<List<ProductBatchRow>>(
        "http://localhost:5270/api/batches/list-production"
    ) ?? new();

    if (SelectedBatch != null)
    {
        SelectedBatch = ProductBatches
            .FirstOrDefault(x => x.BatchProductId == SelectedBatch.BatchProductId);
    }

    await InvokeAsync(StateHasChanged);
}
private async Task ReloadBatchRow(int batchProductId)
{
    var list = await Http.GetFromJsonAsync<List<ProductBatchRow>>(
        "http://localhost:5270/api/batches/list-production"
    ) ?? new();

    var updated = list.FirstOrDefault(x => x.BatchProductId == batchProductId);
    if (updated == null)
        return;

    var index = ProductBatches.FindIndex(x => x.BatchProductId == batchProductId);
    if (index >= 0)
        ProductBatches[index] = updated;

    await InvokeAsync(StateHasChanged);
}

private async Task HandleDetailChanged()
{
    if (SelectedBatch != null)
        await ReloadBatchRow(SelectedBatch.BatchProductId);
}

private Dictionary<string, string> BatchFlags = new();

}