@*Parts.razor lapa - atsevišķa detaļu uzskaites lapa - DETAIL posmam*@
@page "/parts"
@page "/parts/{ProductId:int}/{VersionId:int}"
@using ManaApp.Models
@using System.Net.Http.Json
@using System.Text.Json.Serialization
@using ManaApp.Components.Parts

@inject HttpClient Http
@layout MainLayout

<div class="parts-main">
    <!-- KREISĀ PUSE: saraksts -->
        <div class="parts-left">
            <div class="parts-header">
            <PartsToolbar 
                SelectedRoot="@selectedRoot"
                OnRootChanged="@(EventCallback.Factory.Create<int?>(this, SetRootFilter))"
                ShowArchived="@showArchived"
                ShowArchivedChanged="@(v => showArchived = v)"
                @bind-SearchText="searchText" 
                @bind-PlannedOnly="plannedOnly"
                @bind-InProductionOnly="inProductionOnly"
                @bind-OkOnly="okOnly"
                @bind-ReservedOnly="reservedOnly"
                @bind-FreeOnly="freeOnly"/>
            </div>
            
            @foreach (
                
                var group in groupedData
                .Where(g =>
                    (!selectedRoot.HasValue || g.ParentCategoryId == selectedRoot)
                    &&
                    (string.IsNullOrWhiteSpace(searchText)
                        || g.ProductName.Contains(searchText, StringComparison.OrdinalIgnoreCase)
                        || g.VersionName.Contains(searchText, StringComparison.OrdinalIgnoreCase)
                        || g.Parts.Any(p => p.TopPartName.Contains(searchText, StringComparison.OrdinalIgnoreCase))
                    )
                ))
            {
                var filteredParts = group.Parts
                    .Where(p =>
                        string.IsNullOrWhiteSpace(searchText)
                        || group.ProductName.Contains(searchText, StringComparison.OrdinalIgnoreCase)
                        || group.VersionName.Contains(searchText, StringComparison.OrdinalIgnoreCase)
                        || p.TopPartName.Contains(searchText, StringComparison.OrdinalIgnoreCase)
                    )
                    .Where(p =>
                        (!plannedOnly || p.PlannedQty > 0)
                        && (!inProductionOnly || p.InProduction > 0)
                        && (!okOnly || p.OkQty > 0)
                        && (!reservedOnly || p.ReservedQty > 0)
                        && (!freeOnly || p.FreeQty > 0)
                    )
                    .ToList();

                @if (!filteredParts.Any())
                {
                    continue;
                }

                <!-- HEADER (Product + Version) -->
                <div class="part-group-header">
                    <div>@group.ProductName</div>   <!-- ✔ -->
                    <div>@group.VersionName</div>   <!-- ✔ -->
                    <div>Plānots</div>
                    <div>Ražošanā</div>
                    <div>Ok</div>
                    <div>Rezervēts</div>
                    <div>Citi</div>
                </div>

                <!-- CHILD ROWS (TopParts) -->
                @foreach (var part in filteredParts)
                    {
                        <div class="part-row">
                            <div>@part.TopPartName</div>
                            <div></div> <!-- tukšs version -->
                            <div class="@(part.PlannedQty == 0 ? "num-zero" : "num-value")">@part.PlannedQty</div>
                            <div class="@(part.InProduction == 0 ? "num-zero" : "num-value")">@part.InProduction</div>
                            <div class="@(part.OkQty == 0 ? "num-zero" : "num-value")">@part.OkQty</div>
                            <div class="@(part.ReservedQty == 0 ? "num-zero" : "num-value")">@part.ReservedQty</div>
                            <div class="@(part.FreeQty == 0 ? "num-zero" : "num-value")">@part.FreeQty</div>
                        </div>
                    }
            }
        </div>

    <!-- LABĀ PUSE: informācija + actions -->
    <div class="parts-right">
        <h4>Detaļas informācija</h4>

        <p>(šeit būs izvēlētās detaļas info + darbības)</p>
    </div>

</div>

@code {
    [Parameter] public int? ProductId { get; set; }
    [Parameter] public int? VersionId { get; set; }

    private List<PartRow> rows = new();
    
    public class PartRow
{
    public int Id { get; set; }
    public int TopPartId { get; set; }
    public string? TopPartName { get; set; }
    public int VersionId { get; set; }
    public int PlannedQty { get; set; }
    public int InProduction { get; set; }
    public int OkQty { get; set; }
    public int ReservedQty { get; set; }
    public int StockQty { get; set; }
    public int FreeQty { get; set; }
}

    private List<ProductPartGroup> groupedData = new();

    public class ProductPartGroup
    {
        public string ProductName { get; set; } = "";
        public string VersionName { get; set; } = "";
        public string RootName { get; set; } = "";
        public int? ParentCategoryId { get; set; }
        public int InProduction { get; set; }   // vēlāk no batch
        public int OkQty { get; set; }
        public int ReservedQty { get; set; }
        public int StockQty { get; set; }
        public int FreeQty { get; set; }

        public List<PartItem> Parts { get; set; } = new();
    }

public class PartItem
{
    public int Index { get; set; }
    public string TopPartName { get; set; } = "";
    public int PlannedQty { get; set; }
    public int InProduction { get; set; }
    public int OkQty { get; set; }
    public int ReservedQty { get; set; }
    public int StockQty { get; set; }
    public int FreeQty { get; set; }
}

public class ProductSummaryDto
{
    public int ProductId { get; set; }
    public string ProductName { get; set; } = "";
    public string RootName { get; set; } = "";
    public int? ParentCategoryId { get; set; }
    public int VersionId { get; set; }
    public string VersionName { get; set; } = "";

    public int InProduction { get; set; }
    public int OkQty { get; set; }
    public int ReservedQty { get; set; }
    public int FreeQty { get; set; }
}

protected override async Task OnInitializedAsync()
{
    await LoadData();
}

private async Task LoadData()
{
    if (_isLoading)
    return;

    _isLoading = true;

    StateHasChanged();

    var url = showArchived
    ? "http://localhost:5270/api/products/planning-list-archived"
    : "http://localhost:5270/api/products/planning-list";

    var products = await Http.GetFromJsonAsync<List<ProductSummaryDto>>(url);
    
    // 1. savācam visus versionId
var versionIds = (products ?? new())
    .Select(p => p.VersionId)
    .Distinct()
    .ToList();

// 2. viens API call VISIEM
var allParts = await Http.GetFromJsonAsync<List<PartRow>>(
    $"http://localhost:5270/api/topparts/full-data-all?versionIds={string.Join(",", versionIds)}"
);

// 3. sadalām pa versionId
var partsByVersion = (allParts ?? new())
    .GroupBy(x => x.VersionId)
    .ToDictionary(g => g.Key, g => g.ToList());

        // 4. būvējam UI datus
        groupedData = (products ?? new()).Select(p =>
        {
            var parts = partsByVersion.GetValueOrDefault(p.VersionId) ?? new();

            return new ProductPartGroup
            {
                ProductName = p.ProductName,
                VersionName = p.VersionName ?? "",
                ParentCategoryId = p.ParentCategoryId,
                RootName = p.RootName ?? "",

                Parts = parts.Select((r, i) => new PartItem
                {
                    Index = i + 1,
                    TopPartName = r.TopPartName ?? "",
                    PlannedQty = r.PlannedQty,
                    InProduction = r.InProduction,
                    OkQty = r.OkQty,
                    ReservedQty = r.ReservedQty,
                    StockQty = r.StockQty,
                    FreeQty = r.FreeQty
                }).ToList()
            };
        }).ToList();

_isLoading = false;

StateHasChanged();

}

public class OkDto
{
    public int VersionId { get; set; }
    public int TopPartId { get; set; }
    public int OkQty { get; set; }
}

public class ReservedDto
{
    public int VersionId { get; set; }
    public int TopPartId { get; set; }
    public int ReservedQty { get; set; }
}

public class StockDto
{
    public int VersionId { get; set; }
    public int TopPartId { get; set; }
    public int StockQty { get; set; }
}

public class PartSummaryDto
{
    [JsonPropertyName("topPartId")]
    public int TopPartId { get; set; }

    [JsonPropertyName("topPartName")]
    public string TopPartName { get; set; } = "";

    [JsonPropertyName("okQty")]
    public int OkQty { get; set; }

    [JsonPropertyName("reservedQty")]
    public int ReservedQty { get; set; }

    [JsonPropertyName("freeQty")]
    public int FreeQty { get; set; }

    [JsonPropertyName("versionId")] 
    public int VersionId { get; set; }
}

public class PartProductionDto
{
    [JsonPropertyName("topPartId")]
    public int TopPartId { get; set; }

    [JsonPropertyName("topPartName")]
    public string TopPartName { get; set; } = "";

    [JsonPropertyName("inProduction")]
    public int InProduction { get; set; }

    [JsonPropertyName("versionId")]
    public int VersionId { get; set; }
}
public class PlannedDto
{
    public int VersionId { get; set; }
    public int TopPartId { get; set; }
    public int PlannedQty { get; set; }
}

public class FreeDto
{
    public int VersionId { get; set; }
    public int TopPartId { get; set; }
    public int FreeQty { get; set; }
}

private int? selectedRoot = null;
private string? searchText;
private bool plannedOnly;
private bool inProductionOnly;
private bool okOnly;
private bool reservedOnly;
private bool freeOnly;
private bool _isLoading = false;
private bool _showArchived;


private bool showArchived
{
    get => _showArchived;
    set
    {
        if (_showArchived == value) return;

        _showArchived = value;

        _isLoading = false; // ļaujam restartēt load
        _ = LoadData();
    }
}

private void SetRootFilter(int? value)
{
    selectedRoot = value;
}

}