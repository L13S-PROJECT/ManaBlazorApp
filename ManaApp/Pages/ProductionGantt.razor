@* ProductionGantt.razor  - divi vienā - laika simulācija un Gantt diagramma *@

@page "/production-gantt"
@inject HttpClient Http
@using ManaApp.Models
@using ManaApp.Components.Ganttchart
@using ManaApp.Services
@inject GanttChartService GanttService
@using System.Globalization;
@inject IJSRuntime JS

<div class="main-layout">

    <!-- TOP BOX -->
<div class="top-box">
    <GanttSimulation />
</div>

    <!-- BOTTOM BOX -->
    <div class="bottom-box">
<div class="gantt-page">

    <!-- TOP -->
    <div class="gantt-toolbar">

    <!-- LEFT -->
    <div class="gantt-toolbar-left">
    </div>

    <!-- RIGHT -->
    <div class="gantt-toolbar-right">

                <!-- 1. rinda (week + arrows) -->
                <div class="toolbar-row toolbar-top">

                    <span @onclick="PrevWeek" style="cursor:pointer">◀</span>

                    <span>Nedēļa @WeekNumber, @startOfWeek.Year</span>

                    <span @onclick="NextWeek" style="cursor:pointer">▶</span>

                    <button @onclick="GoToday">Šodiena</button>

                    <span class="calendar-icon" @onclick="OpenCalendar">
                        📅
                    </span>

                    <input type="date" @ref="dateInput"
                        style="position:absolute; opacity:0; pointer-events:none;"
                        @onchange="OnDateChanged" />

                </div>

                <!-- 2. rinda (dienu nosaukumi) -->
               <div class="toolbar-row toolbar-days">
                    
                    @foreach (var d in weekDays)
                    {
                        <div>@d.ToString("dddd")</div>
                    }
                </div>

                <!-- 3. rinda (datumi) -->
                <div class="toolbar-row toolbar-dates">
                    
                    @foreach (var d in weekDays)
                    {
                        <div>@d.ToString("dd.MM")</div>
                    }
                </div>

            </div>

    </div>

    <!-- BODY -->
<div class="gantt-body">
    <table class="gantt-table">
        <colgroup>
            <col style="width:250px" />
            @for (int i = 0; i < 7; i++)
            {
                <col style="width: calc((100% - 250px)/7)" />
            }
        </colgroup>
        <tbody>
            @foreach (var group in grouped ?? new())
            {
                <tr class="wc-row">
                    <td class="name-cell">@group.WorkCenterName</td>
                    @for (int i = 0; i < 7; i++)
                    {
                        <td></td>
                    }
                </tr>

                @foreach (var emp in group.Employees ?? new())
                {
                    <tr class="emp-row">
                        <td class="name-cell">@emp.EmployeeName</td>

                        @for (int d = 0; d < 7; d++)
                        {
                            <td>
                                <div class="day-cell">
                                    @for (int h = 0; h < 8; h++)
                                    {
                                        <div class="hour-cell"
                                            style="background-color:@GetColorByHour(emp.Tasks, d, h)">
                                        </div>
                                    }
                                </div>
                            </td>
                        }
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

</div>

   </div>

</div>

@code {
List<GanttRow> data = new();
List<WorkCenterGroup> grouped = new();
List<EmployeeDto> employees = new();
List<WorkCenterDto> workCenters = new();
DateTime startOfWeek =>
    DateTime.Today
        .AddDays(-(int)DateTime.Today.DayOfWeek + 1)
        .AddDays(weekOffset * 7);
List<DateTime> weekDays = new();
int daysInMonth = DateTime.DaysInMonth(DateTime.Today.Year, DateTime.Today.Month);
int weekOffset = 0;
  protected override async Task OnInitializedAsync()
{
    data = await Http.GetFromJsonAsync<List<GanttRow>>("api/production/gantt") ?? new();

    employees = await Http.GetFromJsonAsync<List<EmployeeDto>>("api/employees") ?? new();

    workCenters = await Http.GetFromJsonAsync<List<WorkCenterDto>>("api/workcenters") ?? new(); // ⬅️ PĀRVIETO ŠEIT

    var simulated = GanttService.BuildSimulatedTasks(data);

    grouped = GanttService.BuildGroups(data, employees, workCenters);

GenerateWeek();

}

void PrevWeek() 
{
    weekOffset--;
    GenerateWeek();
}

void NextWeek()
{
    weekOffset++;
    GenerateWeek();
}

void GenerateWeek()
{
    weekDays = Enumerable.Range(0, 7)
        .Select(i => startOfWeek.AddDays(i))
        .ToList();
}

int WeekNumber =>
    CultureInfo.CurrentCulture.Calendar.GetWeekOfYear(
        startOfWeek,
        CalendarWeekRule.FirstFourDayWeek,
        DayOfWeek.Monday);

void GoToday()
{
    weekOffset = 0;
    GenerateWeek();
}

void OnDateChanged(ChangeEventArgs e)
{
    if (DateTime.TryParse(e.Value?.ToString(), out var selected))
    {
        var monday = selected.AddDays(-(int)selected.DayOfWeek + 1);
        weekOffset = (int)((monday - DateTime.Today.AddDays(-(int)DateTime.Today.DayOfWeek + 1)).TotalDays / 7);
        GenerateWeek();
    }
}

ElementReference dateInput;

async Task OpenCalendar()
{
    await JS.InvokeVoidAsync("openDatePicker", dateInput);
}

ElementReference leftPanel;

string GetColor(List<GanttRow>? tasks, int dayIndex)
{
    if (tasks == null) return "";

    var dayStart = startOfWeek.AddDays(dayIndex);
    var dayEnd = dayStart.AddDays(1);

    var task = tasks.FirstOrDefault(t =>
    {
        var taskStart = DateTime.Today.AddMinutes(t.EstimatedStartMinutes);
        var taskEnd = taskStart.AddMinutes(t.EstimatedTotalMinutes);

        return taskStart < dayEnd && taskEnd > dayStart;
    });

    return task?.DisplayColor ?? "";
}

string GetColorByHour(List<GanttRow>? tasks, int dayIndex, int hour)
{
    if (tasks == null) return "";

    var minutesPerHour = 60;

    var dayStart = startOfWeek.AddDays(dayIndex);
    var hourStart = dayStart.AddMinutes(hour * minutesPerHour);
    var hourEnd = hourStart.AddMinutes(minutesPerHour);

var task = tasks.FirstOrDefault(t =>
{
    DateTime taskStart;
    DateTime taskEnd;

    if (t.StartedAt != null)
    {
        taskStart = t.StartedAt.Value;
        taskEnd = t.FinishedAt ?? DateTime.Now;
    }
    else
    {
        taskStart = DateTime.Today.AddMinutes(t.EstimatedStartMinutes);
        taskEnd = taskStart.AddMinutes(t.EstimatedTotalMinutes);
    }

    var overlapStart = taskStart > hourStart ? taskStart : hourStart;
    var overlapEnd = taskEnd < hourEnd ? taskEnd : hourEnd;

    return overlapEnd > overlapStart;
});

    if (task == null)
    return "";

// 🔴 kavēts > 24h
// var taskStart = DateTime.Today.AddMinutes(task.EstimatedStartMinutes);
// var now = DateTime.Today;
// if (task.Status != 3 && now > taskStart.AddHours(24))
//     return "red";

// 🟢 pabeigts
if (task.Status == 3)
    return "green";

// 🟡 procesā
if (task.Status == 2)
    return "yellow";

// 🟠 neiesākts (assigned)
if (task.Status == 1 && task.AssignedTo != null)
    return "orange";

// ⚪ nav piešķirts
if (task.AssignedTo == null)
    return "lightgray";

return "";
}

}