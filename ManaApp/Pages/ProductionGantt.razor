@page "/production-gantt"
@inject HttpClient Http
@using ManaApp.Models
@using ManaApp.Components.Ganttchart


<h3>Production Gantt</h3>

<div class="gantt-header">

    <div class="gantt-left">
        Detail
    </div>

<GanttTimeline Days="@daysInMonth" />

</div>

@if (data.Count == 0)
{
    <p>Loading...</p>
}

@if (grouped != null)
{
<div class="gantt-scroll">
    <div class="gantt-body">

        <GanttDetail Groups="grouped" />
        <GanttAssembly Groups="grouped" />
        <GanttFinishing Groups="grouped" />

    </div>
</div>
}

@code {
List<GanttRow> data = new();
List<WorkCenterGroup> grouped = new();
List<EmployeeDto> employees = new();
int daysInMonth = DateTime.DaysInMonth(DateTime.Today.Year, DateTime.Today.Month);

  protected override async Task OnInitializedAsync()
{
    data = await Http.GetFromJsonAsync<List<GanttRow>>("api/production/gantt") ?? new();
    employees = await Http.GetFromJsonAsync<List<EmployeeDto>>("api/employees") ?? new();
    grouped = data
    .GroupBy(x => x.WorkCenterId)
    .Select(wc => new WorkCenterGroup
    {
        WorkCenterId = wc.Key,
        WorkCenterName = wc.First().WorkCenterName,

        Employees = employees
            .Where(e => e.WorkCentrTypeID == wc.Key)
            .Select(e => new EmployeeGroup
            {
                EmployeeId = e.Id,
                EmployeeName = e.Name,
                Tasks = wc
                    .Where(t => t.AssignedTo == e.Id || t.AssignedTo == 0 || t.AssignedTo == null)
                    .OrderByDescending(t => t.IsPriority)
                    .ThenBy(t => t.Priority)
                    .ThenBy(t => t.BatchProductId)
                    .ThenBy(t => t.StepOrder)
                    .ToList()
            })
            .ToList()
    })
    .ToList();
}

}