private async Task LoadDraftAsync()
{
    Console.WriteLine("LOAD DRAFT: start");

try
{
        var result = await PlanningDraftService.LoadDraftAsync(rows);

                if (result == null)
                {
                    return;
                }

                draftBatchId = result.BatchId;
                draftComment = result.Comment;
                draftCreatedAt = result.CreatedAt;
                draftBatchStatus = result.BatchStatus;
                batchItems = result.Items;


// pievieno detaļām nosaukumu 
var versionIds = batchItems
    .Where(x => x.ProductToPartId != null)
    .Select(x => x.VersionId)
    .Distinct()
    .ToList();

foreach (var vid in versionIds)
{
    var parts = await PlanningLookupService.LoadProductParts(vid);

    foreach (var item in batchItems.Where(x => x.VersionId == vid && x.ProductToPartId != null))
    {
        var part = parts.FirstOrDefault(p => p.Id == item.ProductToPartId);
       if (part != null)
            {
                item.Name = part.TopPart_Name;
            }
    }
}

        batchPanelRef?.SetComment(result.Comment);
        StateHasChanged();
    }
    catch (Exception ex)
    {
        Console.WriteLine("LOAD DRAFT ERROR: " + ex.Message);
    }
}

protected override async Task OnAfterRenderAsync(bool firstRender)
{
    if (!firstRender)
        return;

    if (!string.IsNullOrWhiteSpace(draftComment))
    {
        batchPanelRef?.SetComment(draftComment);
    }
}

private async Task<bool> CreatePlanAsync(string planCode)
{
if (!draftBatchId.HasValue)
    return false;


    // 1️⃣ unikuma pārbaude
    var isUnique = await PlanningLookupService.CheckBatchCodeAsync(
        planCode
    );

    if (!isUnique)

    {
        // ❗ atgriežam kļūdu UZ PANELI
        batchPanelRef?.SetCreateError("Šāds ražošanas plāna kods jau eksistē.");
        return false;
    }

    // 2️⃣ status + code
    var ok = await PlanningLookupService.CreatePlannedBatchAsync(
            draftBatchId.Value,
            planCode
        );

            if (!ok)
    {
        batchPanelRef?.SetCreateError("Neizdevās izveidot ražošanas plānu.");
        return false;
    }

    // 3️⃣ viss OK → RESET
    draftBatchId = null;
    batchItems.Clear();
    draftComment = null;
    forceNewDraft = true;

batchPanelRef?.CloseCreateDialog();
await ReloadPlanningDataAsync();
await InvokeAsync(StateHasChanged);
return true;

}

private bool forceNewDraft = false;

private async Task DeleteDraftAsync()
{
    if (!draftBatchId.HasValue)
        return;

    var ok = await PlanningLookupService.DeleteDraftAsync(
            draftBatchId.Value
        );

        if (!ok)
    {
        await JS.InvokeVoidAsync(
            "alert",
            "Neizdevās dzēst melnrakstu"
        );
        return;
    }

    // UI reset
    draftBatchId = null;
    batchItems.Clear();
    draftComment = null;

    forceNewDraft = true;

    batchPanelRef?.SetComment(null);
    batchPanelRef?.Refresh();

    await ReloadPlanningDataAsync();   
    StateHasChanged();
}

