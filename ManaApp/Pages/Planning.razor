private async Task OnEditSaved(BatchLine line)
{
    if (line is null)
    return;

    if (isSaving)
        return;

    isSaving = true;

    try
    {
            
        var oldItem = batchItems.FirstOrDefault(x =>
            x.VersionId == line.VersionId &&
            x.ProductToPartId == null);

        var hasChanges = HasEditChanges(line, oldItem);

        if (!hasChanges)
            {
                await CloseEditDialog();
                return;
            }

var context = BuildEditContext(line);
var selectedParts = context.SelectedParts;
var categoryId = context.CategoryId;
var parentCategoryId = context.ParentCategoryId;

                    
if (ShouldDeleteLine(line, selectedParts))
{
    await HandleDeleteLine(line);
    return;
}

        // ApplyEditToBatchItems(line, selectedParts, categoryId, parentCategoryId);

                var dto = BuildEditDraftUpdateDto(
                    line,
                    selectedParts
                );

                var ok = await PlanningLookupService.SaveDraftAsync(dto);

                if (!ok)
                {
                    await HandleSaveError();
                    return;
                }

                await ReloadPlanningDataAsync();
                await LoadDraftAsync();

                await CloseEditDialog();
    }
    finally
    {
        isSaving = false;
        StateHasChanged();
    }
}

private bool ShouldDeleteLine(BatchLine line, List<ProductToPartDto> selectedParts)
{
    return !selectedParts.Any() && line.Planned <= 0;
}

private async Task HandleDeleteLine(BatchLine line)
{
    if (draftBatchId == null)
    {
        await CloseEditDialog();
        return;
    }

    batchItems = batchItems
        .Where(x => x.VersionId != line.VersionId)
        .ToList();

    var dto = BuildDraftUpdateDto();

    await PlanningLookupService.SaveDraftAsync(dto);

    isEditOpen = false;
}

private (List<ProductToPartDto> SelectedParts, int? CategoryId, int? ParentCategoryId)
    BuildEditContext(BatchLine line)
{
    var rowData = rows.FirstOrDefault(r => r.VersionId == line.VersionId);

    var oldItem = batchItems.FirstOrDefault(x =>
        x.VersionId == line.VersionId &&
        x.ProductToPartId == null);

    var selectedParts = editParts
        .Where(p => p.IsSelected && p.Qty > 0)
        .ToList();

    var categoryId = rowData?.CategoryId ?? oldItem?.CategoryId;
    var parentCategoryId = rowData?.ParentCategoryId ?? oldItem?.ParentCategoryId;

    return (selectedParts, categoryId, parentCategoryId);
}

private bool HasEditChanges(BatchLine line, BatchCartItem? oldItem)
{
    if (line.Planned != (oldItem?.Qty ?? 0))
        return true;

    if (line.Comment != oldItem?.Comment)
        return true;

    foreach (var p in editParts)
    {
        var existing = batchItems.FirstOrDefault(x =>
            x.VersionId == line.VersionId &&
            x.ProductToPartId == p.Id);

        var existsNow = existing != null;
        var shouldExist = p.IsSelected && p.Qty > 0;

        if (existsNow != shouldExist)
            return true;

        if (existsNow && existing!.Qty != p.Qty)
            return true;
    }

    return false;
}


private async Task HandleSaveError()
{
    await JS.InvokeVoidAsync(
        "alert",
        "Neizdevās saglabāt melnrakstu"
    );
}

private DraftUpdateRequestDto BuildDraftUpdateDto()
{
    return new DraftUpdateRequestDto
    {
        BatchId = draftBatchId,
        Items = batchItems.Select(x => new DraftUpdateItemDto
        {
            VersionId = x.VersionId,
            ProductToPartId = x.ProductToPartId,
            Qty = x.Qty,
            Comment = x.Comment
        }).ToList()
    };
}

private DraftUpdateRequestDto BuildEditDraftUpdateDto(
    BatchLine line,
    List<ProductToPartDto> selectedParts)
{
    var dto = new DraftUpdateRequestDto
    {
        BatchId = draftBatchId,
        Items = batchItems
            .Where(x => x.VersionId != line.VersionId)
            .Select(x => new DraftUpdateItemDto
            {
                VersionId = x.VersionId,
                ProductToPartId = x.ProductToPartId,
                Qty = x.Qty,
                Comment = x.Comment
            })
            .ToList()
    };

    if (line.Planned > 0)
    {
        dto.Items.Add(new DraftUpdateItemDto
        {
            VersionId = line.VersionId,
            ProductToPartId = null,
            Qty = line.Planned,
            Comment = line.Comment
        });
    }

    foreach (var part in selectedParts)
    {
        dto.Items.Add(new DraftUpdateItemDto
        {
            VersionId = line.VersionId,
            ProductToPartId = part.Id,
            Qty = part.Qty,
            Comment = line.Comment
        });
    }

    return dto;
}

private Task CloseEditDialog()
{
    isEditOpen = false;
    StateHasChanged();
    return Task.CompletedTask;
}

