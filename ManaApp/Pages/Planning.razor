        .Where(g =>
            string.IsNullOrWhiteSpace(searchText) ||
            g.ProductName.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
            g.ProductCode.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
            g.CategoryName.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
            g.Versions.Any(v =>
                v.productName?.Contains(searchText, StringComparison.OrdinalIgnoreCase) == true ||
                v.productCode?.Contains(searchText, StringComparison.OrdinalIgnoreCase) == true
            )
        )
        .ToList();

private PlanningBatchPanel? batchPanelRef;

private async Task OnPlannedPlus(PlanningGroupDto row)
{
    var result = await PlanningDraftService.BuildAddDialogAsync(
        row,
        batchItems,
        draftBatchId,
        versionId => PlanningLookupService.LoadProductParts(versionId),
        async versionId =>
        {
            return await Http.GetFromJsonAsync<ValidateResult>(
                $"http://localhost:5270/api/batches/validate-for-planning?versionId={versionId}");
        });

    if (!result.Success)
    {
        if (!string.IsNullOrWhiteSpace(result.ErrorMessage))
        {
            await JS.InvokeVoidAsync(
                "alert",
                result.ErrorMessage
            );
        }

        return;
    }

    addProductName = result.ProductName;
    addVersionName = rows
        .FirstOrDefault(x =>
            x.VersionId == result.ProductId &&
            !x.IsRalRow)
        ?.versionName;
    addProductOrderQty = row.OrderQty;
    addProductId = result.ProductId;
    addIsArchivedVersion =
        rows.FirstOrDefault(x => x.VersionId == result.ProductId)
            ?.VersionIsActive == false;
    addParts = result.Parts;
    addProductRalRows = result.ProductRalRows;
    addLine = result.Line;

    isPartOnlyMode = result.IsPartOnlyMode;

    isAddOpen = true;
}

private async Task OnAddSaved(BatchLine line)
{
    if (line is null)
        return;

    DraftProductInfo? productInfo = null;

        if (addProductId.HasValue)
        {
            var product = await Http.GetFromJsonAsync<ProductContentDto>(
                $"http://localhost:5270/api/products/content?versionId={addProductId.Value}");

            if (product != null)
            {
                productInfo = new DraftProductInfo
                    {
                        ProductName = product.ProductName ?? "",
                        VersionName = product.VersionName,
                        ProductCode = product.ProductCode ?? "",
                        IsArchivedVersion =
                            rows.FirstOrDefault(x =>
                                x.VersionId == addProductId.Value &&
                                !x.IsRalRow)
                            ?.VersionIsActive == false
                    };
            }
        }

    var result = await PlanningDraftService.AddOrUpdateAsync(
        line: line,
        currentItems: batchItems,
        rows: rows,
        addParts: addParts,
        draftBatchId: draftBatchId,
        forceNewDraft: forceNewDraft,
        productInfo: productInfo
    );

    if (!result.Success)
    {
        await HandleSaveError();
        return;
    }

    draftBatchId = result.BatchId;

    batchItems = result.Items;

    forceNewDraft = false;

    isAddOpen = false;

    addLine = null;

    StateHasChanged();
}

private bool MatchRoot(PlanningGroupDto g)
{
    var root = selectedView == ProductViewType.Kauss
        ? "KAUSS"
        : "ADAPTERIS";

    // skatāmies uz jebkuru versiju grupā (visām būs viens root)
    var any = g.Versions?.FirstOrDefault();
    if (any is null) return false;

    var stem = root.Length > 1 ? root[..^1] : root;
    return (any.rootName ?? "")
        .StartsWith(stem, StringComparison.OrdinalIgnoreCase);
}

