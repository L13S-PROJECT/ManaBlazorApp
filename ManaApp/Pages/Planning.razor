private async Task OpenEdit(BatchCartItem it)
{
    var row = rows
        .FirstOrDefault(x => x.VersionId == it.VersionId);

    editProductName =
        row is null
            ? it.Name
            : string.IsNullOrWhiteSpace(row.versionName)
                ? row.productName
                : $"{row.productName} • {row.versionName}";

    var parent = batchItems.FirstOrDefault(x =>
    x.VersionId == it.VersionId &&
    x.ProductToPartId == null);

    editLine = new BatchLine
    {
        BatchCode   = it.Code,
        VersionId   = it.VersionId,
        Planned     = parent?.Qty ?? 0,
        Comment     = it.Comment,
        BatchStatus = 4
    };

    editParts = await PlanningLookupService.LoadProductParts(it.VersionId);
    
    addProductRalRows = groupedRows
            .FirstOrDefault(g =>
                g.Versions.Any(v => v.VersionId == it.VersionId))
            ?.Versions
            .Where(x => x.IsRalRow)
            .OrderBy(x => x.RalCode)
            .ToList()
            ?? new();

    foreach (var p in editParts)
    {
        var existing = batchItems.FirstOrDefault(x =>
            x.VersionId == it.VersionId &&
            x.ProductToPartId == p.Id);

        if (existing != null)
        {
            p.IsSelected = true;
            p.Qty = existing.Qty;
        }
        else
        {
            p.IsSelected = false;
            p.Qty = 0;
        }
    }

    isEditOpen = true;
}

private async Task OnPartPlannedPlus(PlanningPartsPanel.PartItem part)
{

addProductName =
    !part.VersionIsActive
        ? $"{part.ProductName} • {part.TopPartName} [ARHĪVĒTS]"
        : $"{part.ProductName} • {part.TopPartName}";

addProductId = part.VersionId;
addVersionName = part.VersionName;
addParts = await PlanningLookupService.LoadProductParts(part.VersionId);

var isArchivedVersion =
    part.VersionIsActive == false;

foreach (var p in addParts)
{
    var selected = p.Id == part.ProductToPartId;

    p.IsSelected = selected;

    if (isArchivedVersion)
    {
        p.Qty = selected ? 1 : 0;
    }
    else
    {
        p.Qty = selected ? 1 : 0;
    }
}

addLine = new BatchLine

{
    BatchId = draftBatchId ?? 0,
    VersionId = part.VersionId,
    Planned = 0,
    Comment = "",
    BatchStatus = 5
};

isPartOnlyMode = true;
isAddOpen = true;
}

private async Task OpenDraftEdit(PlanningGroupDto row)
{
    var item = batchItems.FirstOrDefault(x =>
        x.VersionId == row.Versions
            .FirstOrDefault(v => v.VersionId.HasValue)?
            .VersionId);

    if (item is null)
        return;

    await OpenEdit(item);
}

private async Task OnPartPlusClicked(PlanningPartsPanel.PartItem part)
{
    if (part.IsInDraft)
    {
        var item = batchItems.FirstOrDefault(x =>
            x.VersionId == part.VersionId);

        if (item != null)
        {
            await OpenEdit(item);
            return;
        }
    }

    await OnPartPlannedPlus(part);
}

