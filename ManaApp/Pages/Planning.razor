private async Task OnBatchItemDeleted(BatchCartItem it)
{
    if (it.ProductToPartId == null)
    {
        batchItems = batchItems
            .Where(x => x.VersionId != it.VersionId)
            .ToList();
    }
    else
    {
        batchItems = batchItems
            .Where(x =>
                !(x.VersionId == it.VersionId &&
                  x.ProductToPartId == it.ProductToPartId))
            .ToList();
    }

    var dto = new DraftUpdateRequestDto
    {
        BatchId = draftBatchId,
        Items = batchItems.Select(x => new DraftUpdateItemDto
        {
            VersionId = x.VersionId,
            ProductToPartId = x.ProductToPartId,
            Qty = x.Qty,
            Comment = x.Comment
        }).ToList()
    };

    var ok = await PlanningLookupService.SaveDraftAsync(dto);

    if (!ok)
    {
        await HandleSaveError();
        return;
    }

    StateHasChanged();
}

private async Task OpenEdit(BatchCartItem it)
{
    editProductName = rows
        .FirstOrDefault(x => x.VersionId == it.VersionId)
        ?.productName
        ?? it.Name;

    var parent = batchItems.FirstOrDefault(x =>
    x.VersionId == it.VersionId &&
    x.ProductToPartId == null);

    editLine = new ProductionTasks.BatchLine
    {
        BatchCode   = it.Code,
        VersionId   = it.VersionId,
        Planned     = parent?.Qty ?? 0,
        Comment     = it.Comment,
        BatchStatus = 4
    };

    editParts = await PlanningLookupService.LoadProductParts(it.VersionId);
    

    foreach (var p in editParts)
    {
        var existing = batchItems.FirstOrDefault(x =>
            x.VersionId == it.VersionId &&
            x.ProductToPartId == p.Id);

        if (existing != null)
        {
            p.IsSelected = true;
            p.Qty = existing.Qty;
        }
        else
        {
            p.IsSelected = false;
            p.Qty = 0;
        }
    }

    isEditOpen = true;
}

private async Task OnPartPlannedPlus(PlanningPartsPanel.PartItem part)
{

addProductName =
    !part.VersionIsActive

    ? $"{part.ProductName} ({part.VersionName}) • {part.TopPartName} [ARHĪVĒTS]"

    : $"{part.ProductName} • {part.TopPartName}";

addProductId = part.VersionId;

addParts = await PlanningLookupService.LoadProductParts(part.VersionId);

var isArchivedVersion =
    part.VersionIsActive == false;

foreach (var p in addParts)
{
    var selected = p.Id == part.ProductToPartId;

    p.IsSelected = selected;

    if (isArchivedVersion)
    {
        p.Qty = selected ? 1 : 0;
    }
    else
    {
        p.Qty = selected ? 1 : 0;
    }
}

addLine = new ProductionTasks.BatchLine

{
    BatchId = draftBatchId ?? 0,
    VersionId = part.VersionId,
    Planned = 0,
    Comment = "",
    BatchStatus = 5
};

isPartOnlyMode = true;
isAddOpen = true;
}

