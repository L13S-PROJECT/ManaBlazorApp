@page "/"
@using System.Net.Http.Json
@using ManaApp.Services
@inject PdfService PdfService

<h3>Kategorijas</h3>
<InputFile OnChange="OnFileSelected" />

@if (header is not null)
{
    <div>
        <p><b>Order Nr:</b> @header.OrderNumber</p>
        <p><b>Date:</b> @header.Date</p>
        <p><b>Customer:</b> @header.Customer</p>
    </div>
}

<table>
    <thead>
        <tr>
            <th>Code</th>
            <th>Name</th>
            <th>Quantity</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var i in pdfItems ?? new())
        {
            <tr>
                <td>
                    <InputText @bind-Value="i.Code" style="width:120px" />
                </td>
                <td>
                    <InputText @bind-Value="i.Name" style="width:300px" />
                </td>
                <td>
                    <InputNumber @bind-Value="i.Quantity" style="width:80px" />
                </td>
            </tr>
        }
    </tbody>
</table>
    

@code {
    List<PdfService.OrderItem>? pdfItems;
    PdfService.OrderHeader? header;
    
private async Task OnFileSelected(InputFileChangeEventArgs e)
{
    var file = e.File;

    using var ms = new MemoryStream();
    await file.OpenReadStream(long.MaxValue).CopyToAsync(ms);

    var result = PdfService.ParseDocument(ms.ToArray());

    header = result.Header;
    pdfItems = result.Items;

}

}
