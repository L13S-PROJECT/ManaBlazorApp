@using ManaApp.Models

<div class="planning-container">
<table class="excel-table">

<thead>
    <tr>
        <th class="col-name">Nosaukums</th>
        <th>Stock</th>
        <th>Plan</th>
        <th class="col-plus"></th>
        <th>Det.IP</th>
        <th>Det.F</th>
        <th>Asm.IP</th>
        <th>Asm.F</th>
        <th>Fin.IP</th>
    </tr>
</thead>


    <tbody>
    @foreach (var cat in Groups.GroupBy(g => g.CategoryName))
    {
        <tr class="excel-category">
            <td colspan="10">@cat.Key</td>
        </tr>

        @foreach (var grp in cat)
{
    <tr class="excel-row @(grp.IsExpanded ? "is-open" : "")"
    style="font-weight:600"
    @key="grp">


                <td class="name-cell expandable" style="font-weight:600">
                    <span class="chevron"
                        @onclick="() => grp.IsExpanded = !grp.IsExpanded">
                        @(grp.IsExpanded ? "▾" : "▸")
                    </span>

                <span class="product-name product-main">
                    @grp.ProductName
                </span>
                </td>

                <td class="@(grp.InStock > 0 ? "cell-stock" : "cell-zero")">
                    @grp.InStock
                </td>

                <td class="@(grp.Planned > 0 ? "cell-plan-strong" : "cell-zero")">
                    @grp.Planned
                </td>

                <td class="plus-cell @(IsInDraft(grp) ? "is-draft-cell" : "")">
                    <button type="button"
                            class="planned-btn"
                            @onclick:stopPropagation="true"
                            @onclick="() => OnPlannedPlus(grp)">
                        +
                    </button>
                </td>

                <td class="@(grp.DetailedInProgress > 0 ? "cell-inprogress" : "cell-zero")">
                    @grp.DetailedInProgress
                </td>
                <td class="@(grp.DetailedFinish > 0 ? "cell-finished" : "cell-zero")">
                    @grp.DetailedFinish
                </td>
                <td class="@(grp.AssemblyINProgress > 0 ? "cell-inprogress" : "cell-zero")">
                    @grp.AssemblyINProgress
                </td>
                <td class="@(grp.AssemblyFinish > 0 ? "cell-finished" : "cell-zero")">
                    @grp.AssemblyFinish
                </td>
                <td class="@(grp.FinishingInProgress > 0 ? "cell-inprogress" : "cell-zero")">
                    @grp.FinishingInProgress
                </td>
            </tr>

@if (grp.Versions is not null && grp.IsExpanded)
{
    @for (int i = 0; i < grp.Versions.Count; i++)
    {
        var ver = grp.Versions[i];
        var isLast = i == grp.Versions.Count - 1;

        <tr class="excel-detail @(ver.IsRalRow ? "excel-ral" : "") @(isLast ? "last-detail" : "")"
            @key="ver">

            <td class="name-cell detail-name">
                <div class="detail-wrap">
                    @if(!ver.IsRalRow)
                    {
                        @grp.ProductName
                        <span class="detail-version">(@ver.versionName)</span>
                    }
                    else
                    {
                        <span class="ral-dot">●</span>
                        <span class="ral-code">RAL @ver.RalCode</span>
                    }
                </div>
            </td>

<td>
    @if(ver.IsRalRow)
    {
        <span class="instock-value">@ver.InStock</span>
    }
</td>

            <td>
            @if(!ver.IsRalRow)
            {
                <div class="planned-cell">
                    <span class="planned-value">@ver.Planned</span>
                </div>
            }
            </td>

            <td class="plus-cell"></td>

            <td>@if(!ver.IsRalRow){ @ver.DetailedInProgress }</td>
            <td>@if(!ver.IsRalRow){ @ver.DetailedFinish }</td>
            <td>@if(!ver.IsRalRow){ @ver.AssemblyINProgress }</td>
            <td>@if(!ver.IsRalRow){ @ver.AssemblyFinish }</td>
            <td>
                @if(ver.IsRalRow)
                {
                    @ver.FinishingInProgress
                }
            </td>

        </tr>
        }
        }
        }
        }
    
</tbody>

</table>
</div>


@code {
    [Parameter] 
    public List<ProductGroupRow> Groups { get; set; } = new();

    [Parameter] 
    public EventCallback<ProductGroupRow> PlannedPlus { get; set; }

    [Parameter]
    public List<int> DraftVersionIds { get; set; } = new();
    private async Task OnPlannedPlus(ProductGroupRow row)
    {
        if (PlannedPlus.HasDelegate)
            await PlannedPlus.InvokeAsync(row);
    }

    [Parameter]
public EventCallback<ProductRow> PlannedMinus { get; set; }

private async Task OnPlannedMinus(ProductRow row)
{
    if (PlannedMinus.HasDelegate)
        await PlannedMinus.InvokeAsync(row);
}

private bool IsInDraft(ProductGroupRow grp)
{
    var ver = grp.Versions?.FirstOrDefault();
    if (ver?.VersionId is not int v)
        return false;

    return DraftVersionIds.Contains(v);
}

}

