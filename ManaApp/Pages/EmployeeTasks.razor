@*Darbinieku kopskats - ar pieeajmiem darbiem*@

@page "/employeetasks"
@using System.Net.Http.Json
@using System.Linq
@inject HttpClient Http
@using ManaApp.Components.EmployeeTasks
@using ManaApp.Shared
@using ManaApp.Services
@inject AppState AppState

<div class="employee-page-root">

<div class="employee-switch">
    <button @onclick="PrevEmployee">◀</button>

    <select @bind="selectedEmployeeId" @bind:after="OnEmployeeChangedAfter">
        @foreach (var emp in employees)
        {
            <option value="@emp.Id">
                @emp.Name
            </option>
        }
    </select>

    <button @onclick="NextEmployee">▶</button>
</div>

<div class="employee-main-block">   
    <div class="main-layout">

    <div class="left-panel">

        @if (tasks.Count == 0)
        {
            <div class="empty-state">
                Šobrīd tev nav piešķirtu darbu.
            </div>
        }
        else
        {
                @if (InProgress.Any())
                {
                    <div class="elp-section">
                    <h5>Darbs procesā</h5>
                    <TasksTable Tasks="InProgress"
                                StatusText="StatusText"            
                                OnSelect="SelectTask"                                
                                AvailableTaskId="FirstAvailableTask?.TaskId" />
                    </div>
                }

                @if (PushTasks.Any())
                    {
                        <div class="elp-section push">
                            <h5>Push darbi</h5>
                            <TasksTable Tasks="PushTasks"
                                        StatusText="StatusText"                                        
                                        OnSelect="SelectTask"                                        
                                        AvailableTaskId="FirstAvailableTask?.TaskId" />
                        </div>
                    }

                @if (SuperPriorityCanStart.Any())
                {
                    <div class="elp-section">
                    <h5>Prioritārie – var sākt</h5>
                    <TasksTable Tasks="SuperPriorityCanStart"
                                StatusText="StatusText"                                
                                OnSelect="SelectTask"                                
                                AvailableTaskId="FirstAvailableTask?.TaskId" />
                    </div>
                }

                @if (SuperPriorityWaiting.Any())
                {
                    <div class="elp-section waiting">
                        <h5>Prioritārie – gaida</h5>
                        <TasksTable Tasks="SuperPriorityWaiting"
                                    StatusText="StatusText"
                                    OnSelect="SelectTask"
                                    AvailableTaskId="FirstAvailableTask?.TaskId" />
                    </div>
                }

                @if (BatchPriorityCanStart.Any())
                    {
                        <div class="elp-section">
                            <h5>Prioritārie</h5>
                            <TasksTable Tasks="BatchPriorityCanStart"
                                        StatusText="StatusText"                                        
                                        OnSelect="SelectTask"                                        
                                        AvailableTaskId="FirstAvailableTask?.TaskId" />
                        </div>
                    }
                @if (BatchPriorityWaiting.Any())
                    {
                        <div class="elp-section waiting">
                            <h5>Prioritārie – gaida</h5>
                            <TasksTable Tasks="BatchPriorityWaiting"
                                        StatusText="StatusText"
                                        OnSelect="SelectTask"
                                        AvailableTaskId="FirstAvailableTask?.TaskId" />
                        </div>
                    }
                    
                
                @if (NormalSuperCanStart.Any())
                    {
                        <div class="elp-section">
                        <h5>Pārējie – var sākt</h5>
                        <TasksTable Tasks="NormalSuperCanStart"
                                    StatusText="StatusText"                                
                                    OnSelect="SelectTask"                                
                                    AvailableTaskId="FirstAvailableTask?.TaskId" />
                        </div>
                    }

                @if (NormalSuperWaiting.Any())
                    {
                        <div class="elp-section waiting">
                            <h5>Pārējie prioritārie – gaida</h5>
                            <TasksTable Tasks="NormalSuperWaiting"
                                        StatusText="StatusText"
                                        OnSelect="SelectTask"
                                        AvailableTaskId="FirstAvailableTask?.TaskId" />
                        </div>
                    }
                
        @if (NormalCanStart.Any())
            {
                <div class="elp-section">
                    <h5>Pārējie</h5>
                    <TasksTable Tasks="NormalCanStart"
                                StatusText="StatusText"                    
                                OnSelect="SelectTask"                    
                                AvailableTaskId="FirstAvailableTask?.TaskId" />
                </div>
            }

        @if (NormalWaiting.Any())
            {
                <div class="elp-section waiting">
                    <h5>Pārējie – gaida</h5>
                    <TasksTable Tasks="NormalWaiting"
                                StatusText="StatusText"
                                OnSelect="SelectTask"
                                AvailableTaskId="FirstAvailableTask?.TaskId" />
                </div>
            }


        }

    </div>


    <div class="right-panel">
        <ActiveTaskPanel ActiveTask="_activeTask"
            OnFinish="FinishTask"
            StatusText="StatusText"
            OnStart="OpenTaskDialog"
            OnFinishConfirm="OpenFinishDialog"
            AvailableTaskId="FirstAvailableTask?.TaskId"
            HasActiveTask="_activeTask?.Status == 2" />
    </div>
</div>
    </div>
</div>
<TaskDialog IsOpen="_isDialogOpen"
            IsFinish="@(_dialogMode == TaskDialogMode.Finish)"
            SelectedTask="_selectedTask"
            StatusText="StatusText"
            
            OnConfirm="@(async t => {
       if (_dialogMode == TaskDialogMode.Finish)
            await FinishTask(t);
        else
            await ClaimTask(t.TaskId);

        _isDialogOpen = false;
        _dialogMode = TaskDialogMode.None;

            })"
            OnClose="() => {
                _isDialogOpen = false;
                _dialogMode = TaskDialogMode.None;}" />

@code {
    private List<TaskRow> tasks = new();
    
// PUSH (augstāk par visiem)
private IEnumerable<TaskRow> PushTasks =>
    tasks.Where(t => t.PriorityLevel >= 0 && t.Tasks_Push && t.Status == 1);
private IEnumerable<TaskRow> InProgress =>
    tasks.Where(t => t.Status == 2);

// 1) Super prioritārie (BatchPriority + Tasks_Priority)
private IEnumerable<TaskRow> SuperPriorityCanStart =>
    tasks.Where(t => t.PriorityLevel == 3 && t.Status == 1 && t.CanStart);

private IEnumerable<TaskRow> SuperPriorityWaiting =>
    tasks.Where(t => t.PriorityLevel == 3 && t.Status == 1 && !t.CanStart);

// 2) Prioritārie (BatchPriority tikai)
private IEnumerable<TaskRow> BatchPriorityCanStart =>
    tasks.Where(t => t.PriorityLevel == 2 && t.Status == 1 && t.CanStart);

private IEnumerable<TaskRow> BatchPriorityWaiting =>
    tasks.Where(t => t.PriorityLevel == 2 && t.Status == 1 && !t.CanStart);

// 3) Secīgie ar part prioritāti
private IEnumerable<TaskRow> NormalSuperCanStart =>
    tasks.Where(t => t.PriorityLevel == 1 && t.Status == 1 && t.CanStart);

private IEnumerable<TaskRow> NormalSuperWaiting =>
    tasks.Where(t => t.PriorityLevel == 1 && t.Status == 1 && !t.CanStart);

// 4) Parastie
private IEnumerable<TaskRow> NormalCanStart =>
    tasks.Where(t => t.PriorityLevel == 0 && t.Status == 1 && t.CanStart);

private IEnumerable<TaskRow> NormalWaiting =>
    tasks.Where(t => t.PriorityLevel == 0 && t.Status == 1 && !t.CanStart);

private string StatusText(int s, TaskRow t) => s switch
{
    1 => "Nav iesākts",
    2 => "Procesā",
    3 => "Pabeigts",
    4 => "Atcelts",
    _ => "?"
};

private string StatusText(int s) => StatusText(s, null!);


private async Task ClaimTask(int taskId)
{
    var body = new
    {
        taskId,
        empId = selectedEmployeeId
    };

    var resp = await Http.PostAsJsonAsync("api/tasks/claim", body);

if (resp.IsSuccessStatusCode)
{
    await LoadTasks();

    _activeTask = tasks
        .FirstOrDefault(t => t.Status == 2);

    CloseTaskDialog();
}
else
{
    var error = await resp.Content.ReadAsStringAsync();
    Console.WriteLine($"CLAIM ERROR: {error}");
}
}

private async Task LoadTasks()
{
    tasks = await Http.GetFromJsonAsync<List<TaskRow>>(
        $"api/tasks/for-employee?empId={selectedEmployeeId}"
    ) ?? new();

    tasks = tasks.ToList();

    _activeTask = tasks
    .Where(t => t.Status == 2)
    .OrderBy(t => t.StepOrder)
    .ThenBy(t => t.TaskId)
    .FirstOrDefault();
}

private TaskRow? FirstAvailableTask =>
    tasks.FirstOrDefault(t => t.Status == 1 && t.CanStart);

private async Task FinishTask(TaskRow task)
{
    if (task is null) return;

    // cik vēl nav padarīts šim uzdevumam
    var remaining = task.Planned - task.Done;
    if (remaining < 0) remaining = 0;

    var body = new
    {
        taskId = task.TaskId,
        qtyDoneAdd = remaining > 0 ? remaining : (int?)null
    };

    // pabeidzam tasku API pusē
    var resp = await Http.PostAsJsonAsync(
    "api/tasks/finish", body);

    if (!resp.IsSuccessStatusCode)
    {
        Console.WriteLine($"Finish failed: {resp.StatusCode} - {await resp.Content.ReadAsStringAsync()}");
        return;
    }

    // pārlādējam uzdevumus
    await LoadTasks();
}

private bool _isDialogOpen = false;
private TaskRow? _selectedTask;

private Task OpenTaskDialog(TaskRow t)
{
    _selectedTask = t;
    _dialogMode = TaskDialogMode.Start;
    _isDialogOpen = true;
    return Task.CompletedTask;


}

private async Task LoadEmployees()
{
    employees = await Http.GetFromJsonAsync<List<EmployeeDto>>(
        "api/employees"
    ) ?? new();

    if (employees.Any() && selectedEmployeeId == 0)
        {
            selectedEmployeeId = employees.First().Id;
        }
}

private void CloseTaskDialog()
{
    _isDialogOpen = false;
    _selectedTask = null;
}

private TaskRow? _activeTask;

private void SelectTask(TaskRow task)
{
    _activeTask = task;
    _dialogMode = TaskDialogMode.None;
}

private int GetRootId(TaskRow t)
{
    return t.RootId != 0 ? t.RootId : t.BatchProductId;
}

enum TaskDialogMode
{
    None,
    Start,
    Finish
}

TaskDialogMode _dialogMode = TaskDialogMode.None;


private void OpenFinishDialog(TaskRow t)
{
    _selectedTask = t;
    _dialogMode = TaskDialogMode.Finish;
    _isDialogOpen = true;
}

private int selectedEmployeeId = 1;
private List<EmployeeDto> employees = new();

private class EmployeeDto
{
    public int Id { get; set; }
    public string Name { get; set; } = "";
}

protected override async Task OnInitializedAsync()
{
    await LoadEmployees();
    await LoadTasks();
}


private async Task OnEmployeeChanged(ChangeEventArgs e)
{
    selectedEmployeeId = int.Parse(e.Value!.ToString()!);
    await LoadTasks();
}

private async Task PrevEmployee()
{
    var index = employees.FindIndex(e => e.Id == selectedEmployeeId);
    if (index > 0)
    {
        selectedEmployeeId = employees[index - 1].Id;
        await LoadTasks();
    }
}

private async Task NextEmployee()
{
    var index = employees.FindIndex(e => e.Id == selectedEmployeeId);
    if (index < employees.Count - 1)
    {
        selectedEmployeeId = employees[index + 1].Id;
        await LoadTasks();
    }
}


private async Task OnEmployeeChangedAfter()
{
    await LoadTasks();
}

}


