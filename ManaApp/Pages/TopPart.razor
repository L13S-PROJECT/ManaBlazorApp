@page "/toppart"

@using ManaApp.Components.TopPart
@using ManaApp.Shared.DTOs.TopPart
@using ManaApp.Services
@inject TopPartWorkflowService TopPartWorkflowService
@inject TopPartService TopPartService

<PageTitle>TopPart</PageTitle>

<div class="toppart-page">

    <div class="toppart-layout">

        <section class="toppart-main">

            <TopPartToolbar
                Categories="categories"
                HasSelectedTopPart="@(selectedTopPart is not null)"
                OnNewTopPart="OpenNewTopPartModal"
                OnTypeFilterChanged="TypeFilterChanged"
                OnCategoryFilterChanged="CategoryFilterChanged"
                OnSearchChanged="SearchChanged"
                OnRelatedFilter="RelatedFilter"
                OnClearFilters="ClearFilters" />

            <TopPartList
                @ref="topPartList"
                OnSelected="SelectTopPart"
                SelectedTopPartId="selectedTopPart?.Id"
                TopPartTypeFilter="topPartTypeFilter"
                TopPartCategoryFilter="topPartCategoryFilter"
                TopPartSearchFilter="@topPartSearchFilter"
                RelatedTopPartId="relatedTopPartId" />

        </section>

        <aside class="toppart-details">

            <section class="toppart-info-section">

                <TopPartFlowDetails
                    TopPart="selectedTopPart"
                    Categories="categories"
                    OnEdit="OpenEditTopPartModal" />

            </section>

            <section class="toppart-bom-section">

                <TopPartBom
                    @ref="topPartBom"
                    TopPart="selectedTopPart"
                    OnWorkflowChanged="WorkflowChanged" />

            </section>

            <section class="toppart-flow-section">

                <TopPartFlow
                    @ref="topPartFlow"
                    TopPart="selectedTopPart"
                    OnFlowChanged="FlowChanged"
                    OnEditRequested="OpenFlowEditModal"
                    OnTopPartOpenRequested="OpenTopPartFromFlow" />

            </section>

        </aside>

    </div>

</div>

@if (showTopPartModal)
    {
        <TopPartFormModal
            TopPart="editingTopPart"
            OnClose="CloseTopPartModal"
            OnSaved="TopPartSaved" />
    }

@if (showFlowEditModal && editingWorkflowId.HasValue)
{
    <TopPartFlowEditModal
        WorkflowId="editingWorkflowId.Value"
        OnClose="CloseFlowEditModal"
        OnWorkflowChanged="WorkflowChanged" />
}

@if (showSavedConfirmation)
{
    <div class="save-confirm-backdrop">
        <div class="save-confirm-modal">

            <div class="save-confirm-icon">
                ✓
            </div>

            <div class="save-confirm-content">
                <div class="save-confirm-title">
                    Saglabāts
                </div>

                <div class="save-confirm-text">
                    Izmaiņas veiksmīgi saglabātas.
                </div>

                <button type="button"
                        class="save-confirm-button"
                        @onclick="ConfirmSaved">
                    OK
                </button>
            </div>

        </div>
    </div>
}

@code {
    private bool showTopPartModal = false;
    private TopPartList? topPartList;
    private bool showSavedConfirmation = false;
    private TopPartListItemDto? editingTopPart;
    private TopPartFlow? topPartFlow;
    private TopPartBom? topPartBom;
    private bool showFlowEditModal;
    private int? editingWorkflowId;
    private string? topPartSearchFilter;
    private byte? topPartTypeFilter;
    private int? topPartCategoryFilter;
    private uint? relatedTopPartId;
    
    private void OpenNewTopPartModal()
        {
            editingTopPart = null;
            showTopPartModal = true;
        }

    private void CloseTopPartModal()
        {
            showTopPartModal = false;
        }
    
    private TopPartListItemDto? selectedTopPart;

   private async Task SelectTopPart(TopPartListItemDto? topPart)
        {
            selectedTopPart = topPart;

            if (topPart is null)
            {
                relatedTopPartId = null;

                if (topPartList is not null)
                {
                    await topPartList.ReloadAsync(
                        typeFilter: topPartTypeFilter,
                        categoryFilter: topPartCategoryFilter,
                        searchFilter: topPartSearchFilter);
                }
            }
        }

    private List<TopPartCategoryDto> categories = new();
        
    
    protected override async Task OnInitializedAsync()
    {
        categories = await TopPartService.GetCategoriesAsync();
    }

    private async Task TopPartSaved(TopPartListItemDto createdTopPart)
        {
            showTopPartModal = false;

            if (topPartList is not null)
            {
                await topPartList.ReloadAsync();
            }

            selectedTopPart = createdTopPart;
            showSavedConfirmation = true;
        }
    
    private async Task ConfirmSaved()
        {
            showSavedConfirmation = false;

            if (topPartList is not null)
                {
                    selectedTopPart = await topPartList.ReloadAsync(selectedTopPart?.Id);
                }
        }
    
    private void OpenEditTopPartModal(TopPartListItemDto topPart)
        {
            editingTopPart = topPart;
            showTopPartModal = true;
        }

    private async Task FlowChanged()
        {
            if (topPartFlow is not null)
            {
                await topPartFlow.ReloadAsync();
            }
        }

    private async Task CloseFlowEditModal()
        {
            showFlowEditModal = false;
            editingWorkflowId = null;

            if (topPartFlow is not null)
            {
                await topPartFlow.ReloadAsync();
            }

            if (topPartBom is not null)
            {
                await topPartBom.ReloadAsync();
            }

            if (topPartList is not null)
                {
                    selectedTopPart = await topPartList.ReloadAsync(selectedTopPart?.Id);
                }

        }

    private void OpenFlowEditModal(int workflowId)
        {
            editingWorkflowId = workflowId;
            showFlowEditModal = true;
        }

    private async Task WorkflowChanged()
        {
            if (topPartList is not null)
            {
                selectedTopPart =
                    await topPartList.ReloadAsync(selectedTopPart?.Id);
            }

            if (topPartFlow is not null)
            {
                await topPartFlow.ReloadAsync();
            }

            if (topPartBom is not null)
            {
                await topPartBom.ReloadAsync();
            }
        }

    private async Task OpenTopPartFromFlow(uint topPartId)
        {
            showFlowEditModal = false;

            if (topPartList is not null)
            {
                selectedTopPart = await topPartList.ReloadAsync((int)topPartId);
            }
        }

    private async Task TypeFilterChanged(byte? type)
        {
            topPartTypeFilter = type;
            selectedTopPart = null;

            if (topPartList is not null)
            {
                await topPartList.ReloadAsync(typeFilter: type);
            }
        }

    private async Task CategoryFilterChanged(int? categoryId)
        {
            topPartCategoryFilter = categoryId;
            selectedTopPart = null;

            if (topPartList is not null)
            {
                await topPartList.ReloadAsync(
                    typeFilter: topPartTypeFilter,
                    categoryFilter: categoryId);
            }
        }

    private async Task SearchChanged(string? search)
        {
            topPartSearchFilter = search;
            selectedTopPart = null;

            if (topPartList is not null)
            {
                await topPartList.ReloadAsync(
                    typeFilter: topPartTypeFilter,
                    categoryFilter: topPartCategoryFilter,
                    searchFilter: search);
            }
        }

    private async Task ClearFilters()
        {
            topPartTypeFilter = null;
            topPartCategoryFilter = null;
            topPartSearchFilter = null;
            selectedTopPart = null;

            if (topPartList is not null)
            {
                await topPartList.ReloadAsync(
                    typeFilter: null,
                    categoryFilter: null,
                    searchFilter: null);
            }
        }

    private async Task RelatedFilter()
        {
            if (selectedTopPart is null)
                return;

            relatedTopPartId = (uint)selectedTopPart.Id;

            if (topPartList is not null)
            {
                await topPartList.ReloadAsync(
                    selectedTopPartId: selectedTopPart.Id,
                    relatedTopPartId: relatedTopPartId);
            }
        }

}