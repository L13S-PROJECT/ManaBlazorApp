@using ManaApp.Components.Orders

@page "/orders"


@* <OrderImport /> *@

<div class="orders-layout">

    <div class="orders-block block-list">
    <OrdersList SelectedOrderIdChanged="OnSelectedOrderChanged" />
    </div>

    <div class="orders-block block-details">
    <OrderDetails OrderId="@selectedOrderId" />
    </div>

    <div class="orders-block block-dispatch">
    <OrderDispatch />
    </div>

</div>

@code {

    private int? selectedOrderId;

    private void OnSelectedOrderChanged(int? orderId)
    {
        selectedOrderId = orderId;
    }

}