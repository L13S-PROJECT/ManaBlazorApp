                                    </div>
                                </div>
                            </div>
                        </td>

                        <td>
                            <div>@GetAssemblyStatus(p)</div>

                            <div class="progress mt-1" style="height:6px;">
                                <div class="progress-bar @GetAssemblyBarClass(p)"
