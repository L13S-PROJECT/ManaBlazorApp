                            </div>
                        </td>

                        <td>
                            <div class="d-flex justify-content-center gap-3">

                                <!-- ASSEMBLY (zilais) -->
                                <div class="text-center">
                                    <div class="text-muted" style="font-size:12px;">
                                        @p.FinishingY
                                    </div>
                                    <div class="rounded-pill bg-primary mt-1"
                                        style="height:6px; width:28px;">
