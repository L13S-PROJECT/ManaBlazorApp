                        </div>
                    </div>
                }
}
            </div>
        </div>
    </div>
</div>

    <div class="pp-section mt-4">
    <div class="pp-section-header">
        Parastie produkti
    </div>
    <div class="pp-section-body">

<table class="table">
    <thead>
        <!-- NOKOPĒ esošo thead -->
    </thead>
    <tbody>
