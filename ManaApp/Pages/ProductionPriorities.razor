@code {

    private bool showSavedPopup = false;
    private List<ProductRow>? products;
    
private IEnumerable<ProductRow> PriorityProducts =>
    products?
        .Where(p => p.IsPriority)
        .Where(p => !p.IsChild || (p.IsChild && !p.HasParent))
        .Where(FilterProduct)
    ?? Enumerable.Empty<ProductRow>();

private IEnumerable<ProductRow> NormalProducts =>
    products?
        .Where(p => !p.IsPriority)
        .Where(p => !p.IsChild || (p.IsChild && !p.HasParent))
        .Where(FilterProduct)
    ?? Enumerable.Empty<ProductRow>();

 private List<ProductRow> _priorityList = new();
private List<ProductRow> _normalList = new();
protected override async Task OnInitializedAsync()
{
    await LoadProducts();

}

private async Task LoadProducts()
{
    products = await Http.GetFromJsonAsync<List<ProductRow>>(
    "http://localhost:5270/api/production-priorities");

    if (products != null)
        {
            var groups = products.GroupBy(x => x.RootId);

            foreach (var g in groups)
            {
                var hasParentRow = g.Any(x => x.BatchProductId == x.RootId);
                var hasChildRows = g.Any(x => x.BatchProductId != x.RootId);

                foreach (var item in g)
                    {
                        item.IsChild = item.BatchProductId != item.RootId;

                        // tikai ja IR gan parent gan child → tas ir "Parent+Child"
                        item.HasParent = hasParentRow && hasChildRows;
                    }
            }
        }

        _priorityList = products?
            .Where(p => p.IsPriority)
            .Where(p => !p.IsChild || (p.IsChild && !p.HasParent))
            .GroupBy(p => p.RootId)
            .OrderBy(g => g.Min(x => x.Priority))
            .SelectMany(g => g)
            .ToList()
            ?? new List<ProductRow>();

        _normalList = products?
            .Where(p => !p.IsPriority)
            .Where(p => !p.IsChild || (p.IsChild && !p.HasParent))
            .GroupBy(p => p.RootId)
            .OrderBy(g => g.Min(x => x.NormalOrder == 0 ? int.MaxValue : x.NormalOrder))
            .SelectMany(g => g)
            .ToList()
            ?? new List<ProductRow>();

    _batchList = products?
        .Select(p => p.BatchCode)
        .Distinct()
        .OrderBy(x => x)
        .ToList()
        ?? new List<string>();

}

private string GetDetailedStatus(ProductRow p)
{
    if (p.DetailedFinish > 0)
        return "Done";

    if (p.DetailedInProgress > 0)
        return "In progress";

    return "Not started";
}

private string GetDetailedBarClass(ProductRow p)
{
if (p.DetailedIsDone)
    return "bg-success";

if (p.DetailedStartedX > 0)
    return "bg-warning";

return "";
}


private string GetAssemblyStatus(ProductRow p)
{
        if (p.Assembly > 0)
            return "In progress";

        if (p.DetailedIsDone)
            return "Done";

        return "Not started";
}

private string GetAssemblyBarClass(ProductRow p)
{
        if (p.Assembly > 0)
            return "bg-warning";

        if (p.DetailedIsDone)
            return "bg-success";

        return "bg-light";
}

private string GetFinishingStatus(ProductRow p)
{
    if (p.FinishingStatus3 > 0 && p.FinishingStatus2 == 0)
        return "Done";

    if (p.FinishingStatus2 > 0)
        return "In progress";

    return "Not started";
}

private class ProductRow
{
    public string BatchCode { get; set; } = "";
    public int BatchProductId { get; set; }
    public int RootId { get; set; }
    public int VersionId { get; set; }
    public bool IsParentProduct { get; set; }
    public string ProductName { get; set; } = "";
    public string ProductCode { get; set; } = "";
    public string CategoryName { get; set; } = "";
    public string VersionName { get; set; } = "";   // ← TE
    public string TopPartName { get; set; } = "";
    public bool IsPriority { get; set; }
    public int Priority { get; set; }
    public int Planned { get; set; }
    public int DetailedInProgress { get; set; }
    public int DetailedFinish { get; set; }
    public int Assembly { get; set; }
    public int Done { get; set; }
    public int DetailedX { get; set; }
    public int DetailedY { get; set; }
    public int DetailedStartedX { get; set; }

    public int DetailedDoneX { get; set; }
    public bool DetailedHasStarted { get; set; }
    public bool DetailedIsDone { get; set; }

    public int FinishingStock { get; set; }
    public int FinishingStatus2 { get; set; }
    public int FinishingStatus3 { get; set; }
    public int NormalOrder { get; set; }
    public bool HasParent { get; set; }   // Parent eksistē
    public bool IsChild { get; set; }     // Šis ir child

}

private async Task SavePriorities()
{
    
    if (products == null)
        return;


// 1️⃣ Piešķiram secību pēc UI kārtības - Prioritāriem
var visiblePriority = _priorityList
    .Where(x => !x.IsChild || (x.IsChild && !x.HasParent))
    .ToList();

for (int i = 0; i < visiblePriority.Count; i++)
{
    var rootId = visiblePriority[i].RootId;

    foreach (var item in _priorityList.Where(x => x.RootId == rootId))
    {
        item.Priority = i + 1;
    }
}

// 2️⃣ Piešķiram secību pēc UI kārtības - Normālajiem

var visibleNormal = _normalList
    .Where(x => !x.IsChild || (x.IsChild && !x.HasParent))
    .ToList();

for (int i = 0; i < visibleNormal.Count; i++)
{
    var rootId = visibleNormal[i].RootId;

    foreach (var item in _normalList.Where(x => x.RootId == rootId))
    {
        item.NormalOrder = i + 1;
    }
}

foreach (var group in products.GroupBy(x => x.RootId))
{
    var first = _priorityList
        .Where(x => x.RootId == group.Key)
        .OrderByDescending(x => !x.IsChild) // Parent priekšā
        .FirstOrDefault()
    ?? _normalList
        .Where(x => x.RootId == group.Key)
        .OrderByDescending(x => !x.IsChild)
        .FirstOrDefault();

        if (first == null)
            continue;

    int newPriority = 0;

    if (first.IsPriority)
    {
        var index = _priorityList
            .Where(x => !x.IsChild || (x.IsChild && !x.HasParent))
            .ToList()
            .FindIndex(x => x.RootId == first.RootId);

        if (index >= 0)
            newPriority = index + 1;
    }

var target = group
    .FirstOrDefault(x => !x.IsChild)   // parent ja ir
    ?? group.First();                  // citādi child-only

await Http.PutAsJsonAsync(
    $"http://localhost:5270/api/production-priorities/{target.BatchProductId}",
    new
    {
        IsPriority = first.IsPriority,
        Priority = newPriority,
        NormalOrder = first.IsPriority ? 0 : _normalList
            .Where(x => !x.IsChild || (x.IsChild && !x.HasParent))
            .ToList()
            .FindIndex(x => x.RootId == first.RootId) + 1
            }
);
}

await LoadProducts();

showSavedPopup = true;

StateHasChanged();
}

private bool _isDragging = false;

private int? _selectedId = null;
private bool _draggingPriority = false;

private void GoToBatch(int batchProductId)
{
    Nav.NavigateTo($"/productiontasks-v3?batchProductId={batchProductId}");
}

private void StartDrag(ProductRow item)
{
    var group = products?
        .Where(x => x.RootId == item.RootId)
        .ToList();

    if (group == null || group.Count == 0)
        return;

    var main = group
        .OrderByDescending(x => !x.IsChild) // Parent priekšā
        .First();

    _selectedId = main.RootId;

    _draggingPriority = _priorityList.Any(x => x.RootId == main.RootId);

    _isDragging = true;

    StateHasChanged();
}

private void OnDragEnter(ProductRow target)
{
    if (!_isDragging || _selectedId == null || !_draggingPriority)
        return;
    
    if (_lastTargetId == target.RootId)
    return;

        _lastTargetId = target.RootId;

        var movingGroup = _priorityList
            .Where(x => x.RootId == _selectedId)
            .ToList();

        if (!movingGroup.Any())
            return;

        // noņem visu grupu
        _priorityList = _priorityList
            .Where(x => x.RootId != _selectedId)
            .ToList();
        
        // pārrēķina index pēc remove
        var targetIndex = _priorityList
            .FindIndex(x => x.RootId == target.RootId);

        if (targetIndex < 0)
            targetIndex = _priorityList.Count;

        // ievieto
        _priorityList.InsertRange(targetIndex, movingGroup);

    StateHasChanged();
}

private void EndDrag()
{
    _isDragging = false;
    _selectedId = null;
    _draggingPriority = false;
    _lastTargetId = null;   
}

private void OnPriorityToggled(ProductRow p, ChangeEventArgs e)
{
    var isChecked = e?.Value is bool b && b;

    var allGroupItems = products?
        .Where(x => x.RootId == p.RootId)
        .ToList();

    if (allGroupItems == null || allGroupItems.Count == 0)
        return;

    foreach (var item in allGroupItems)
    {
        item.IsPriority = isChecked;
    }

    _priorityList.RemoveAll(x => x.RootId == p.RootId);
    _normalList.RemoveAll(x => x.RootId == p.RootId);

    var groupRows = allGroupItems
        .Where(x => !x.IsChild || (x.IsChild && !x.HasParent))
        .OrderByDescending(x => !x.IsChild)
        .ToList();

    var visibleRow = groupRows.FirstOrDefault();

    if (visibleRow == null)
        return;

    if (isChecked)
    {
        visibleRow.Priority = 0;
        visibleRow.NormalOrder = 0;
        _priorityList.AddRange(groupRows);
    }
    else
    {
        visibleRow.Priority = 0;
        visibleRow.NormalOrder = 0;
        _normalList.AddRange(groupRows);
    }

    StateHasChanged();
}

private string _searchText = "";
private string _batchFilter = "";
private string _detailFilter = "";
private string _assemblyFilter = "";
private string _finishingFilter = "";
private List<string> _batchList = new();
private void ClearSearch()
{
    _searchText = "";
}

private bool FilterProduct(ProductRow p)
{
    if (!string.IsNullOrWhiteSpace(_batchFilter) &&
    p.BatchCode != _batchFilter)
    return false;

    var s = _searchText.Trim().ToLower();

if (!string.IsNullOrWhiteSpace(s))
{
    if (!(p.BatchCode?.ToLower().Contains(s) ?? false) &&
        !(p.ProductCode?.ToLower().Contains(s) ?? false) &&
        !(p.ProductName?.ToLower().Contains(s) ?? false))
        return false;
}
    
    if (!string.IsNullOrWhiteSpace(_detailFilter))
{
    if (_detailFilter == "NotStarted" && (p.DetailedStartedX > 0 || p.DetailedIsDone))
        return false;

    if (_detailFilter == "InProgress" && (p.DetailedStartedX == 0 || p.DetailedIsDone))
        return false;

    if (_detailFilter == "Done" && !p.DetailedIsDone)
        return false;
}

if (!string.IsNullOrWhiteSpace(_assemblyFilter))
{
    var assemblyDone =
    p.FinishingStock > 0 ||
    p.FinishingStatus2 > 0 ||
    p.FinishingStatus3 > 0;

    if (_assemblyFilter == "NotStarted" &&
        (p.Assembly > 0 || assemblyDone || p.DetailedIsDone))
        return false;

    if (_assemblyFilter == "CanStart" &&
        !(p.DetailedIsDone && p.Assembly == 0 && !assemblyDone))
        return false;

    if (_assemblyFilter == "InProgress" &&
        !(p.Assembly > 0 && !assemblyDone))
        return false;

    if (_assemblyFilter == "Done" && !assemblyDone)
        return false;
}

if (!string.IsNullOrWhiteSpace(_finishingFilter))
{
    if (_finishingFilter == "NotStarted" &&
        (p.FinishingStatus2 > 0 || p.FinishingStatus3 > 0 || p.FinishingStock > 0))
        return false;

    if (_finishingFilter == "CanStart" &&
        !(p.FinishingStock > 0
        && p.FinishingStatus2 == 0
        && p.FinishingStatus3 == 0))
        return false;

    if (_finishingFilter == "InProgress" && p.FinishingStatus2 == 0)
        return false;

    if (_finishingFilter == "Done" && p.FinishingStatus3 == 0)
        return false;
}

return true;
}

private void OnDragEnterNormal(ProductRow target)
{
    if (!_isDragging || _selectedId == null || _draggingPriority)
        return;

    var movingGroup = _normalList
        .Where(x => x.RootId == _selectedId)
        .ToList();

    if (!movingGroup.Any())
        return;

            // noņem visu grupu
        _normalList = _normalList
            .Where(x => x.RootId != _selectedId)
            .ToList();

        // pārrēķina index pēc remove
        var targetIndex = _normalList
            .FindIndex(x => x.RootId == target.RootId);

        if (targetIndex < 0)
            targetIndex = _normalList.Count;

        // ievieto
        _normalList.InsertRange(targetIndex, movingGroup);

    StateHasChanged();
}

private int? _lastTargetId = null;


}
