    </div>
    <div class="pp-section-body">

<div class="priority-table">


<div class="priority-body"
     @onmouseup="EndDrag">

@for (int i = 0; i < _priorityList.Count; i++)
{
    var p = _priorityList[i];
        {
                   
                    <div @key="p.BatchProductId"
