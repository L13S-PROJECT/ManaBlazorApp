@code {

    private bool showSavedPopup = false;
    private List<ProductRow>? products;
    
private IEnumerable<ProductRow> PriorityProducts =>
    products?
        .Where(p => p.IsPriority)
        .Where(FilterProduct)
    ?? Enumerable.Empty<ProductRow>();

private IEnumerable<ProductRow> NormalProducts =>
    products?
        .Where(p => !p.IsPriority)
        .Where(FilterProduct)
    ?? Enumerable.Empty<ProductRow>();

 private List<ProductRow> _priorityList = new();
private List<ProductRow> _normalList = new();
protected override async Task OnInitializedAsync()
{
    await LoadProducts();

}

private async Task LoadProducts()
{
    products = await Http.GetFromJsonAsync<List<ProductRow>>(
    "http://localhost:5270/api/production-priorities");

    _priorityList = products?
    .Where(p => p.IsPriority)
    .OrderBy(p => p.Priority)
    .ToList()
    ?? new List<ProductRow>();
    
    _normalList = products?
        .Where(p => !p.IsPriority)
        .OrderBy(p => p.NormalOrder == 0 ? int.MaxValue : p.NormalOrder)
        .ToList()
        ?? new List<ProductRow>();

    _batchList = products?
        .Select(p => p.BatchCode)
        .Distinct()
        .OrderBy(x => x)
        .ToList()
        ?? new List<string>();

}

private string GetDetailedStatus(ProductRow p)
{
    if (p.DetailedFinish > 0)
        return "Done";

    if (p.DetailedInProgress > 0)
        return "In progress";

    return "Not started";
}

private string GetDetailedBarClass(ProductRow p)
{
if (p.DetailedIsDone)
    return "bg-success";

if (p.DetailedStartedX > 0)
    return "bg-warning";

return "";
}


private string GetAssemblyStatus(ProductRow p)
{
        if (p.Assembly > 0)
            return "In progress";

        if (p.DetailedIsDone)
            return "Done";

        return "Not started";
}

private string GetAssemblyBarClass(ProductRow p)
{
        if (p.Assembly > 0)
            return "bg-warning";

        if (p.DetailedIsDone)
            return "bg-success";

        return "bg-light";
}

private string GetFinishingStatus(ProductRow p)
{
    if (p.FinishingStatus3 > 0 && p.FinishingStatus2 == 0)
        return "Done";

    if (p.FinishingStatus2 > 0)
        return "In progress";

    return "Not started";
}

private class ProductRow
{
    public string BatchCode { get; set; } = "";
    public int BatchProductId { get; set; }
    public int VersionId { get; set; }

    public string ProductName { get; set; } = "";
    public string ProductCode { get; set; } = "";
    public string CategoryName { get; set; } = "";
    public string VersionName { get; set; } = "";   // ← TE

    public bool IsPriority { get; set; }
    public int Priority { get; set; }
    public int Planned { get; set; }
    public int DetailedInProgress { get; set; }
    public int DetailedFinish { get; set; }
    public int Assembly { get; set; }
    public int Done { get; set; }
    public int DetailedX { get; set; }
    public int DetailedY { get; set; }
    public int DetailedStartedX { get; set; }

    public int DetailedDoneX { get; set; }
    public bool DetailedHasStarted { get; set; }
    public bool DetailedIsDone { get; set; }

    public int FinishingStock { get; set; }
    public int FinishingStatus2 { get; set; }
    public int FinishingStatus3 { get; set; }
    public int NormalOrder { get; set; }

}

private async Task SavePriorities()
{
    
    if (products == null)
        return;


// 1️⃣ Piešķiram secību pēc UI kārtības - Prioritāriem
    for (int i = 0; i < _priorityList.Count; i++)
    {
        _priorityList[i].Priority = i + 1;
    }

// 2️⃣ Piešķiram secību pēc UI kārtības - Normālajiem

    for (int i = 0; i < _normalList.Count; i++)
        {
            _normalList[i].NormalOrder = i + 1;
        }

    foreach (var p in products)
{
    int newPriority = 0;

    if (p.IsPriority)
    {
        var index = _priorityList
            .FindIndex(x => x.BatchProductId == p.BatchProductId);

        if (index >= 0)
            newPriority = index + 1;
    }

    await Http.PutAsJsonAsync(
        $"http://localhost:5270/api/production-priorities/{p.BatchProductId}",
        new
        {
            IsPriority = p.IsPriority,
            Priority = newPriority,
            NormalOrder = p.NormalOrder
        }
    );

}

await LoadProducts();

showSavedPopup = true;

StateHasChanged();
}

private bool _isDragging = false;

private int? _selectedId = null;
private bool _draggingPriority = false;

private void GoToBatch(int batchProductId)
{
    Nav.NavigateTo($"/productiontasks-v3?batchProductId={batchProductId}");
}

private void StartDrag(ProductRow item)
{
    _selectedId = item.BatchProductId;
    _isDragging = true;
Console.WriteLine($"DRAG START: {item.BatchProductId} | priority: {_draggingPriority}");
    _draggingPriority = _priorityList.Any(x => x.BatchProductId == item.BatchProductId);

    StateHasChanged();
}

private void OnDragEnter(ProductRow target)
{
    if (!_isDragging || _selectedId == null || !_draggingPriority)
        return;

    var currentIndex = _priorityList.FindIndex(x => x.BatchProductId == _selectedId);
    var newIndex = _priorityList.FindIndex(x => x.BatchProductId == target.BatchProductId);

    if (currentIndex == -1 || newIndex == -1 || currentIndex == newIndex)
        return;

    var item = _priorityList[currentIndex];

    _priorityList.RemoveAt(currentIndex);
    _priorityList.Insert(newIndex, item);

    StateHasChanged();
}

private void EndDrag()
{
    _isDragging = false;
    _selectedId = null;
    _draggingPriority = false;
}

private void OnPriorityToggled(ProductRow p, ChangeEventArgs e)
{
    var isChecked = e?.Value is bool b && b;

    // Atrodam īsto produktu no kopējā saraksta
    var item = products?.FirstOrDefault(x => x.BatchProductId == p.BatchProductId);
    if (item == null)
        return;

    item.IsPriority = isChecked;

if (isChecked)
{
    // noņem no normal list
    _normalList.RemoveAll(x => x.BatchProductId == item.BatchProductId);

    if (!_priorityList.Any(x => x.BatchProductId == item.BatchProductId))
    {
        _priorityList.Add(item);
    }
}
else
{
    // noņem no priority list
    _priorityList.RemoveAll(x => x.BatchProductId == item.BatchProductId);

    item.Priority = 0;

    // pievieno normal list (beigās)
    if (!_normalList.Any(x => x.BatchProductId == item.BatchProductId))
    {
        _normalList.Add(item);
    }
}
}

private string _searchText = "";
private string _batchFilter = "";
private string _detailFilter = "";
private string _assemblyFilter = "";
private string _finishingFilter = "";
private List<string> _batchList = new();
private void ClearSearch()
{
    _searchText = "";
}

private bool FilterProduct(ProductRow p)
{
    if (!string.IsNullOrWhiteSpace(_batchFilter) &&
    p.BatchCode != _batchFilter)
    return false;

    var s = _searchText.Trim().ToLower();

if (!string.IsNullOrWhiteSpace(s))
{
    if (!(p.BatchCode?.ToLower().Contains(s) ?? false) &&
        !(p.ProductCode?.ToLower().Contains(s) ?? false) &&
        !(p.ProductName?.ToLower().Contains(s) ?? false))
        return false;
}
    
    if (!string.IsNullOrWhiteSpace(_detailFilter))
{
    if (_detailFilter == "NotStarted" && (p.DetailedStartedX > 0 || p.DetailedIsDone))
        return false;

    if (_detailFilter == "InProgress" && (p.DetailedStartedX == 0 || p.DetailedIsDone))
        return false;

    if (_detailFilter == "Done" && !p.DetailedIsDone)
        return false;
}

if (!string.IsNullOrWhiteSpace(_assemblyFilter))
{
    var assemblyDone =
    p.FinishingStock > 0 ||
    p.FinishingStatus2 > 0 ||
    p.FinishingStatus3 > 0;

    if (_assemblyFilter == "NotStarted" &&
        (p.Assembly > 0 || assemblyDone || p.DetailedIsDone))
        return false;

    if (_assemblyFilter == "CanStart" &&
        !(p.DetailedIsDone && p.Assembly == 0 && !assemblyDone))
        return false;

    if (_assemblyFilter == "InProgress" &&
        !(p.Assembly > 0 && !assemblyDone))
        return false;

    if (_assemblyFilter == "Done" && !assemblyDone)
        return false;
}

if (!string.IsNullOrWhiteSpace(_finishingFilter))
{
    if (_finishingFilter == "NotStarted" &&
        (p.FinishingStatus2 > 0 || p.FinishingStatus3 > 0 || p.FinishingStock > 0))
        return false;

    if (_finishingFilter == "CanStart" &&
        !(p.FinishingStock > 0
        && p.FinishingStatus2 == 0
        && p.FinishingStatus3 == 0))
        return false;

    if (_finishingFilter == "InProgress" && p.FinishingStatus2 == 0)
        return false;

    if (_finishingFilter == "Done" && p.FinishingStatus3 == 0)
        return false;
}

return true;
}

private void OnDragEnterNormal(ProductRow target)
{
    if (!_isDragging || _selectedId == null || _draggingPriority)
        return;

    var currentIndex = _normalList.FindIndex(x => x.BatchProductId == _selectedId);
    var newIndex = _normalList.FindIndex(x => x.BatchProductId == target.BatchProductId);

    if (currentIndex == -1 || newIndex == -1 || currentIndex == newIndex)
        return;

    var item = _normalList[currentIndex];

    _normalList.RemoveAt(currentIndex);
    _normalList.Insert(newIndex, item);

    StateHasChanged();
}

}
