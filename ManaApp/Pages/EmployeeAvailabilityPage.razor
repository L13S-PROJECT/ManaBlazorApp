@page "/employee-availability"
@using ManaApp.Shared
@using ManaApp.Models
@using ManaApp.Components.EmployeeAvailability
@inject HttpClient Http

<div class="ea-page">

    <div class="ea-calendar">
        <CompanyCalendarEditor 
            OnDateChangedCallback="OnCalendarDateChanged"
            OnCalendarChanged="OnCalendarChanged" />
    </div>

    <div class="ea-table-block">
        <EmployeeAvailabilityTable 
            @key="workLogRevision"
            WorkLogs="workLogs"  
            Employees="employees"
            Availability="availability"
            SelectedDate="selectedDate"
            Calendar="calendar"
            OnEmployeeSelectedCallback="OnEmployeeSelected" />
    </div>

    <div class="ea-bottom">
        <EmployeeAvailabilityPanel
            EmployeeId="selectedEmployeeId"
            SelectedDate="selectedDate"
            Availability="availability"
            Employees="employees" />
    </div>

</div>

@code {

private List<EmployeeDto> employees = new();
    
private List<EmployeeWorkLogModel> workLogs = new();
private List<EmployeeAvailabilityModel> availability = new();
private List<CompanyCalendarModel> calendar = new();

private async Task LoadData()
{
    workLogs = await Http.GetFromJsonAsync<List<EmployeeWorkLogModel>>(
        "api/employeeworklog/date/" + selectedDate.ToString("yyyy-MM-dd")
    ) ?? new();

    availability = await Http.GetFromJsonAsync<List<EmployeeAvailabilityModel>>(
        "api/employeeavailability/range?from=2000-01-01&to=2100-01-01"
    ) ?? new();

    calendar = await Http.GetFromJsonAsync<List<CompanyCalendarModel>>(
        "api/companycalendar"
    ) ?? new();
}
protected override async Task OnInitializedAsync()
{
    employees = (await Http.GetFromJsonAsync<List<EmployeeDto>>("api/employees") ?? new())
        .Where(e => e.Role == "WORKSHOP")
        .ToList();

    await LoadData();
}

private int workLogRevision = 0;
private async Task OnCalendarDateChanged(DateTime date)
{
    selectedDate = date;
    await LoadData();
}
private DateTime selectedDate = DateTime.Today;

private async Task OnCalendarChanged()
{
    await LoadData();
    workLogRevision++;
}

private int? selectedEmployeeId;

private void OnEmployeeSelected(int? id)
{
    selectedEmployeeId = id;
}

}