@page "/employee-availability"
@using ManaApp.Shared
@using ManaApp.Models
@using ManaApp.Components.EmployeeAvailability
@inject HttpClient Http

<CompanyCalendarEditor 
    OnDateChangedCallback="OnCalendarDateChanged"
    OnCalendarChanged="OnCalendarChanged" />

<EmployeeAvailabilityTable 
    WorkLogs="workLogs"  
    Employees="employees"
    SelectedDate="selectedDate" />


@code {

private List<EmployeeDto> employees = new();
    
private List<EmployeeWorkLogModel> workLogs = new();

private async Task LoadData()
{
    workLogs = await Http.GetFromJsonAsync<List<EmployeeWorkLogModel>>(
        "api/employeeworklog/date/" + selectedDate.ToString("yyyy-MM-dd")
    ) ?? new();

}
protected override async Task OnInitializedAsync()
{
    employees = (await Http.GetFromJsonAsync<List<EmployeeDto>>("api/employees") ?? new())
        .Where(e => e.Role == "WORKSHOP")
        .ToList();

    await LoadData();
}

private async Task OnCalendarDateChanged(DateTime date)
{
    selectedDate = date;
    await LoadData();
}
private DateTime selectedDate = DateTime.Today;

private async Task OnCalendarChanged()
{
    await LoadData();
}

}