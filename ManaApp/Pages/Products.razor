}

private void SetFinalStep(PartStepDto step)
{
    if (!IsLastStep(step))
        return;

    foreach (var s in editingSteps)
        s.IsFinal = false;
    
    // ja mainām Final, noņemam visiem Painting
    foreach (var s in editingSteps)
        s.IsPainting = false;

    step.IsFinal = true;

    StateHasChanged();
}

