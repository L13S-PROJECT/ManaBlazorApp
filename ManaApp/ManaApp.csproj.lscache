/debug+
/debug:portable
/filealign:512
/optimize-
/out:obj\Debug\net8.0\ManaApp.dll
/refout:obj\Debug\net8.0\refint\ManaApp.dll
/target:exe
/warnaserror-
/utf8output
/deterministic+
/langversion:12.0
/warnaserror+:NU1605,SYSLIB0011

