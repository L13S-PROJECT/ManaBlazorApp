@*batch line edit dialog*@ 

@using ManaApp.Pages
@using ManaApp.Shared.DTOs.Planning
@inject IJSRuntime JS

@if (!IsOpen)
{
    @* neko nerādām *@
}
else
{
    <!-- Pārklājums -->
    <div class="dialog-overlay">

        <!-- Dialoga saturs -->
        <div class="dialog-window">

<h3 class="dialog-title">
    @(IsAddMode ? "Pievienot preci" : "Labot preci")
    <strong> @ProductName </strong>
</h3>

<div class="parts-layout">

@if (_parts.Any())
{
    
    var productQty = ProductOrderQty;

    <div class="dialog-card">

        <div class="section-title">
            Pasūtījumu kopsavilkums
        </div>

        <div class="summary-block">

            <div class="product-row">
                Produkts:
                <span style="font-weight:400;">
                    @(productQty > 0
                        ? $"{productQty} gab."
                        : "-")
                </span>
            </div>

            @foreach (var r in ProductRalRows)
                    {
                        <div class="ral-row">

                            <span>• @r.RalCode</span>
                            <span>@r.OrderQty gab.</span>
                        </div>
                    }
        </div>

        <div class="parts-title">
            Detaļas
        </div>

        @foreach (var p in _parts)
        {
            <div class="part-item">

                <div class="part-row">

                    <span>@p.TopPart_Name</span>

                    <span>
                        @(p.OrderQty > 0
                            ? $"{p.OrderQty} gab."
                            : "-")
                    </span>
                </div>

                @foreach (var r in p.PartRalRows ?? new())
                {
                    <div class="ral-row">

                        <span>• @r.RalCode</span>
                        <span>@r.Qty gab.</span>
                    </div>
                }
            </div>
        }
    </div>
}

            @if (Line is null)
            {
                <div class="error-text">Dati nav ielādēti.</div>
            }
            else
            {

<div class="right-side-layout">
    <div class="dialog-card">
        <b>Plānots (gab.):</b><br />
                        <input type="number"
                           min="0"
                           class="planned-input"
                           @bind="_planned"
                           disabled="@(!_canEditQty || IsArchivedVersion)" />
                </div>

                <div class="dialog-card">

                    <div class="card-title">
                        Ražošanā iekļaujamās detaļas
                    </div>
            
                        @foreach (var p in _parts)
                            {
                                <div class="part-select-row">
                                    <input type="checkbox"
                                        @bind="p.IsSelected" />

                                    <span class="part-name">@p.TopPart_Name</span>

                                    <input type="number"
                                        min="0"
                                        class="part-qty-input"
                                        @bind="p.Qty"
                                        disabled="@(!p.IsSelected)" />
                                </div>
                            }
                </div>

                <div class="comment-block">
                    <b>Komentārs:</b><br />
                    <textarea rows="3"
                              class="comment-input"
                              @bind="_comment">
                    </textarea>
                </div>

            </div>
            

                            }
            
</div>
                

                    <div class="dialog-footer">
                        <button class="e-btn e-flat cancel-btn"
                            @onclick="Close">
                        Atcelt
                    </button>


                        <button class="e-btn e-primary" @onclick="SaveClicked">
                            @(IsAddMode ? "Pievienot" : "OK")
                        </button>
                    </div>
                </div>
        </div>
    
}


@code {
    // Vai dialogs ir atvērts
    [Parameter] public bool IsOpen { get; set; }

    // Lai vecāks var sinhronizēt IsOpen
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }

    // Rinda, ko labo (no ProductionTasks BatchLine)
    [Parameter] public BatchLine? Line { get; set; }
    [Parameter] public List<ProductToPartDto>? Parts { get; set; }
    private List<ProductToPartDto> _parts = new();
    [Parameter] public string? ProductName { get; set; }
    [Parameter] public int ProductOrderQty { get; set; }
    [Parameter] public List<ProductRowDto> ProductRalRows { get; set; } = new();
    [Parameter] public bool IsArchivedVersion { get; set; }

    // Notikums, kad saglabāts
    [Parameter] public EventCallback<BatchLine> OnSaved { get; set; }

    // Lokālie lauki editēšanai
    private int _planned;
    private string? _comment;
    private bool _canEditQty = true;

    protected override void OnParametersSet()
    {
        

        if (Line is not null)
        {
            _parts = Parts?.ToList() ?? new();
            _planned = Line.Planned;
            _comment = Line.Comment;         

           // Loģika:
            // - ja statuss = 5 (VISIS) → var mainīt qty
            // - citādi qty nedrīkst mainīt, ja ir StartedAt
            if (Line.BatchStatus == 5)
            {
                _canEditQty = true;
            }
            else
            {
                _canEditQty = (Line.StartedAt == null);
            }
        }
    }

   private async Task Close()
{
    if (IsOpenChanged.HasDelegate)
        await IsOpenChanged.InvokeAsync(false);
}


    // vecā “Save” metode – ja neizmanto, var droši izdzēst
    private async Task Save()
    {
        if (Line is null)
        {
            await Close();

            return;
        }

        Line.Planned = _planned;
        Line.Comment = _comment;

        if (OnSaved.HasDelegate)
            await OnSaved.InvokeAsync(Line);

        await Close();

    }

private async Task SaveClicked()
{
    if (Line is null)
        return;

    var qtyChanged     = _planned != Line.Planned;
    var commentChanged = _comment != Line.Comment;

    var partsChanged = (_parts)
        .Any(p => p.IsSelected && p.Qty > 0);

    if (!qtyChanged && !commentChanged && !partsChanged)
    {
        if (OnSaved.HasDelegate)
            await OnSaved.InvokeAsync(Line);

        await Close();
        return;
    }

    if (!IsAddMode && qtyChanged && _canEditQty)
    {
        var ok = await JS.InvokeAsync<bool>("confirm", "Vai labot apjomu?");
        if (!ok)
            return;
    }
Console.WriteLine($"Selected parts count: {(_parts).Count(x => x.IsSelected)}");
    
    var updated = new BatchLine
    {
        BatchId        = Line.BatchId,
        BatchCode      = Line.BatchCode,
        BatchProductId = Line.BatchProductId,
        VersionId      = Line.VersionId,
        Planned        = _planned,
        Detailed       = Line.Detailed,
        Assembly       = Line.Assembly,
        Done           = Line.Done,
        Comment        = _comment,
        StartedAt      = Line.StartedAt,
        BatchStatus    = Line.BatchStatus,
        SelectedParts = (_parts)
            .Where(x => x.IsSelected && x.Qty > 0)
            .ToList()
    };

    if (OnSaved.HasDelegate)
        await OnSaved.InvokeAsync(updated);

    await Close();
}

[Parameter] public bool IsAddMode { get; set; } = false;
[Parameter] public bool IsPartOnlyMode { get; set; }

}
