@* PlanningPartsList.razor - prieks sastāvdaļām *@

@inject ManaApp.Services.TopPartService TopPartService
@inject ManaApp.Services.TopPartPlanning.TopPartPlanningService PlanningService

@namespace ManaApp.Components.Planning

<div class="planning-parts-list">

    <table class="planning-parts-table">

        <thead>

            <tr>
                <th>Nosaukums</th>
                <th>Kods</th>
                <th class="flow-column">Flow</th>
                <th class="quantity-column" title="Plānots">Plān.</th>
                <th class="quantity-column" title="Plānotais scrap">Pl. scrap</th>
                <th class="quantity-column">Gaida</th>
                <th class="quantity-column" title="Ražošanā">Ražo.</th>
                <th class="quantity-column" title="Noliktavā">Nolikt.</th>
                <th class="quantity-column" title="Rezervēts">Rez.</th>
                <th class="quantity-column">Brīvs</th>
            </tr>

        </thead>

        @foreach (var category in categories.Where(category =>
            planningParts.Any(part =>
                part.TopPartCategoryId == category.Id &&
                HasVisibleQuantity(part) &&
                (string.IsNullOrWhiteSpace(SearchText) ||
                part.PartName.Contains(SearchText, StringComparison.OrdinalIgnoreCase) ||
                part.PartCode.Contains(SearchText, StringComparison.OrdinalIgnoreCase)))))
        {
            <tbody class="category-group">
                <tr class="category-row">
                    <td colspan="10">
                        <span class="category-name">
                            @category.CategoryName
                        </span>
                    </td>
                </tr>

                @foreach (var part in planningParts.Where(part =>
                    part.TopPartCategoryId == category.Id &&
                    HasVisibleQuantity(part) &&
                    (string.IsNullOrWhiteSpace(SearchText) ||
                    part.PartName.Contains(SearchText, StringComparison.OrdinalIgnoreCase) ||
                    part.PartCode.Contains(SearchText, StringComparison.OrdinalIgnoreCase))))
                {
                    <tr class="part-row">
                        <td>@part.PartName</td>
                        <td>@part.PartCode</td>
                        <td class="flow-column"></td>
                        <td class="quantity-column">@part.PlanQty</td>
                        <td class="quantity-column">0</td>
                        <td class="quantity-column">@part.WaitingQty</td>
                        <td class="quantity-column">@part.InProductionQty</td>
                        <td class="quantity-column">@part.StockQty</td>
                        <td class="quantity-column">@part.ReservedQty</td>
                        <td class="quantity-column">@part.FreeQty</td>
                    </tr>
                }
            </tbody>
        }

    </table>

</div>

@code {
    private List<ManaApp.Shared.DTOs.TopPart.TopPartCategoryDto> categories = [];

    private List<ManaApp.Shared.DTOs.Planning.PlanningPartListItemDto>
        planningParts = [];

    [Parameter]
    public string SearchText { get; set; } = "";

    [Parameter]
    public int RefreshVersion { get; set; }

    private int loadedRefreshVersion = -1;

    private static bool HasVisibleQuantity(
            ManaApp.Shared.DTOs.Planning.PlanningPartListItemDto part)
        {
            return part.PlanQty > 0 ||
                part.WaitingQty > 0 ||
                part.InProductionQty > 0 ||
                part.StockQty > 0 ||
                part.ReservedQty > 0;
        }

    protected override async Task OnParametersSetAsync()
        {
            if (loadedRefreshVersion == RefreshVersion)
                return;

            var categoriesTask = TopPartService.GetCategoriesAsync();
            var planningPartsTask = PlanningService.GetPartsAsync();

            await Task.WhenAll(
                categoriesTask,
                planningPartsTask);

            categories = await categoriesTask;
            planningParts = await planningPartsTask;
            loadedRefreshVersion = RefreshVersion;
        }
}
