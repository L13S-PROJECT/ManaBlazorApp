@using ManaApp.Shared.DTOs.Planning
@using ManaApp.Services.TopPartPlanning
@inject TopPartPlanningService PlanningService

@namespace ManaApp.Components.Planning

<section class="production-flow-card">
    <h3 class="production-flow-title">RAŽOŠANAS PLŪSMA</h3>

    <div class="flow-table-wrapper">
        <table class="flow-table">
            <thead>
                <tr>
                    <th class="batch-column">Batch Nr.</th>
                    <th class="workflow-column">Workflow</th>
                    <th>Plānots</th>
                    <th>Ražošanā</th>
                    <th>WIP gatavs</th>
                </tr>
            </thead>

            <tbody>
                @if (isLoading)
                {
                    <tr>
                        <td colspan="5">Ielādē...</td>
                    </tr>
                }
                else if (flowItems.Count == 0)
                {
                    <tr>
                        <td colspan="5">Ražošanas plūsmas nav.</td>
                    </tr>
                }
                else
                {
                    @foreach (var item in flowItems)
                    {
                        <tr>
                            <td class="batch-column">@item.BatchCode</td>
                            <td class="workflow-column">V@(item.WorkflowVersion)</td>
                            <td>@item.PlannedQty</td>
                            <td>@item.InProductionQty</td>
                            <td></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="painting-section">
        <h4 class="painting-title">KRĀSOŠANĀ (pa RAL)</h4>

        <div class="painting-table-wrapper">
            <table class="painting-table">
                <thead>
                    <tr>
                        <th>RAL</th>
                        <th class="quantity-column">Daudzums</th>
                    </tr>
                </thead>

                <tbody>
                    <tr>
                        <td>
                            <div class="ral-cell">
                                <span class="ral-color ral-7016"
                                      aria-hidden="true"></span>
                                <span>RAL 7016</span>
                            </div>
                        </td>
                        <td class="quantity-column">4</td>
                    </tr>

                    <tr>
                        <td>
                            <div class="ral-cell">
                                <span class="ral-color ral-9005"
                                      aria-hidden="true"></span>
                                <span>RAL 9005</span>
                            </div>
                        </td>
                        <td class="quantity-column">3</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</section>

@code {
    [Parameter]
    public int TopPartId { get; set; }

    private List<PlanningProductionFlowItemDto> flowItems = [];
    private bool isLoading;

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;

        flowItems = await PlanningService
            .GetProductProductionFlowAsync(TopPartId);

        isLoading = false;
    }
}