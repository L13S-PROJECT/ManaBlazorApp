@* PlanningList.razor priekš saraksa karkasa *@

@using ManaApp.Shared.DTOs.Planning

@namespace ManaApp.Components.Planning

<div class="planning-list">
    <div class="planning-list-content">
        @switch (ActiveView)
        {
            case 0:
                <PlanningProductsList
                    @key="FilterResetVersion"
                    SelectedParentCategory="SelectedParentCategory"
                    SearchText="@SearchText"
                    RefreshVersion="RefreshVersion"
                    CorrectionBatch="CorrectionBatch"
                    OnCorrectionItemSaved="OnCorrectionItemSaved"
                    OnDraftChanged="OnDraftChanged" />
                break;

            case 1:
                <PlanningPartsList
                    @key="FilterResetVersion"
                    SearchText="@SearchText" />
                break;

            case 2:
                <PlanningSparePartsList
                    @key="FilterResetVersion"
                    SelectedParentCategory="SelectedParentCategory"
                    SearchText="@SearchText"
                    RefreshVersion="RefreshVersion"
                    CorrectionBatch="CorrectionBatch"
                    OnCorrectionItemSaved="OnCorrectionItemSaved"
                    OnDraftChanged="OnDraftChanged" />
                break;
        }
    </div>

</div>

@code {
    [Parameter]
    public int ActiveView { get; set; }

    [Parameter]
    public int? SelectedParentCategory { get; set; }

    [Parameter]
    public string SearchText { get; set; } = "";

    [Parameter]
    public int FilterResetVersion { get; set; }

    [Parameter]
    public int RefreshVersion { get; set; }

    [Parameter]
    public EventCallback OnDraftChanged { get; set; }

    [Parameter]
    public PlanningCorrectionBatchDto? CorrectionBatch { get; set; }

    [Parameter]
    public EventCallback<PlanningCorrectionBatchItemDto>
    OnCorrectionItemSaved { get; set; }

}
