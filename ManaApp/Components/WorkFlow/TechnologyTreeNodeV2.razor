@*TehnologyTreeNodeV2.razor*@


@using ManaApp.ViewModels.Workflow
@using ManaApp.DTOs.Workflow
@using ManaApp.Models

@namespace ManaApp.Components.Workflow

<div class="tt-node @(Item.IsLastChild ? "last-child" : "")"
     style="--level:@Level;">

    <div class="tt-row @((Item.IsSelected ? "selected" : ""))"
        style="padding-left:@(Item.IsFlowChild ? "0px" : $"calc(var(--level) * 24px)")"
        @onclick="HandleClick">

        <div class="tt-expand">

                @if (Item.PartChildren.Any() || Item.NodeChildren.Any())
                    {
                        <button type="button"
                                @onclick:stopPropagation="true"
                                @onclick="ToggleExpand">
                            @(IsExpanded ? "-" : "+")
                        </button>
                    }

         </div>

            <div class="tt-icon @(Item.HasPart 
                ? (Item.PartOrThrow.ParentProductTopPartId == null ? "top-part" : "sub-part")
                : $"node-type-{Item.Node?.NodeType}")">

                    @if (Item.HasNode)
                    {
                        @switch (Item.NodeOrThrow.NodeType)
                        {
                            case 2:
                                <i class="bi bi-gear"></i>
                                break;

                            case 3:
                                <i class="bi bi-diagram-3"></i>
                                break;

                            case 4:
                                <i class="bi bi-flag"></i>
                                break;

                            default:
                                <i class="bi bi-box"></i>
                                break;
                        }
                    }
                    else
                    {
                        <i class="bi bi-box"></i>
                    }

                </div>

            <div class="tt-type @(Item.HasPart 
                ? (Item.PartOrThrow.ParentProductTopPartId == null ? "top-part" : "sub-part")
                : $"node-type-{Item.Node?.NodeType}")">

            @if (Item.HasPart)
            {
                @(Item.PartOrThrow.ParentProductTopPartId == null ? "TOP PART" : "SUB PART")
            }
            else if (Item.HasNode)
            {
                @switch (Item.NodeOrThrow.NodeType)
                {
                    case 2:
                        <text>PROCESS</text>
                        break;

                    case 3:
                        <text>MERGE</text>
                        break;

                    case 4:
                        <text>FINISH</text>
                        break;
                }
            }

        </div>

        <div class="tt-title @(Item.HasPart && Item.PartOrThrow.ParentProductTopPartId == null ? "top-part" : Item.HasPart ? "sub-part" : "")">

            @if (Item.HasPart)
                {
                    @Item.PartOrThrow.TopPartName
                }
            else
                {
                    @Item.Node?.Name
                }

        </div>

            <div class="tt-actions">

                @if (Item.HasPart)
                {
                    <span class="tt-badge">
                        @(Item.PartOrThrow.ParentProductTopPartId == null 
                            ? "TOP PART" 
                            : "SUB PART")
                    </span>
                }
                else if (Item.Node?.NodeType == 3)
                {
                    <span class="tt-badge">
                        INPUTS (@Item.InputCount)
                    </span>
                }

            </div>

        </div>

    @if (IsExpanded && (Item.PartChildren.Any() || Item.NodeChildren.Any()))
        {
            <div class="tt-children">
                
                @foreach (var child in Item.PartChildren)
                    {
                        <TechnologyTreeNodeV2
                            Item="child"
                            Level="@(Level + 1)"
                            OnNodeClick="OnNodeClick" />
                    }

                    
                @foreach (var child in Item.NodeChildren)
                    {
                        <TechnologyTreeNodeV2
                            Item="child"
                            Level="@(Level + 1)"
                            OnNodeClick="OnNodeClick" />
                    }

            </div>
        }

</div>

@code
{
    [Parameter]
    public required TechnologyTreeItem Item { get; set; }

    [Parameter]
    public EventCallback<TechnologyTreeItem> OnNodeClick { get; set; }

    [Parameter]
    public int Level { get; set; }
    public bool IsSelected { get; set; }
    
    private bool IsExpanded { get; set; } = true;

    private void ToggleExpand()
    {
        IsExpanded = !IsExpanded;
    }

    private async Task HandleClick()
        {
            await OnNodeClick.InvokeAsync(Item);
        }

}