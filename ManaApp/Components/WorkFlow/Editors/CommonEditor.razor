@* CommonEditor.razor *@

@using ManaApp.Services.Workflow
@using ManaApp.Services.Items
@using ManaApp.Shared.DTOs.Items

@inject ItemApiService ItemApi

@namespace ManaApp.Components.Workflow.Editors

<section class="property-section">

    <div class="form-grid">

        <label>Tips:</label>

        <input class="form-control"
            readonly
            value="@(WorkflowEditor.SelectedNode is null
                    ? ""
                    : WorkflowEditor.NodeTypeName(WorkflowEditor.SelectedNode.Node.NodeType))" />

        <label>Nosaukums:</label>

        <input class="form-control @(WorkflowEditor.SelectedProcessHasValidationError && string.IsNullOrWhiteSpace(NodeName) ? "is-invalid" : "")"
            @bind="NodeName"
            @bind:event="oninput"
            @onblur="SaveProcess" />

        <label>Statuss:</label>

        <input class="form-control"
            readonly
            value="Aktīvs" />

        <label>Apraksts:</label>

        <textarea class="form-control"
                rows="4"
                @bind="Comments"
                @bind:event="oninput"
                @onblur="SaveComments">
        </textarea>

    </div>

    <hr />

        <div class="materials-panel">

            <div class="materials-toolbar">
                <button class="btn btn-sm btn-primary">
                    <i class="bi bi-plus"></i>
                    Pievienot
                </button>
            </div>

            <table class="table table-sm">

                <thead>
                    <tr>
                        <th>Kods</th>
                        <th>Nosaukums</th>
                        <th>Daudzums</th>
                        <th>Mērv.</th>
                    </tr>
                </thead>

                <tbody>

                @foreach (var item in Items)
                {
                    <tr>
                        <td>@item.ItemCode</td>
                        <td>@item.ItemName</td>
                        <td>@item.Qty</td>
                        <td>@item.Unit</td>
                    </tr>
                }

                </tbody>

            </table>

        </div>

</section>

@code
{
    [Parameter]
    public WorkflowEditorService WorkflowEditor { get; set; } = default!;

    [Parameter]
    public EventCallback OnProcessSaved { get; set; }   

    private List<ProductTopPartItemDto> Items = new();

    private string? Comments
        {
            get => WorkflowEditor.SelectedNode?.Node.Comments;
            set
            {
                if (WorkflowEditor.SelectedNode?.Node != null)
                    WorkflowEditor.SelectedNode.Node.Comments = value;
            }
        }

       private async Task SaveComments()
            {
                await WorkflowEditor.SaveNodeCommentsAsync();
            }

    private string? NodeName
        {
            get => WorkflowEditor.SelectedNode?.Node.Name;
            set
            {
                if (WorkflowEditor.SelectedNode?.Node != null)
                   WorkflowEditor.SelectedNode.Node.Name = value ?? "";
            }
        }

    private async Task SaveProcess()
        {
            var saved = await WorkflowEditor.SaveProcessAsync();

            if (saved)
                await OnProcessSaved.InvokeAsync();
        }

    protected override async Task OnParametersSetAsync()
        {
            if (WorkflowEditor.SelectedPart == null)
            {
                Items.Clear();
                return;
            }

            Items = await ItemApi.LoadProductTopPartItemsAsync(
                WorkflowEditor.SelectedPart.ProductToPartId);
        }

}