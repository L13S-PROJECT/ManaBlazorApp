@using ManaApp.Services.Workflow

@namespace ManaApp.Components.Workflow.Editors

<div class="parameter-group">

    <div class="form-grid">

        <label>TOP PART:</label>

        <input class="form-control"
            readonly
            value="@WorkflowEditor.GetCurrentTopPartName()" />

        <label>Ražošanas posms:</label>

        <input class="form-control"
            readonly
            value="Detail" />

        <label>Daudzums:</label>

        <input type="number"
            class="form-control"
            min="1"
            @bind="QtyPerProduct"
            @bind:event="oninput"
            @onblur="SaveQtyPerProduct" />

    </div>

</div>

@code
{
    [Parameter]
    public WorkflowEditorService WorkflowEditor { get; set; } = default!;

    private int QtyPerProduct
    {
        get => WorkflowEditor.SelectedPart?.QtyPerProduct ?? 1;
        set
        {
            if (WorkflowEditor.SelectedPart != null)
                WorkflowEditor.SelectedPart.QtyPerProduct = value < 1 ? 1 : value;
        }
    }

    private async Task SaveQtyPerProduct()
        {
            await WorkflowEditor.SaveQtyPerProductAsync();
        }
}