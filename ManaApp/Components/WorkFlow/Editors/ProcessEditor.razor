@using ManaApp.Services.Workflow

@namespace ManaApp.Components.Workflow.Editors

<div class="parameter-group">

    <div class="parameter-group-title">
        Galvenie parametri
    </div>

    <div class="form-grid">

        <div class="parameter-group">

            <div class="form-grid">

                <label>Piesaistītās detaļa</label>

                <input class="form-control"
                    readonly
                    value="@WorkflowEditor.CurrentOwnerDescription"
                    placeholder="TopPart/Sub-part nosaukums" />

                <label>Iepriekšējais PROCESS</label>

                <input class="form-control"
                    readonly
                    value="@WorkflowEditor.PreviousNodeName"
                    placeholder="Iepriekšējais darba solis - ja ir" />

            </div>

        </div>

        <label>Darba centrs:</label>

       <select class="form-select @(WorkflowEditor.SelectedProcessHasValidationError && WorkCenterId == null ? "is-invalid" : "")"
            @bind="WorkCenterId"
            @bind:after="SaveProcess">

            <option value="">-- izvēlēties --</option>

            @foreach (var wc in WorkflowEditor.State.WorkCenters)
            {
                <option value="@wc.Id">@wc.Name</option>
            }

        </select>

        <label>Izpildes laiks (min):</label>

        <input type="number"
            class="form-control @(WorkflowEditor.SelectedProcessHasValidationError && EstimatedMinutes == null ? "is-invalid" : "")"
            @bind="EstimatedMinutes"
            @bind:after="SaveProcess" />

        <label>Sagatavošanas laiks (min):</label>

        <input type="number"
                class="form-control"
                disabled />

    </div>

</div>


@code
{
    [Parameter]
    public WorkflowEditorService WorkflowEditor { get; set; } = default!;

    [Parameter]
    public EventCallback OnProcessSaved { get; set; }

    private int? EstimatedMinutes
        {
            get => WorkflowEditor.SelectedNode?.Node.EstimatedMinutes;
            set
            {
                if (WorkflowEditor.SelectedNode?.Node != null)
                    WorkflowEditor.SelectedNode.Node.EstimatedMinutes = value;
            }
        }

    private int? WorkCenterId
        {
            get => WorkflowEditor.SelectedNode?.Node.WorkCenterId;
            set
            {
                if (WorkflowEditor.SelectedNode?.Node != null)
                    WorkflowEditor.SelectedNode.Node.WorkCenterId = value;
            }
        }

    private async Task SaveProcess()
        {
            var saved = await WorkflowEditor.SaveProcessAsync();

            if (saved)
                await OnProcessSaved.InvokeAsync();
        }

} 