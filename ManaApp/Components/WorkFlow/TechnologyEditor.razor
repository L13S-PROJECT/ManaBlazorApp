
@* Technology Editor.razor *@


@using ManaApp.Services.Workflow
@using ManaApp.Components.Workflow.Editors
@using ManaApp.Models
@using ManaApp.ViewModels.Workflow
@inject TechnologyEditorService TechnologyEditorUi
@inject WorkflowEditorService WorkflowEditor

@namespace ManaApp.Components.Workflow

@if (Visible)
{
    <div class="technology-editor-overlay">

        <div class="technology-editor-window">

            <div class="technology-editor">

    <div class="technology-editor-header">

        <div class="editor-title">
            Tehnoloģijas redaktors
        </div>

        <div class="editor-right">

            <div class="editor-version">
                @WorkflowEditor.Workflow?.Workflow?.Name
            </div>

            <button class="btn btn-save">
                <i class="bi bi-floppy me-2"></i>
                <span>Saglabāt</span>
            </button>

            <button class="btn btn-close"
                @onclick="Close">
            <i class="bi bi-x-lg"></i>
        </button>

        </div>

    </div>

    <div class="technology-editor-toolbar">

        <div class="toolbar-left">

            <button class="toolbar-btn top-part"
                @onclick="AddTopPart"
                disabled="@WorkflowEditor.IsEditorLocked">
                <i class="bi bi-box"></i>
                <span>+ TOP PART</span>
            </button>

            <button class="toolbar-btn sub-part"
                @onclick="AddSubPart"
                disabled="@(!CanAddSubPart || WorkflowEditor.IsEditorLocked)">
                <i class="bi bi-box"></i>
                <span>+ SUB PART</span>
            </button>

            <button class="toolbar-btn process"
                @onclick="AddProcess"
                disabled="@(!WorkflowEditor.CanAddProcess() || WorkflowEditor.HasIncompleteProcess)">
                <i class="bi bi-gear"></i>
                <span>+ PROCESS</span>
            </button>

            <button class="toolbar-btn merge"
                @onclick="AddMerge"
                disabled="@WorkflowEditor.IsEditorLocked">
                <i class="bi bi-diagram-3"></i>
                <span>+ MERGE</span>
            </button>

            <button class="toolbar-btn finish"
                @onclick="AddFinish"
                disabled="@WorkflowEditor.IsEditorLocked">
                <i class="bi bi-flag"></i>
                <span>+ FINISH</span>
                <i class="bi bi-caret-down-fill"></i>
            </button>

        </div>

        <div class="toolbar-center">

        </div>

        <div class="toolbar-right">

            <button class="toolbar-btn check">
                <i class="bi bi-check-circle"></i>
                <span>Pārbaudīt</span>
            </button>

        </div>

    </div>

    <div class="technology-editor-body">

        <aside class="technology-tree">

            <div class="technology-tree-header">

            <div class="tree-title">
                Tehnoloģijas struktūra
            </div>

            <div class="tree-header-actions">

                <div class="tree-search">

                    <i class="bi bi-search"></i>

                    <input type="text"
                        placeholder="Meklēt koku" />

                </div>

                <button class="tree-tool-btn">
                    <i class="bi bi-sliders"></i>
                </button>

            </div>

        </div>

            <div class="technology-tree-body">

                @if (!WorkflowEditor.IsLoaded)
                    {
                        <div>Ielādēju...</div>
                    }
                    else if (!WorkflowEditor.State.TechnologyTree.Any())
                    {
                        <div class="alert alert-warning m-3">
                            <i class="bi bi-exclamation-triangle me-2"></i>
                            Šai precei nav pievienota neviena pamatdetaļa. Vispirms pievieno detaļas preces tehnoloģijai.
                        </div>
                    }
                    else
                        {
                            @foreach (var item in WorkflowEditor.State.TechnologyStructure)
                            {
                                <TechnologyStructureNode
                                    Item="item"
                                    OnNodeClick="SelectStructureNode" />
                            }
                        }

            </div>

        </aside>

        <main class="technology-properties">

                <section class="selected-element">

    <div class="panel-title">
        Atlasītais elements
    </div>

    <div class="panel-body">

@if (WorkflowEditor.SelectedStructureItem != null)
{
        <div class="selected-header">

            <div class="selected-icon">

                @switch (WorkflowEditor.SelectedStructureItem?.Node?.NodeType)
                {
                    case 1:
                        <i class="bi bi-box text-primary"></i>
                        break;

                    case 2:
                        <i class="bi bi-gear text-success"></i>
                        break;

                    case 3:
                        <i class="bi bi-diagram-3 text-warning"></i>
                        break;

                    case 4:
                        <i class="bi bi-flag text-danger"></i>
                        break;
                }

            </div>
            

            <div class="selected-title">

                <div class="selected-type">
                    @WorkflowEditor.Workflow?.Workflow?.Name
                </div>

                <div class="selected-name">
                    @WorkflowEditor.SelectedStructureItem?.Part?.TopPartName
                </div>

                <div class="selected-description">
                    @(WorkflowEditor.SelectedStructureItem is null
                        ? "Nav atlasīts neviens elements"
                        : "")
                </div>

            </div>

            <div class="selected-badge node-type-@(WorkflowEditor.SelectedStructureItem?.Node?.NodeType ?? 1)">
                @(WorkflowEditor.SelectedStructureItem?.Node is null
                    ? "TOP PART"
                    : WorkflowEditor.NodeTypeName(WorkflowEditor.SelectedStructureItem.Node.NodeType))
            </div>

            <button class="btn btn-outline-danger btn-delete-node">
                <i class="bi bi-trash"></i>
            </button>

        </div>

        <span class="@(SelectedNodeType == 1 ? "current" : "")">TOP PART</span>

        <i class="bi bi-chevron-right"></i>

        <span class="@(SelectedNodeType == 2 ? "current" : "")">PROCESS</span>

        <i class="bi bi-chevron-right"></i>

  <span class="@(SelectedNodeType == 4 ? "current" : "")">FINISH</span>

        @if (!string.IsNullOrWhiteSpace(WorkflowEditor.ValidationMessage))
        {
            <div class="alert alert-warning mt-3 mb-3">
                @WorkflowEditor.ValidationMessage
            </div>
        }

<div class="editor-content">


    <div class="editor-content-left">

        <CommonEditor WorkflowEditor="WorkflowEditor" />

    </div>

    <div class="editor-content-right">

        <section class="property-section">

<div class="type-properties">

    @if (WorkflowEditor.SelectedNode == null)
    {
        <div class="alert alert-info">
            Šim BOM elementam vēl nav izveidota tehnoloģija.
        </div>
    }
    else if (SelectedNodeType == 1)
    {
        <TopPartEditor WorkflowEditor="WorkflowEditor" />
    }
    else if (SelectedNodeType == 2)
    {
        <ProcessEditor WorkflowEditor="WorkflowEditor" />
    }
    else if (SelectedNodeType == 3)
    {
        <MergeEditor WorkflowEditor="WorkflowEditor" />
    }
    else if (SelectedNodeType == 4)
    {
        <FinishEditor WorkflowEditor="WorkflowEditor" />
    }

</div>

</section>

@* <section class="property-section">

    <div class="section-title">
        Papildus plūsmas
    </div>

    <div class="form-grid">

    <label>Turpināt plūsmu:</label>

    <input type="checkbox" />

    <label>Rezerves daļu plūsma:</label>

    <input type="checkbox" />

    <label>Piezīmes:</label>

    <textarea class="form-control"
              rows="2"></textarea>

</div>

</section> *@



    </div>

</div>
}
        
    </div>

</section>

                <section class="element-information">

                    <div class="panel-title">
                        Elementa informācija
                    </div>

                    <div class="panel-body">

                    </div>

                </section>

                <section class="technology-legend">

                    <div class="panel-title">
                        Leģenda
                    </div>

                    <div class="panel-body">

                    </div>

                </section>

            </main>

    </div>

    <div class="technology-editor-footer">
        Footer
    </div>

</div>
</div>
</div>

}

<AddTopPartDialog
    VersionId="VersionId ?? 0"
    Visible="isAddTopPartOpen"
    VisibleChanged="OnAddTopPartDialogClosed"
    ParentProductTopPartId="WorkflowEditor.GetCurrentFlowOwner()?.ProductToPartId"
    AttachToNodeId="WorkflowEditor.SelectedNode?.Node.Id"
    IsSubPart="isSubPartMode" />

<AddMergeDialog
    Visible="isAddMergeOpen"
    VisibleChanged="OnAddMergeDialogClosed" />

@code
{
    [Parameter]
    public bool Visible { get; set; }

    private bool isAddMergeOpen;

    [Parameter]
    public EventCallback<bool> VisibleChanged { get; set; }

    [Parameter]
    public int? VersionId { get; set; }
    private bool isAddTopPartOpen;
    private bool initialized;
    private int? SelectedNodeType => WorkflowEditor.SelectedNode?.Node.NodeType;
    private bool isSubPartMode;
    private bool CanAddSubPart =>
        WorkflowEditor.CanAddSubPart();
            
        protected override async Task OnParametersSetAsync()
        {
            if (initialized && WorkflowEditor.Workflow?.Workflow?.VersionId == VersionId)
                return;

            if (VersionId is null || VersionId <= 0)
                {
                    return;
                }

            try
                {
                    if (await WorkflowEditor.LoadAsync(VersionId.Value) == null)
                        {
                            return;
                        }
                    
                }
            catch (Exception ex)
                {
                    Console.WriteLine(ex);
                    throw;
                }
            finally
                {
                    initialized = true;
                }            
        }

        private void SelectNode(TechnologyTreeItem item)
            {
                WorkflowEditor.SelectTreeItem(item);
            }

        private async Task Close()
            {
                await VisibleChanged.InvokeAsync(false);
            }

        private async Task AddTopPart()
            {
                if (VersionId is null)
                    return;

                await WorkflowEditor.LoadAvailableTopPartsAsync(VersionId.Value);

                isSubPartMode = false;
                isAddTopPartOpen = true;
            
            }  
        
        private async Task AddSubPart()
            {
                if (!WorkflowEditor.CanAddSubPart())
                    return;

                if (WorkflowEditor.GetCurrentTopPartName() == null)
                    return;

                await WorkflowEditor.LoadAvailableSubPartsAsync(VersionId!.Value);

                isSubPartMode = true;
                isAddTopPartOpen = true;
            }

        private bool isAddProcessOpen;

        private async Task AddProcess()
            {
                if (!WorkflowEditor.CanAddProcess())
                    return;
                
                if (WorkflowEditor.SelectedStructureItem == null)
                    return;

                var result = await WorkflowEditor.AddProcessAsync(string.Empty);
            }

        private Task AddMerge()
            {
                isAddMergeOpen = true;

                StateHasChanged();

                return Task.CompletedTask;
            }

        private async Task AddFinish()
            {
                if (WorkflowEditor.SelectedNode == null)
                    return;

                if (WorkflowEditor.SelectedNode.Node.NodeType != 1 &&
                    WorkflowEditor.SelectedNode.Node.NodeType != 3)
                    return;

                await WorkflowEditor.AddFinishAsync();
            }

        private async Task OnAddTopPartDialogClosed(bool visible)
            {
                isAddTopPartOpen = visible;

                if (!visible)
                    {
                        if (WorkflowEditor.SelectedStructureItem == null)
                            {
                                StateHasChanged();
                                return;
                            }
                        await WorkflowEditor.ReloadAndRestoreSelectionAsync();

                        StateHasChanged();

                    }
            }
        
        private Task OnExplorerNodeClick(TechnologyExplorerItem item)
            {
                return Task.CompletedTask;
            }
        
private void SelectStructureNode(TechnologyStructureItem item)
    {
        WorkflowEditor.SelectStructureItem(item);

        StateHasChanged();
    }

private Task OnAddMergeDialogClosed(bool visible)
    {
        isAddMergeOpen = visible;

        StateHasChanged();

        return Task.CompletedTask;
    }


}
