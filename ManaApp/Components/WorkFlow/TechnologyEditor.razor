
@* Technology Editor.razor *@


@using ManaApp.Services.Workflow
@using ManaApp.Components.Workflow.Editors
@using ManaApp.Shared.DTOs.Workflow
@using ManaApp.ViewModels.Workflow
@inject TechnologyEditorService TechnologyEditorUi
@inject WorkflowEditorService WorkflowEditor

@namespace ManaApp.Components.Workflow

@if (Visible)
{
    <div class="technology-editor-overlay">

        <div class="technology-editor-window">

            <div class="technology-editor">

    <div class="technology-editor-header">

        <div class="editor-title">
            Tehnoloģijas redaktors
        </div>
 
        <div class="editor-right">

            <div class="editor-version @(WorkflowEditor.Workflow?.IsValid == false ? "workflow-invalid" : "")">
                @WorkflowEditor.Workflow?.Workflow?.Name 
            </div>

            <button class="btn btn-save">
                <i class="bi bi-floppy me-2"></i>
                <span>Saglabāt</span>
            </button>

            <button class="btn btn-close"
                @onclick="Close">
            <i class="bi bi-x-lg"></i>
        </button>

        </div>

    </div>

    <div class="technology-editor-toolbar">

        <div class="toolbar-left">

            <button class="toolbar-btn top-part"
                @onclick="AddTopPart"
                disabled="@(!WorkflowEditor.CanAddTopPart() || WorkflowEditor.IsEditorLocked)">
                <i class="bi bi-box"></i>
                <span>+ TOP PART</span>
            </button>

            <button class="toolbar-btn sub-part"
                @onclick="AddSubPart"
                disabled="@(!CanAddSubPart || WorkflowEditor.IsEditorLocked)">
                <i class="bi bi-box"></i>
                <span>+ SUB PART</span>
            </button>

            <button class="toolbar-btn process"
                @onclick="AddProcess"
                disabled="@(!WorkflowEditor.CanAddProcess())">
                <i class="bi bi-gear"></i>
                <span>+ PROCESS</span>
            </button>

            <button class="toolbar-btn merge"
                @onclick="AddMerge"
                disabled="@(!WorkflowEditor.CanAddMerge() || WorkflowEditor.IsEditorLocked)">
                <i class="bi bi-diagram-3"></i>
                <span>+ MERGE</span>
            </button>

            <button class="toolbar-btn finish"
                @onclick="AddFinish"
                disabled="@(!WorkflowEditor.CanAddFinish() || WorkflowEditor.IsEditorLocked)">
                <i class="bi bi-flag"></i>
                <span>+ FINISH</span>
                <i class="bi bi-caret-down-fill"></i>
            </button>

        </div>

        <div class="toolbar-center">

        </div>

        <div class="toolbar-right">

            <button class="toolbar-btn check">
                <i class="bi bi-check-circle"></i>
                <span>Pārbaudīt</span>
            </button>

        </div>

    </div>

    <div class="technology-editor-body">

        <aside class="technology-tree">

            <div class="technology-tree-header">

            <div class="tree-title">
                Ražošanas plūsmas
            </div>

            <div class="tree-header-actions">

                <div class="tree-search">

                    <i class="bi bi-search"></i>

                    <input type="text"
                        placeholder="Meklēt koku" />

                </div>

                <button class="tree-tool-btn">
                    <i class="bi bi-sliders"></i>
                </button>

            </div>

        </div>

            <div class="technology-tree-body">

                @if (!WorkflowEditor.IsLoaded)
                    {
                        <div>Ielādēju...</div>
                    }
                    else if (!WorkflowEditor.WorkflowExplorerItems.Any())
                    {
                        <div class="alert alert-warning m-3">
                            <i class="bi bi-exclamation-triangle me-2"></i>
                            Šai precei nav pievienota neviena pamatdetaļa. Vispirms pievieno detaļas preces tehnoloģijai.
                        </div>
                    }
                    else
                        {                           
                           <WorkflowExplorer
                                Items="WorkflowEditor.WorkflowExplorerItems"
                                OnSelected="@(item => SelectWorkflowExplorerNode(item))"
                                OnNodeSelected="@(node => SelectWorkflowExplorerNode(node))" />
                        }

            </div>

        </aside>

        <main class="technology-properties">

                <section class="selected-element">

    <div class="panel-title">
        Atlasītais elements
    </div>

    <div class="panel-body">

@if (WorkflowEditor.State.SelectedNode != null)
{
        <div class="selected-header">

            <div class="selected-icon">

                @switch (WorkflowEditor.State.SelectedNode?.Node?.NodeType)
                {
                    case 1:
                        <i class="bi bi-box text-primary"></i>
                        break;

                    case 2:
                        <i class="bi bi-gear text-success"></i>
                        break;

                    case 3:
                        <i class="bi bi-diagram-3 text-warning"></i>
                        break;

                    case 4:
                        <i class="bi bi-flag text-danger"></i>
                        break;
                }

            </div>
            

            <div class="selected-title">

                <div class="selected-type">
                    @WorkflowEditor.Workflow?.Workflow?.Name
                </div>

                <div class="selected-name">
                    @(WorkflowEditor.State.SelectedNode?.Node.Name ?? "")
                </div>

                <div class="selected-description">
                    @(WorkflowEditor.State.SelectedNode is null
                        ? "Nav atlasīts neviens elements"
                        : "")
                </div>

            </div>

            <div class="selected-badge node-type-@(WorkflowEditor.State.SelectedNode?.Node?.NodeType ?? 1)">
                @(WorkflowEditor.State.SelectedNode?.Node is null
                    ? "TOP PART"
                    : WorkflowEditor.NodeTypeName(WorkflowEditor.State.SelectedNode.Node.NodeType))
            </div>

            <button class="btn btn-outline-danger btn-delete-node">
                <i class="bi bi-trash"></i>
            </button>

        </div>

        <span class="@(SelectedNodeType == 1 ? "current" : "")">TOP PART</span>

        <i class="bi bi-chevron-right"></i>

        <span class="@(SelectedNodeType == 2 ? "current" : "")">PROCESS</span>

        <i class="bi bi-chevron-right"></i>

  <span class="@(SelectedNodeType == 4 ? "current" : "")">FINISH</span>

        @if (!string.IsNullOrWhiteSpace(WorkflowEditor.ValidationMessage))
        {
            <div class="alert alert-warning mt-3 mb-3">
                @WorkflowEditor.ValidationMessage
            </div>
        }

<div class="editor-content">


    <div class="editor-content-left">

        <CommonEditor
            WorkflowEditor="WorkflowEditor"
            OnProcessSaved="OnProcessSaved" />

    </div>

    <div class="editor-content-right">

        <section class="property-section">

<div class="type-properties">

    @if (WorkflowEditor.SelectedNode == null)
    {
        <div class="alert alert-info">
            Šim BOM elementam vēl nav izveidota tehnoloģija.
        </div>
    }
    else if (SelectedNodeType == 1)
    {
        <TopPartEditor WorkflowEditor="WorkflowEditor" />
    }
    else if (SelectedNodeType == 2)
    {
        <ProcessEditor
            WorkflowEditor="WorkflowEditor"
            OnProcessSaved="OnProcessSaved" />
    }
    else if (SelectedNodeType == 3)
    {
        <MergeEditor WorkflowEditor="WorkflowEditor" />
    }
    else if (SelectedNodeType == 4)
    {
        <FinishEditor WorkflowEditor="WorkflowEditor" />
    }

</div>

</section>

    </div>

</div>
}
        
    </div>

</section>

                <section class="element-information">

                    <div class="panel-title">
                        Elementa informācija
                    </div>

                    <div class="panel-body">

                    </div>

                </section>

                <section class="technology-legend">

                    <div class="panel-title">
                        Leģenda
                    </div>

                    <div class="panel-body">

                    </div>

                </section>

            </main>

    </div>

    <div class="technology-editor-footer">
        Footer
    </div>

</div>
</div>
</div>

}

<AddTopPartDialog
    VersionId="VersionId ?? 0"
    Visible="isAddTopPartOpen"
    VisibleChanged="OnAddTopPartDialogClosed"
    ParentProductTopPartId="isSubPartMode
            ? WorkflowEditor.GetCurrentFlowOwner()?.ProductToPartId
            : null"
    AttachToNodeId="WorkflowEditor.SelectedNode?.Node.Id"
    IsSubPart="isSubPartMode" />

<AddMergeDialog
    Visible="isAddMergeOpen"
    VisibleChanged="OnAddMergeDialogClosed" />

@code
{
    [Parameter]
    public bool Visible { get; set; }

    private bool isAddMergeOpen;

    [Parameter]
    public EventCallback<bool> VisibleChanged { get; set; }

    [Parameter]
    public int? VersionId { get; set; }
    private bool isAddTopPartOpen;
    private bool initialized;
    private List<WorkflowGraphItem> WorkflowGraphItems { get; set; } = new();
    private int? SelectedNodeType =>
            WorkflowEditor.State.SelectedNode?.Node.NodeType;
    private bool isSubPartMode;
    private bool CanAddSubPart =>
        WorkflowEditor.CanAddSubPart();
            
        protected override async Task OnParametersSetAsync()
        {
            if (initialized &&
                WorkflowEditor.Workflow?.Workflow?.VersionId == VersionId &&
                Visible)
                return;

            if (VersionId is null || VersionId <= 0)
                {
                    return;
                }

            try
                {
                    if (await WorkflowEditor.LoadAsync(VersionId.Value) == null)
                    {
                        return;
                    }
                }
            catch (Exception ex)
                {
                    Console.WriteLine(ex);
                    throw;
                }
            finally
                {
                    initialized = true;
                }
        }

        private async Task OnProcessSaved()
            {
                await InvokeAsync(StateHasChanged);
            }

        private async Task Close()
            {
                await VisibleChanged.InvokeAsync(false);
            }

        private async Task AddTopPart()
            {
                if (VersionId is null)
                    return;

                await WorkflowEditor.LoadAvailableTopPartsAsync(VersionId.Value);

                isSubPartMode = false;
                isAddTopPartOpen = true;
            
            }  
        
        @* private async Task AddSubPart()
            {
                Console.WriteLine("AddSubPart()");

                if (!WorkflowEditor.CanAddSubPart())
                    return;

                if (WorkflowEditor.GetCurrentTopPartName() == null)
                    return;

                await WorkflowEditor.LoadAvailableSubPartsAsync(VersionId!.Value);

                isSubPartMode = true;
                isAddTopPartOpen = true;

                await InvokeAsync(StateHasChanged);
            } *@

private async Task AddSubPart()
{
    Console.WriteLine("AddSubPart()");
    Console.WriteLine($"CanAddSubPart = {WorkflowEditor.CanAddSubPart()}");

    Console.WriteLine($"CurrentTopPart = {WorkflowEditor.GetCurrentTopPartName()}");

    try
    {
        if (!WorkflowEditor.CanAddSubPart())
            return;

        if (WorkflowEditor.GetCurrentTopPartName() == null)
            return;

        await WorkflowEditor.LoadAvailableSubPartsAsync(VersionId!.Value);

        Console.WriteLine("SubParts loaded");

        isSubPartMode = true;
        isAddTopPartOpen = true;

        Console.WriteLine("Dialog should open");
    }
    catch (Exception ex)
    {
        Console.WriteLine(ex);
    }

    StateHasChanged();
}


        private async Task AddProcess()
            {
                if (!WorkflowEditor.CanAddProcess())
                    return;
                
                if (WorkflowEditor.SelectedNode == null)
                    return;

                var newNode = await WorkflowEditor.AddProcessAsync(string.Empty);

                var mapper = new WorkflowGraphMapper(WorkflowEditor.State);

                WorkflowGraphItems = mapper.Map(
                    WorkflowEditor.State.Graph.Values);
                    
                WorkflowEditor.WorkflowGraphItems = WorkflowGraphItems;

                if (newNode != null)
                    {
                        WorkflowEditor.RestoreSelectedGraphNode(newNode.Id);
                    }

                StateHasChanged();
            }

        private Task AddMerge()
            {
                isAddMergeOpen = true;

                StateHasChanged();

                return Task.CompletedTask;
            }

        private async Task AddFinish()
            {
                if (WorkflowEditor.SelectedNode == null)
                    return;

                await WorkflowEditor.AddFinishAsync();

                var mapper = new WorkflowGraphMapper(
                    WorkflowEditor.State);

                WorkflowGraphItems = mapper.Map(
                    WorkflowEditor.State.Graph.Values);
                    
                WorkflowEditor.WorkflowGraphItems = WorkflowGraphItems;

                StateHasChanged();
            } 
         private async Task OnAddTopPartDialogClosed(bool visible)
                {
                    isAddTopPartOpen = visible;

                   await WorkflowEditor.ReloadAsync();

                    StateHasChanged();
                }
                
       private async Task SelectStructureNode(WorkflowGraphItem item)
            {
                ClearSelection(WorkflowGraphItems);
                    item.IsSelected = true;

                if (item.Node == null)
                    return;
                WorkflowEditor.SelectGraphItem(item);
                    await WorkflowEditor.LoadAvailableActionsAsync(item.Node.Id);

                StateHasChanged();
            }

        private void ClearSelection(IEnumerable<WorkflowGraphItem> items)
            {
                foreach (var node in items)
                {
                    node.IsSelected = false;

                    ClearSelection(node.Children);
                    ClearSelection(node.NextNodes);
                }
            }

private async Task OnAddMergeDialogClosed(bool visible)
    {
        isAddMergeOpen = visible;

        if (!visible)
            {
                await WorkflowEditor.ReloadAndRestoreSelectionAsync();

                var mapper = new WorkflowGraphMapper(WorkflowEditor.State);

                WorkflowGraphItems = mapper.Map(
                    WorkflowEditor.State.Graph.Values);

                WorkflowEditor.WorkflowGraphItems = WorkflowGraphItems;
            }

        StateHasChanged();

    }

    private async Task SelectWorkflowExplorerNode(
            WorkflowExplorerNodeDto node)
        {
            if (WorkflowEditor.State.SelectedWorkflowExplorerItem?.WorkflowNodeId == node.WorkflowNodeId)
            {
                WorkflowEditor.State.SelectedWorkflowExplorerItem = null;
                WorkflowEditor.State.SelectedNode = null;
                WorkflowEditor.State.AvailableActions = new WorkflowActionsDto();

                StateHasChanged();
                return;
            }

            WorkflowEditor.State.SelectedWorkflowExplorerItem = new WorkflowExplorerItemDto
                {
                    WorkflowNodeId = node.WorkflowNodeId
                };
            
            WorkflowEditor.TrySelectNode(node.WorkflowNodeId);

            await WorkflowEditor.LoadAvailableActionsAsync(node.WorkflowNodeId);

            StateHasChanged();
        }

    private async Task SelectWorkflowExplorerNode(WorkflowExplorerItemDto item)
        {
            if (WorkflowEditor.State.SelectedWorkflowExplorerItem?.WorkflowNodeId == item.WorkflowNodeId)
            {
                WorkflowEditor.State.SelectedWorkflowExplorerItem = null;
                WorkflowEditor.State.SelectedNode = null;
                WorkflowEditor.State.AvailableActions = new WorkflowActionsDto();

                StateHasChanged();
                return;
            }

            WorkflowEditor.State.SelectedWorkflowExplorerItem = item;

            WorkflowEditor.TrySelectNode(item.WorkflowNodeId);

            await WorkflowEditor.LoadAvailableActionsAsync(item.WorkflowNodeId);

            StateHasChanged();
        }

}
