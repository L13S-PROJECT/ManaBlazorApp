@foreach (var p in Parts)
{
    <div class="ptv2-tasks-row assembly">
        <!-- 1. Nosaukums -->
        <div class="ptv2-part-name" title="@p.TopPartName">
            <span class="ptv2-part-indicator state-@(
                AssemblyIndicators.TryGetValue(p.ProductToPartId, out var s)
                    ? s
                    : "gray"
            )"></span>

            @p.TopPartName
        </div>

        <!-- 2. Gatavs -->
        <div>
            <input type="checkbox"
                class="ptv2-switch"
                checked="@(AssemblyIndicators.ContainsKey(p.ProductToPartId) 
           && AssemblyIndicators[p.ProductToPartId] != "gray")"
                disabled />

        </div>


        <!-- 3. Apjoms -->
        <div>
            <span class="@(AssemblyIndicators.TryGetValue(p.ProductToPartId, out var st) && st != "gray"
                ? "ptv2-qty-active"
                : "ptv2-qty-inactive")">
                @(SelectedBatch!.Planned * p.Quantity)
            </span>

        </div>

        <!-- 4. Piešķirts -->
        <div></div>

        <!-- 5. Pieņēma -->
        <div></div>

        <!-- 6. Sākums -->
        <div></div>

        <!-- 7. Pabeigts -->
        <div></div>

        <!-- 8. Komentārs -->
        <div></div>

        <!-- 9. Done -->
        <div></div>
    </div>

@if (ReadyDetailParts.TryGetValue(p.ProductToPartId, out var list) && list.Any())
{
    <div class="ptv2-tasks-row assembly sub">
        
        <!-- 1. NOSAUKUMS -->
        <div style="padding-left:20px;">
            @foreach (var d in list)
            {
                <div style="margin-bottom:2px;
                            color:@(d.state == "done" ? "#111827" : "#9ca3af");">
                    @d.name (@d.qty)
                </div>
            }
        </div>

        <!-- pārējās kolonnas -->
        <div></div>
        <div></div>
        <div></div>
        <div></div>
        <div></div>
        <div></div>
        <div></div>
        <div></div>
    </div>
}

@foreach (var step in p.Steps)
{

@if (TasksByStep.TryGetValue(step.Id, out var tasks))
{
    @foreach (var t in tasks)
    {
        <div class="ptv2-tasks-row assembly sub task">
<div title="@step.StepName">
    @step.StepName
</div>

<div></div> <!-- Gatavs -->
<div></div> <!-- Apjoms -->

<!-- 4. Piešķirts -->
<div>
    @if (!AssemblyIndicators.TryGetValue(p.ProductToPartId, out var st2) || st2 != "green")
{
    <div class="assigned-readonly">
        @Employees.FirstOrDefault(e => e.Id == t.Assigned_To)?.Name
    </div>
}
else if (t.Status == 2 || t.Status == 3)
{
    <div class="assigned-readonly">
        @Employees.FirstOrDefault(e => e.Id == t.Assigned_To)?.Name
    </div>
}
else
{
    <select value="@t.Assigned_To"
            @onchange="e => OnAssignedChanged(t.TaskId, e)">
        <option value="">—</option>
        @foreach (var emp in Employees)
        {
            <option value="@emp.Id">@emp.Name</option>
        }
    </select>
}
</div>


<div>
    @Employees.FirstOrDefault(e => e.Id == t.Claimed_By)?.Name
</div>

                <!-- 6. Sākums -->
                    <div>
                        @(t.StartedAt.HasValue
                            ? t.StartedAt.Value.ToString("dd.MM.yyyy")
                            : "—")
                    </div>

                <!-- 7. Pabeigts -->
                    <div>
                        @(t.FinishedAt.HasValue
                            ? t.FinishedAt.Value.ToString("dd.MM.yyyy")
                            : "—")
                    </div>


<div class="ptv2-comment-wrap">
    <input
        type="text"
        class="ptv2-comment-input @(string.IsNullOrWhiteSpace(t.Comment) ? "empty" : "")"
        value="@(string.IsNullOrWhiteSpace(t.Comment) ? "(Pievienot komentāru)" : t.Comment)"
        readonly />
    <button
    type="button"
    class="ptv2-comment-edit"
    title="Labot komentāru"
    @onclick="() => OpenCommentEditor(t)"
    @onclick:stopPropagation="true">
    ✎
</button>

</div>

            <div class="ptv2-done-cell">
                 <div class="ptv2-done-cell" style="position:relative; z-index:5;">
            <input type="checkbox"
                class="ptv2-done-checkbox"
                style="position:relative; z-index:6;"
                title="Redzams darbiniekam"
                checked="@t.IsCommentForEmployee"
                @onchange="e => OnCommentVisibilityChanged(t, e)" />
</div>


            </div>

        </div>
            }
        }

    }

}

@if (IsCommentPopupOpen && EditingTask is not null)
{
    <div class="ptv2-popup-backdrop">
        <div class="ptv2-popup">
            <h4>Komentārs</h4>

            <textarea
                style="width:100%; height:80px;"
                @bind="EditingCommentText">
            </textarea>

            <div style="margin-top:8px; text-align:right;">
                <button @onclick="CancelComment">Atcelt</button>
                <button style="margin-left:6px;" @onclick="ConfirmComment">OK</button>
            </div>
        </div>
    </div>
}

@code {
[Parameter] public ProductBatchRow? SelectedBatch { get; set; }
[Parameter] public EventCallback OnDataChanged { get; set; }
private bool IsInlinePainting =>
    SelectedBatch?.ProductionModel == 1;
private List<DetailPartRow> Parts = new();
private Dictionary<int, string> DetailIndicatorsFromApi = new();
private Dictionary<int, List<DetailTaskRow>> TasksByStep = new();
private Dictionary<int, List<(string name, int qty, string state)>> ReadyDetailParts = new();
// key = TopPartStepId
private List<DetailPartRow> DetailParts = new();
private List<AssemblySummaryDto> AssemblySummary = new();
protected override async Task OnParametersSetAsync()
{
    Parts.Clear();
    TasksByStep.Clear();
    AssemblyIndicators.Clear();

    if (SelectedBatch?.VersionId is not int vid || vid <= 0)
        return;

    if (SelectedBatch?.BatchProductId is not int bpId || bpId <= 0)
        return;

    AssemblySummary =
    await Http.GetFromJsonAsync<List<AssemblySummaryDto>>(
        $"http://localhost:5270/api/tasks/assembly-summary?batchProductId={bpId}"
    ) ?? new();

    // 1) Parts (Assembly)
    var partsUrl =
        $"http://localhost:5270/api/products/details?versionId={vid}&stepType=2";

    DetailParts =
    await Http.GetFromJsonAsync<List<DetailPartRow>>(
        $"http://localhost:5270/api/products/details?versionId={vid}&stepType=1"
    ) ?? new();

    Parts =
        await Http.GetFromJsonAsync<List<DetailPartRow>>(partsUrl)
        ?? new();

    // 2) Indicators (kopīgi DETAIL + ASSEMBLY)
    var indicators =
    await Http.GetFromJsonAsync<List<AssemblyIndicatorRow>>(
        $"http://localhost:5270/api/tasks/assembly-indicators?batchProductId={bpId}"
    ) ?? new();


        AssemblyIndicators = indicators.ToDictionary(
            x => x.ProductToPartId,
            x => x.State
        );


    // 3) Tasks (Assembly)
    var tasksUrl =
        $"http://localhost:5270/api/tasks/by-batch" +
        $"?batchProductId={bpId}&stepType=2";

    var tasks =
        await Http.GetFromJsonAsync<List<DetailTaskRow>>(tasksUrl)
        ?? new();

    TasksByStep = tasks
        .GroupBy(t => t.TopPartStepId)
        .ToDictionary(g => g.Key, g => g.ToList());
    
    var qtyList = await Http.GetFromJsonAsync<List<DetailQtyRow>>(
    $"http://localhost:5270/api/batches/detail-qty?batchProductId={bpId}"
) ?? new();

        hasParent = qtyList.Any(x => x.ParentQty > 0);
        hasChild  = qtyList.Any(x => x.ChildQty > 0);
        isChildOnly =
            (!hasParent && hasChild)
            ||
            (
                SelectedBatch?.ProductToPartId != null
                && hasParent
                && hasChild
            );
        
    var detailIndicatorsApi =
    await Http.GetFromJsonAsync<List<AssemblyIndicatorRow>>(
        $"http://localhost:5270/api/tasks/detailed-indicators?batchProductId={bpId}"
    ) ?? new();

    DetailIndicatorsFromApi = DetailParts.ToDictionary(
    p => p.ProductToPartId,
    p => detailIndicatorsApi
            .FirstOrDefault(x => x.ProductToPartId == p.ProductToPartId)?.State
         ?? "gray"
);

var readyParts = await Http.GetFromJsonAsync<List<ReadyDetailDto>>(
    $"http://localhost:5270/api/tasks/ready-detail-parts?batchProductId={bpId}"
) ?? new();

ReadyDetailParts = readyParts
    .GroupBy(x => x.ProductToPartId)
    .ToDictionary(
        g => g.Key,
        g => g.Select(x => (x.Name, x.Qty, x.State)).ToList()
    );

}

private sealed class ReadyDetailDto
{
    public int ProductToPartId { get; set; }
    public string Name { get; set; } = "";
    public int Qty { get; set; }
    public string State { get; set; } = "";
}

private sealed class DetailQtyRow
{
    public int ProductToPartId { get; set; }
    public int? BatchProductId { get; set; }
    public int ParentQty { get; set; }
    public int ChildQty { get; set; }
}

private bool hasParent;
private bool hasChild;
private bool isChildOnly;


private sealed class DetailTaskRow
{
    public int TaskId { get; set; }
    public int Status { get; set; }
    public int? Assigned_To { get; set; }
    public int Done { get; set; }

    public int TopPartStepId { get; set; }

    public int? Claimed_By { get; set; }
    public DateTime? StartedAt { get; set; }
    public DateTime? FinishedAt { get; set; }
    public string? Comment { get; set; }
    public bool IsCommentForEmployee { get; set; }
}


private List<EmployeeRow> Employees = new();

protected override async Task OnInitializedAsync()
{
    Employees =
        await Http.GetFromJsonAsync<List<EmployeeRow>>(
            "http://localhost:5270/api/employees")
        ?? new();
}

public sealed class EmployeeRow
{
    public int Id { get; set; }
    public string Name { get; set; } = "";
}

async Task OnAssignedChanged(int taskId, ChangeEventArgs e)
{
    int? empId =
        int.TryParse(e.Value?.ToString(), out var v)
            ? v
            : (int?)null;

    await Http.PostAsJsonAsync(
        "http://localhost:5270/api/tasks/update-assignee",
        new
        {
            TaskId = taskId,
            Assigned_To = empId
        });
}

private bool IsCommentPopupOpen = false;
private DetailTaskRow? EditingTask;
private string EditingCommentText = "";

void OpenCommentEditor(DetailTaskRow task)
{
    EditingTask = task;
    EditingCommentText = task.Comment ?? "";
    IsCommentPopupOpen = true;
}

void CancelComment()
{
    IsCommentPopupOpen = false;
    EditingTask = null;
}

async Task ConfirmComment()
{
    if (EditingTask is not null)
    {
        await Http.PostAsJsonAsync(
            "http://localhost:5270/api/tasks/update-comment",
            new
            {
                TaskId = EditingTask.TaskId,
                Comment = EditingCommentText,
                IsForEmployee = true
            });

        EditingTask.Comment = EditingCommentText;
    }

    IsCommentPopupOpen = false;
    EditingTask = null;

    await OnDataChanged.InvokeAsync();
}
private Dictionary<int, string> AssemblyIndicators = new();

private sealed class AssemblyIndicatorRow
{
    public int ProductToPartId { get; set; }
    public string State { get; set; } = "";
}

async Task OnCommentVisibilityChanged(DetailTaskRow task, ChangeEventArgs e)
{
    var isChecked = (bool)e.Value!;

    await Http.PostAsJsonAsync(
        "http://localhost:5270/api/tasks/update-comment-visibility",
        new
        {
            TaskId = task.TaskId,
            IsCommentForEmployee = isChecked
        });

    task.IsCommentForEmployee = isChecked; // UI sync
}

private bool ShowAssemblySummary =>
    SelectedBatch?.ProductionModel != 1;


}
