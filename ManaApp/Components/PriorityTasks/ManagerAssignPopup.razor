@inject HttpClient Http
@namespace ManaApp.Components.PriorityTasks

<div class="popup-overlay">
    <div class="popup-box">

        <div class="elp-header">
            <div class="elp-title">
                Darbu sadale
            </div>

            <button class="elp-close" @onclick="Close">
                X
            </button>
        </div>

        <div class="elp-content">
            Šeit būs jaunais Workcenter sadalījums
        </div>

        <div class="elp-footer">
            <button class="btn btn-secondary" @onclick="Close">
                Aizvērt
            </button>
        </div>

    </div>
</div>

@code {

    [Parameter] public EventCallback OnClose { get; set; }

    private async Task Close()
    {
        await OnClose.InvokeAsync();
    }

}