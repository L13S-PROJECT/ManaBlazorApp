@if (detailsBatchProductId != null && detailsProductToPartId != null)
{
    <StepDetailsPopup 
        BatchProductId="detailsBatchProductId.Value"
        ProductToPartId="detailsProductToPartId.Value"
        HighlightTaskId="selectedTaskId ?? 0"
        OnClose="CloseDetails" />
}

@code {
    [Parameter] public int EmployeeId { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }        
    private EmployeeLoadModel? model;
    private List<EmployeeDto> employees = new();
    private List<string> allWorkCenters = new();
    private int? detailsBatchProductId;
    private int? detailsProductToPartId;
    private int? selectedTaskId;


    private async Task Close()
    {
        await OnClose.InvokeAsync();
    }
    protected override async Task OnParametersSetAsync()
{

    if (employees.Count == 0)
    {
        employees = await Http.GetFromJsonAsync<List<EmployeeDto>>("api/employees")
                    ?? new List<EmployeeDto>();
    }

var data = await Http.GetFromJsonAsync<List<UnassignedTaskV2Dto>>("/api/tasks/unassigned-v2")
           ?? new List<UnassignedTaskV2Dto>();

model = new EmployeeLoadModel
{
    Priority = data,
    Normal = new List<UnassignedTaskV2Dto>()
};

var allTasks = (model?.Priority ?? new List<UnassignedTaskV2Dto>())
    .Concat(model?.Normal ?? new List<UnassignedTaskV2Dto>())
    .ToList();

var groups = allTasks.GroupBy(x => x.RootId);

foreach (var g in groups)
{
    var hasParent = g.Any(x => x.BatchProductId == x.RootId);
    var hasChild = g.Any(x => x.BatchProductId != x.RootId);

    foreach (var item in g)
    {
        var isSingleChildGroup = !hasParent && hasChild;

        item.RowType = item.RowType ?? "";

        // ✔ tikai UI marķējums
        if (isSingleChildGroup)
        {
            item.RowType = "SingleChild";
        }
    }
}

if (allWorkCenters.Count == 0)
{
    allWorkCenters = await Http.GetFromJsonAsync<List<string>>("api/tasks/workcenters")
                        ?? new List<string>();
}
}

private class EmployeeLoadModel
{
    public string? EmployeeName { get; set; }
    public string? WorkCenterName { get; set; }

    public List<UnassignedTaskV2Dto>? InProgress { get; set; }
    public List<UnassignedTaskV2Dto>? Priority { get; set; }
    public List<UnassignedTaskV2Dto>? Normal { get; set; }
}

private class TaskRow
{
    public string? WorkCenter { get; set; }
    public int? WorkCenterSort { get; set; }
    public int TaskId { get; set; }
    public string? BatchCode { get; set; }
    public int BatchProductId { get; set; }
    public int ProductToPartId { get; set; }
    public int TopPartStepId { get; set; }
    public string? ProductName { get; set; }
    public string? TopPartName { get; set; }
    public string? StepName { get; set; }

    public int Qty { get; set; }
    public int EstimatedMinutes { get; set; }
    public int Status { get; set; }
    public bool? CanStart { get; set; }
    public string? RowType { get; set; }
    public int? Assigned_To { get; set; }
    public bool BatchPriority { get; set; }
    public bool Tasks_Priority { get; set; }
    public bool Tasks_Push { get; set; }
    public int StepOrder { get; set; }
    public int RootId { get; set; }
    
}

private class UnassignedTaskV2Dto
{
    public string? WorkCenter { get; set; }
    public int? WorkCenterSort { get; set; }
    public int TopPartStepId { get; set; }
    public int TaskId { get; set; }
    public int RootId { get; set; }

    public int BatchProductId { get; set; }
    public int ProductToPartId { get; set; }

    public string? BatchCode { get; set; }
    public string? ProductName { get; set; }
    public string? TopPartName { get; set; }
    public string? StepName { get; set; }

    public int Qty { get; set; }
    public string? QtyBreakdown { get; set; }
    public int EstimatedMinutes { get; set; }

    public int Status { get; set; }
    public bool CanStart { get; set; }

    public int? Assigned_To { get; set; }

    public bool BatchPriority { get; set; }
    public bool Tasks_Priority { get; set; }
    public bool Tasks_Push { get; set; }

    public int StepOrder { get; set; }

    public string RowType { get; set; } = "";
}

private class EmployeeDto
{
    public int Id { get; set; }
    public string? Name { get; set; }
}

private IEnumerable<UnassignedTaskV2Dto> AllTasks =>
    (model?.Priority ?? Enumerable.Empty<UnassignedTaskV2Dto>())
    .Concat(model?.Normal ?? Enumerable.Empty<UnassignedTaskV2Dto>());

private IEnumerable<string> WorkCenters => allWorkCenters;

private async Task OnAssigneeChanged(UnassignedTaskV2Dto t, ChangeEventArgs e)
{
    var val = e.Value?.ToString();
int parsed = 0;

if (!string.IsNullOrWhiteSpace(val))
    int.TryParse(val, out parsed);

int? empId = parsed == 0 ? null : parsed;

Console.WriteLine($"SEND -> BP:{t.BatchProductId} STEP:{t.TopPartStepId} PART:{t.ProductToPartId} EMP:{empId}");

var response = await Http.PostAsJsonAsync("api/tasks/update-assignee-aggregated", new
{
    BatchProductId = t.RootId,
    TopPartStepId = t.TopPartStepId,
    ProductToPartId = t.ProductToPartId,
    RowType = t.RowType,   
    Assigned_To = empId
});

if (!response.IsSuccessStatusCode)
{
    var err = await response.Content.ReadAsStringAsync();
    Console.WriteLine(err);
    return;
}

var data = await Http.GetFromJsonAsync<List<UnassignedTaskV2Dto>>("/api/tasks/unassigned-v2")
           ?? new List<UnassignedTaskV2Dto>();

model = new EmployeeLoadModel
{
    Priority = data,
    Normal = new List<UnassignedTaskV2Dto>()
};

model.Priority = model.Priority
    ?.Where(x => x.Assigned_To == null)
    .ToList();

StateHasChanged();
}

private async Task OnPriorityChanged(UnassignedTaskV2Dto t, ChangeEventArgs e)
{
    var isChecked = e?.Value is bool b && b;

    t.Tasks_Priority = isChecked;

    await Http.PostAsJsonAsync("api/tasks/set-part-priority", new
    {
        BatchProductId = t.RootId,
        ProductToPartId = t.ProductToPartId,
        Tasks_Priority = isChecked
    });

var data = await Http.GetFromJsonAsync<List<UnassignedTaskV2Dto>>("/api/tasks/unassigned-v2")
           ?? new List<UnassignedTaskV2Dto>();

model = new EmployeeLoadModel
{
    Priority = data,
    Normal = new List<UnassignedTaskV2Dto>()
};

}

private async Task TogglePush(UnassignedTaskV2Dto t)
{
    var newValue = !t.Tasks_Push;

    await Http.PostAsJsonAsync("api/tasks/set-task-push", new
        {
            BatchProductId = t.RootId,  
            ProductToPartId = t.ProductToPartId,
            Tasks_Push = newValue
        });

    t.Tasks_Push = newValue;
var data = await Http.GetFromJsonAsync<List<UnassignedTaskV2Dto>>("/api/tasks/unassigned-v2")
           ?? new List<UnassignedTaskV2Dto>();

model = new EmployeeLoadModel
{
    Priority = data,
    Normal = new List<UnassignedTaskV2Dto>()
};
}

private void OpenTaskDetails(UnassignedTaskV2Dto t)
{
    detailsBatchProductId = t.RootId;
    detailsProductToPartId = t.ProductToPartId;
    selectedTaskId = t.TaskId;
}

private void CloseDetails()
{
    detailsBatchProductId = null;
    detailsProductToPartId = null;
    selectedTaskId = null;
}

private string FormatTime(int minutes)
{
    if (minutes <= 0)
        return "0";

    var days = minutes / 480;
    minutes %= 480;

    var hours = minutes / 60;
    minutes %= 60;

    var parts = new List<string>();

    if (days > 0)
        parts.Add($"{days} d");

    if (hours > 0)
        parts.Add($"{hours} h");

    if (minutes > 0)
        parts.Add($"{minutes} m");

    return string.Join(" ", parts);
}

