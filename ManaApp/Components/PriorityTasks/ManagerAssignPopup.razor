<div class="elp-content">

@foreach (var wc in WorkCenters)
{
    var tasks = AllTasks
    .Where(t => (t.WorkCenter ?? "") == wc)
    .ToList();

    var mergedTasks = tasks
    .GroupBy(x => new { x.RootId, x.ProductToPartId, x.StepName })
    .Select(g =>
    {
        if (g.Count() == 1)
{
    var single = g.First();

    return single;
}

        var first = g.First();

        first.QtyBreakdown = string.Join("+", g.Select(x => x.Qty));
        first.Qty = g.Sum(x => x.Qty);
        first.EstimatedMinutes = g.Sum(x => x.EstimatedMinutes);
        first.RowType = "ParentChildMerged";

        first.CanStart = g.All(x => x.CanStart == true);

        return first;
    })
    .ToList();

tasks = mergedTasks;

foreach (var t in tasks)
{
    Console.WriteLine(
        $"DEBUG: Batch={t.BatchCode} Root={t.RootId} BP={t.BatchProductId} RowType={t.RowType}"
    );
}

    var pushTasks = tasks.Where(t => t.Tasks_Push).ToList();

    var superPriorityTasks = tasks
        .Where(t => !t.Tasks_Push && t.BatchPriority && t.Tasks_Priority)
        .ToList();

    var priorityTasks = tasks
        .Where(t => !t.Tasks_Push && t.BatchPriority && !t.Tasks_Priority)
        .ToList();

    var superOrdinaryTasks = tasks
        .Where(t => !t.Tasks_Push && !t.BatchPriority && t.Tasks_Priority)
        .ToList();

    var ordinaryTasks = tasks
        .Where(t => !t.Tasks_Push && !t.BatchPriority && !t.Tasks_Priority)
        .ToList(); 

