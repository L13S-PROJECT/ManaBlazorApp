private async Task OnPartPriorityChanged(TaskRow t, ChangeEventArgs e)
{
    var isChecked = e?.Value is bool b && b;

    await Http.PostAsJsonAsync("api/tasks/set-part-priority", new
    {
        BatchProductId = t.BatchProductId,
        ProductToPartId = t.ProductToPartId,
        Tasks_Priority = isChecked
    });

    // lokāli uzreiz atjaunojam visus šīs detaļas status=1 taskus,
    // lai UI uzreiz redz izmaiņu
    if (model?.Priority != null)
    {
        foreach (var x in model.Priority
            .Where(x => x.BatchProductId == t.BatchProductId
                     && x.ProductToPartId == t.ProductToPartId
                     && x.Status == 1))
        {
            x.Tasks_Priority = isChecked;
        }
    }

    if (model?.Normal != null)
    {
        foreach (var x in model.Normal
            .Where(x => x.BatchProductId == t.BatchProductId
                     && x.ProductToPartId == t.ProductToPartId
                     && x.Status == 1))
        {
            x.Tasks_Priority = isChecked;
        }
    }

    StateHasChanged();
    
}

private async Task TogglePush(TaskRow t)
{
    var newValue = !t.Tasks_Push;

    await Http.PostAsJsonAsync("api/tasks/set-task-push", new
    {
        TaskId = t.TaskId,
        Tasks_Push = newValue
    });

    t.Tasks_Push = newValue;

    StateHasChanged();
  
}

private string FormatTime(int minutes)
{
    if (minutes <= 0)
        return "0";

    var days = minutes / 480;
    minutes %= 480;

    var hours = minutes / 60;
    minutes %= 60;

    var parts = new List<string>();

    if (days > 0)
        parts.Add($"{days} d");

    if (hours > 0)
        parts.Add($"{hours} h");

    if (minutes > 0)
        parts.Add($"{minutes} m");

    return string.Join(" ", parts);
}

private async Task OnAssigneeChanged(TaskRow t, ChangeEventArgs e)
{
    var raw = e?.Value?.ToString();
    int parsed = 0;

    if (!string.IsNullOrWhiteSpace(raw))
        int.TryParse(raw, out parsed);

    t.Assigned_To = parsed == 0 ? null : parsed;

await JS.InvokeVoidAsync("console.log", new {
    t.BatchProductId,
    t.TopPartStepId,
    t.ProductToPartId,
    t.Assigned_To
});

var payload = new
{
    BatchProductId = t.BatchProductId,
    TopPartStepId = t.TopPartStepId,
    ProductToPartId = t.ProductToPartId,
    RowType = t.RowType, 
    Assigned_To = t.Assigned_To
};

await JS.InvokeVoidAsync("console.log", payload);

var response = await Http.PostAsJsonAsync("api/tasks/update-assignee-aggregated", payload);

    if (!response.IsSuccessStatusCode)
{
    var err = await response.Content.ReadAsStringAsync();
    await JS.InvokeVoidAsync("console.error", err);
    return;
}

    StateHasChanged();
}


