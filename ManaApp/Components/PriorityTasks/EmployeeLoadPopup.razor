@if (detailsBatchProductId != null && detailsProductToPartId != null)
{
    <StepDetailsPopup 
    BatchProductId="detailsBatchProductId.Value"
    ProductToPartId="detailsProductToPartId.Value"
    HighlightTaskId="selectedTaskId ?? 0"
    OnClose="CloseDetails" />
}

@if (showSavedPopup)
{
    <div class="popup-overlay">
        <div class="popup-box" style="width:300px;text-align:center;">
            <div style="padding:20px;">
                Dati atjaunoti.
            </div>

            <button class="btn btn-primary"
                    @onclick="() => showSavedPopup = false">
                OK
            </button>
        </div>
    </div>
}

@code {
    private bool showSavedPopup = false;
    [Parameter] public int EmployeeId { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    
    private int? detailsBatchProductId;
    private int? detailsProductToPartId;
    private EmployeeLoadModel? model;
    private List<EmployeeDto> employees = new();
    private int? selectedTaskId;
    private List<StepDetailRow>? detailSteps;

protected override async Task OnParametersSetAsync()
{   

    if (employees.Count == 0)
        {
            employees = await Http.GetFromJsonAsync<List<EmployeeDto>>("api/employees")
                        ?? new List<EmployeeDto>();
        }
    
    if (EmployeeId > 0)
        {
            model = await Http.GetFromJsonAsync<EmployeeLoadModel>(
                $"api/tasks/employee-load-v2?empId={EmployeeId}");
        }
    else
        {
            model = await Http.GetFromJsonAsync<EmployeeLoadModel>(
                $"api/tasks/employee-load-v2?empId=0");
        }
    
var allTasks = (model?.InProgress ?? new List<TaskRow>())
    .Concat(model?.Priority ?? new List<TaskRow>())
    .Concat(model?.Normal ?? new List<TaskRow>())
    .ToList();

foreach (var t in allTasks)
{
    if (t.BatchProductId == 0 || t.ProductToPartId == 0)
    {
        await JS.InvokeVoidAsync("console.warn", t);
    }
}

var groups = allTasks.GroupBy(x => x.RootId);

foreach (var g in groups)
{
    var hasParent = g.Any(x => x.BatchProductId == x.RootId);
    var hasChild = g.Any(x => x.BatchProductId != x.RootId);

    foreach (var item in g)
    {
        item.IsChild = item.BatchProductId != item.RootId;
        item.HasParent = hasParent && hasChild;
        var isSingleChildGroup = !hasParent && hasChild;
        item.ShowChildMark = item.RowType == "SingleChild";  
    }
}
}

private async Task ReloadData()
{
    await UpdateData();   // saglabā DB

    if (EmployeeId > 0)
    {
        model = await Http.GetFromJsonAsync<EmployeeLoadModel>(
            $"api/tasks/employee-load-v2?empId={EmployeeId}");
    }
    else
    {
        model = await Http.GetFromJsonAsync<EmployeeLoadModel>(
            $"api/tasks/employee-load-v2?empId=0");
    }

showSavedPopup = true;

    StateHasChanged();
    
}

    private async Task Close()
    {
        await OnClose.InvokeAsync();
    }

private void OpenTaskDetails(TaskRow t)
{
    detailsBatchProductId = t.BatchProductId;
    detailsProductToPartId = t.ProductToPartId;
    selectedTaskId = t.TaskId;
}

private async Task UpdateData()
{
    var list = new List<object>();

    // Push tasks arī jānosūta
    foreach (var t in PushTasks)
    {
        list.Add(new
        {
            TaskId = t.TaskId,
            Tasks_Priority = t.Tasks_Priority,
            Tasks_Push = t.Tasks_Push,
            Assigned_To = t.Assigned_To
        });
    }

    if (model?.Priority != null)
    {
        foreach (var t in model.Priority)
        {
            list.Add(new
            {
                TaskId = t.TaskId,
                Tasks_Priority = t.Tasks_Priority,
                Tasks_Push = t.Tasks_Push,
                Assigned_To = t.Assigned_To
            });
        }
    }

    if (model?.Normal != null)
    {
        foreach (var t in model.Normal)
        {
            list.Add(new
            {
                TaskId = t.TaskId,
                Tasks_Priority = t.Tasks_Priority,
                Tasks_Push = t.Tasks_Push,
                Assigned_To = t.Assigned_To
            });
        }
    }

    await JS.InvokeVoidAsync("console.log", list);

    var response = await Http.PostAsJsonAsync("api/tasks/update-steps", list);

    response.EnsureSuccessStatusCode();
}

private void CloseDetails()
{
    detailsBatchProductId = null;
    detailsProductToPartId = null;
}
    private class EmployeeLoadModel
{
    public string? EmployeeName { get; set; }
    public string? WorkCenterName { get; set; }

    public List<TaskRow>? InProgress { get; set; }
