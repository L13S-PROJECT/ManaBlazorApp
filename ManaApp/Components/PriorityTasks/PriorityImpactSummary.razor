@using System.Linq
@using System.Text.Json.Serialization
@inject HttpClient Http
@namespace ManaApp.Components.PriorityTasks


@if (rows == null)
{
    <div>Ielādē...</div>
}
else
{
    
        var employees = rows
            .Select(r => r.EmployeeName)
            .Distinct()
            .OrderBy(e => e)
            .ToList();

        var workCenters = rows
            .GroupBy(r => r.WorkCenter)
            .Select(g => new { Name = g.Key, Sort = g.Min(x => x.SortStepType) })
            .OrderBy(x => x.Sort)
            .ThenBy(x => x.Name)
            .Select(x => x.Name)
            .ToList();
    
<div class="priority-impact-box">

<div class="impact-columns-header">
<div class="impact-row"
     style="--emp-count:@employees.Count">

    <div class="impact-cell"><strong>Workcentrs</strong></div>
    <div class="impact-cell"><strong>Var sākt</strong></div>
    <div class="impact-cell"><strong>Kopā</strong></div>

    @foreach (var emp in employees)
    {
        <div class="impact-cell">
            <span style="cursor:pointer"
                  @onclick="() => OpenPopup(emp)">
                <strong>@emp</strong>
            </span>
        </div>
    }

</div>
</div>

<div class="impact-row" style="--emp-count:@employees.Count">

    <div class="impact-cell"><strong>Var sākt</strong></div>

    <div class="impact-cell"></div>
    <div class="impact-cell"></div>

    @foreach (var emp in employees)
    {
        var sum = rows
            .Where(r => r.EmployeeName == emp)
            .Sum(r => r.CanStartCount);

        <div class="impact-cell">
            <strong>@sum</strong>
        </div>
    }

</div>

    <div class="impact-section">
    <div class="impact-section-header">
        Prioritārie darbi
    </div>

    <div class="impact-rows"
     style="--emp-count:@employees.Count">

@foreach (var wc in workCenters)
{
        var wcCanStart = rows
            .Where(r => r.WorkCenter == wc)
            .Sum(r => r.CanStartCount);

                <div class="impact-row">
                    <div class="impact-cell impact-wc">
                        <strong>@wc</strong>
                    </div>

                <div class="impact-cell">
                    <strong>@wcCanStart</strong>
                </div>

                <div class="impact-cell">
                    <strong>
                        @rows.Where(r => r.WorkCenter == wc).Sum(r => r.PriorityCount)
                    </strong>
                </div>

                    @foreach (var emp in employees)
                    {
                        var match = rows.FirstOrDefault(r =>
                            r.WorkCenter == wc &&
                            r.EmployeeName == emp);

                        <div class="impact-cell">
                            @(match?.PriorityCount ?? 0)
                        </div>
                        
                    }
                </div>
            }
    </div>
</div>

    <div class="impact-section">
        <div class="impact-section-header">
            Parastie darbi
    </div>

    <div class="impact-rows"
     style="--emp-count:@employees.Count">

    @foreach (var wc in workCenters)
    {
        <div class="impact-row">
            <div class="impact-cell impact-wc">
                <strong>@wc</strong>
        </div>
        <div class="impact-cell">
        <strong>
        @rows.Where(r => r.WorkCenter == wc).Sum(r => r.NormalCanStartCount)
        </strong>
</div>

        <div class="impact-cell">
            <strong>
                @rows.Where(r => r.WorkCenter == wc).Sum(r => r.NormalCount)
            </strong>
        </div>
            @foreach (var emp in employees)
            {
                var match = rows.FirstOrDefault(r =>
                    r.WorkCenter == wc &&
                    r.EmployeeName == emp);

                <div class="impact-cell">
                    @(match?.NormalCount ?? 0)
                </div>
            }
        </div>
    }
</div>
    </div>
</div>
}

@if (selectedEmployeeId != null)
{
    <EmployeeLoadPopup EmployeeId="selectedEmployeeId.Value"
                       OnClose="ClosePopup" />
}

@code {

    private List<PriorityImpactRow>? rows;

    private class PriorityImpactRow
    {
        public string WorkCenter { get; set; } = "";
        public string EmployeeName { get; set; } = "";
        public int PriorityCount { get; set; }
        public int NormalCount { get; set; }
        public int EmployeeId { get; set; }
        public int SortStepType { get; set; }
        public int CanStartCount { get; set; }
        public int PriorityCanStartCount { get; set; }
        public int NormalCanStartCount { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        rows = await Http.GetFromJsonAsync<List<PriorityImpactRow>>(
            "http://localhost:5270/api/production-priorities/impact");
    }

    public async Task Reload()
    {
        rows = await Http.GetFromJsonAsync<List<PriorityImpactRow>>(
            "http://localhost:5270/api/production-priorities/impact");

        StateHasChanged();
    }

    private int? selectedEmployeeId;

private void OpenPopup(string employeeName)
{
    var match = rows?.FirstOrDefault(r => r.EmployeeName == employeeName);
    if (match != null)
        selectedEmployeeId = match.EmployeeId;
}

private async Task ClosePopup()
{
    selectedEmployeeId = null;
    await Reload();
}
}
