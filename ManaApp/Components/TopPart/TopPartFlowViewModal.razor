@* TopPartFlowViewModal.razor *@

@using ManaApp.Shared.DTOs.TopPart
@using ManaApp.Services
@inject TopPartWorkflowService TopPartWorkflowService

<div class="modal-backdrop">
    <div class="modal-content">

        <div class="flow-view-modal-header">
            <h3>Flow apskate</h3>

            <button type="button"
                    class="flow-view-close"
                    title="Aizvērt"
                    aria-label="Aizvērt"
                    @onclick="Close">
                ✕
            </button>
        </div>


        @if (workflow is null)
            {
                <div>Ielādē...</div>
            }
        else
            {
                <div class="flow-view-header">

                    @if (workflowHistory.Count > 0)
                    {
                        <button type="button"
                                class="flow-view-back"
                                @onclick="GoBack">
                            ← Atpakaļ
                        </button>
                    }

                    <div class="flow-view-breadcrumb">

                        @for (var i = 0; i < workflowPath.Count; i++)
                        {
                            var item = workflowPath[i];

                            @if (i > 0)
                            {
                                <span class="flow-view-breadcrumb-separator">›</span>
                            }

                            <span class="@(i == 0
                                ? "flow-view-breadcrumb-root"
                                : i == workflowPath.Count - 1
                                    ? "flow-view-breadcrumb-current"
                                    : "flow-view-breadcrumb-item")">

                                @item.Name

                                @if (i == workflowPath.Count - 1 && item.TopPartId.HasValue)
                                {
                                    <button type="button"
                                            class="flow-view-open"
                                            @onclick="OpenTopPart">
                                        Atvērt
                                    </button>
                                }

                            </span>
                        }

                    </div>

                </div>

                <TopPartFlowGraph
                    Workflow="workflow"
                    WorkflowId="WorkflowId"
                    Bom="bom"
                    ReadOnly="true"
                    OnWorkflowOpenRequested="OpenWorkflow" />

            }

    </div>
</div>

@code {
    [Parameter]
    public int WorkflowId { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    [Parameter]
    public EventCallback<uint> OnTopPartOpenRequested { get; set; }

    private Task Close()
        {
            return OnClose.InvokeAsync();
        }

    private async Task OpenTopPart()
        {
            var current = workflowPath.LastOrDefault();

            if (current?.TopPartId is null)
                return;

            await OnTopPartOpenRequested.InvokeAsync(current.TopPartId.Value);
            await OnClose.InvokeAsync();
        }

    private async Task OpenWorkflow((int WorkflowId, uint? TopPartId) request)
        {
            workflowHistory.Push(workflow!.Workflow.Id);

            workflow = await TopPartWorkflowService.GetWorkflowAsync(request.WorkflowId);
            bom = await TopPartWorkflowService.GetBomAsync(request.WorkflowId);

            if (workflow is not null)
            {
                workflowPath.Add(new WorkflowNavigationItem
                {
                    WorkflowId = workflow.Workflow.Id,
                    TopPartId = request.TopPartId,
                    Name = workflow.Workflow.Name ?? string.Empty
                });
            }
        }

    private readonly Stack<int> workflowHistory = new();

    private TopPartWorkflowDto? workflow;
    private List<TopPartWorkflowBomDto> bom = new();

    protected override async Task OnParametersSetAsync()
        {
            workflow = await TopPartWorkflowService.GetWorkflowAsync(WorkflowId);
            bom = await TopPartWorkflowService.GetBomAsync(WorkflowId);

            workflowPath.Clear();

            if (workflow is not null)
            {
                workflowPath.Add(new WorkflowNavigationItem
                {
                    WorkflowId = workflow.Workflow.Id,
                    Name = workflow.Workflow.Name ?? string.Empty
                });
            }
        }
    private async Task GoBack()
            {
                if (workflowHistory.Count == 0)
                    return;

                var workflowId = workflowHistory.Pop();

                workflow = await TopPartWorkflowService.GetWorkflowAsync(workflowId);
                bom = await TopPartWorkflowService.GetBomAsync(workflowId);

                if (workflowPath.Count > 1)
                {
                    workflowPath.RemoveAt(workflowPath.Count - 1);
                }
            }

    private class WorkflowNavigationItem
        {
            public int WorkflowId { get; set; }
            public string Name { get; set; } = string.Empty;
            public uint? TopPartId { get; set; }
        }

    private readonly List<WorkflowNavigationItem> workflowPath = new();

}