@* TopPartFlow.razor *@

@using ManaApp.Shared.DTOs.TopPart
@using ManaApp.Services
@inject TopPartWorkflowService TopPartWorkflowService


<div class="toppart-flow">

    @if (TopPart is null)
    {
        <div class="toppart-flow-empty">
            Izvēlies TopPart, lai apskatītu Flow.
        </div>
    }
    else if (workflow is null)
    {
        <div class="toppart-flow-empty">
            Šim TopPart nav aktīva Flow.
        </div>
    }
    else
    {
        <div class="toppart-flow-versions">

            @if (!versions.Any(x => x.Status == 1))
                        {
                            var currentVersion = versions.FirstOrDefault(x => x.IsCurrent);

                            if (currentVersion is not null)
                            {
                                <div class="toppart-flow-header">
                                    <button type="button"
                                            @onclick="EditFlow">
                                        Labot V@(currentVersion.WorkflowVersion)
                                    </button>
                                </div>
                            }
                        }

                @foreach (var version in versions)
                {
                    <div class="toppart-flow-version-row">

                        <div class="toppart-flow-version-number">
                            V@(version.WorkflowVersion)
                        </div>

                        <div class="toppart-flow-version-status">
                            @(version.Status == 1 ? "Melnraksts" : "Released")
                        </div>

                        <div class="toppart-flow-version-date">
                            Datums
                        </div>

                        <div class="toppart-flow-version-current">
                            @if (version.Status == 1)
                            {
                                <span class="toppart-flow-draft-warning">⚠</span>
                            }
                            else if (version.IsCurrent)
                            {
                                <span>Aktuālā</span>
                            }
                        </div>

                        <div class="toppart-flow-version-actions">
                            @if (version.Status == 1)
                            {
                                <button type="button"
                                        @onclick="() => OnEditRequested.InvokeAsync(version.Id)">
                                    Labot
                                </button>
                            }
                            else
                            {
                                <button type="button"
                                        @onclick="() => SelectVersion(version.Id)">
                                    Apskatīt
                                </button>
                            }
                        </div>

                    </div>
                }
            </div>
        
        }

</div>

@if (showVersionDetails && selectedVersionId.HasValue)
{
    <TopPartFlowViewModal
            WorkflowId="selectedVersionId.Value"
            OnClose="CloseVersionDetails"
            OnTopPartOpenRequested="OnTopPartOpenRequested" />
}

@code {
    [Parameter]
    public TopPartListItemDto? TopPart { get; set; }

    private TopPartWorkflowDto? workflow;
    private List<TopPartWorkflowVersionDto> versions = new();
    private bool showVersions;

    private int? selectedVersionId;
    private bool showVersionDetails;

    private int? loadedTopPartId;

    [Parameter]
    public EventCallback OnFlowChanged { get; set; }

    [Parameter]
    public EventCallback<int> OnEditRequested { get; set; }

    [Parameter]
    public EventCallback<uint> OnTopPartOpenRequested { get; set; }

    protected override async Task OnParametersSetAsync()
{
    
    if (TopPart is null)
    {
        loadedTopPartId = null;
        workflow = null;
        return;
    }

    var topPartId = TopPart.Id;

    if (loadedTopPartId == topPartId)
        return;

    loadedTopPartId = topPartId;
    workflow = null;

    versions = await TopPartWorkflowService.GetVersionsAsync(topPartId);

    var workflowId =
        await TopPartWorkflowService.GetDisplayWorkflowIdAsync(topPartId);


    if (workflowId.HasValue)
    {
        workflow =
            await TopPartWorkflowService.GetWorkflowAsync(workflowId.Value);
    }
}

    public async Task ReloadAsync()
        {
            loadedTopPartId = null;
            await OnParametersSetAsync();
            StateHasChanged();
        }

    private async Task EditFlow()
        {
            if (workflow is null)
                return;

            var draftWorkflowId = await TopPartWorkflowService.EditAsync(
                workflow.Workflow.Id);

            if (!draftWorkflowId.HasValue)
                return;

            await OnEditRequested.InvokeAsync(draftWorkflowId.Value);
        }

    private async Task OpenDraft()
        {
            if (workflow is null)
                return;

            await OnEditRequested.InvokeAsync(workflow.Workflow.Id);
        }

    private Task SelectVersion(int workflowId)
        {
            selectedVersionId = workflowId;
            showVersionDetails = true;

            return Task.CompletedTask;
        }

    private void CloseVersionDetails()
        {
            showVersionDetails = false;
            selectedVersionId = null;
        }

}