        private bool CanAddFinish(TopPartWorkflowNodeDto node)
{
    if (workflow is null || node.NodeType != 3)
        return false;

    var freeWips = workflow.Nodes
        .Where(x => x.NodeType == 3)
        .Where(wip =>
            !workflow.Connections.Any(x => x.FromNodeId == wip.Id))
        .ToList();

    return freeWips.Count == 1 &&
           freeWips[0].Id == node.Id;
}

    private async Task AddFinish(int wipNodeId)
        {
            if (workflow is null)
                return;

            var request = new AddTopPartFinishRequest
            {
                WorkflowId = workflow.Workflow.Id,
                WipNodeId = wipNodeId
            };

            var added = await TopPartWorkflowService.AddFinishAsync(request);

            if (!added)
            {
                errorMessage = TopPartWorkflowService.LastError;
                return;
            }

            errorMessage = null;
            hasChanges = true;

            workflow = await TopPartWorkflowService.GetWorkflowAsync(WorkflowId);

            RequestGraphRedraw();
        }

        private bool CanDeleteProcess(int processNodeId)
            {
                if (workflow is null)
                    return false;

                var outputWipId = workflow.Connections
                    .Where(x => x.FromNodeId == processNodeId)
                    .Select(x => x.ToNodeId)
                    .FirstOrDefault();

                if (outputWipId == 0)
                    return false;

                return !workflow.Connections.Any(connection =>
                    connection.FromNodeId == outputWipId &&
                    workflow.Nodes.Any(node =>
                        node.Id == connection.ToNodeId &&
                        node.NodeType == 2));
            }

