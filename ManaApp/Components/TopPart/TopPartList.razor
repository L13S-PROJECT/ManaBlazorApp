
@* TopPartList.razor *@

@using ManaApp.Shared.DTOs.TopPart
@using ManaApp.Services
@inject TopPartService TopPartService

<div class="toppart-list">

    <table>
        
            <thead>
                <tr>
                    <th></th>
                    <th>TopPart</th>
                    <th>Kods</th>
                    <th>Tips</th>
                    <th>Kategorija</th>
                    <th>Versija</th>
                    <th>Pēd. izmaiņas</th>
                    
                </tr>
            
        </thead>

        <tbody>
            @foreach (var topPart in topParts)
                {
                    <tr class="@(SelectedTopPartId == topPart.Id ? "selected" : "")"
                            @onclick="() => SelectTopPart(topPart)">

                        <td class="flow-status-cell">
                            @if (topPart.FlowStatus == 2)
                            {
                                <span class="flow-status flow-status-ready">✓</span>
                            }
                            else if (topPart.FlowStatus == 1)
                            {
                                <span class="flow-status flow-status-warning">▲</span>
                            }
                            else
                            {
                                <span class="flow-status flow-status-error">■</span>
                            }
                        </td>
                        
                        <td>@topPart.TopPartName</td>
                        <td>@topPart.TopPartCode</td>

                        <td>
                            @(topPart.TopPartType switch
                            {
                                0 => "Part",
                                1 => "Product",
                                2 => "SparePart",
                                _ => "—"
                            })
                        </td>
                        <td>
                            @(categories.FirstOrDefault(x => x.Id == topPart.TopPartCategoryID)?.CategoryName ?? "—")
                        </td>
                        <td>
                            @(topPart.ReleasedVersion.HasValue
                                ? $"V{topPart.ReleasedVersion.Value}"
                                : "—")
                        </td>

                        <td>
                            @(topPart.ReleasedDate.HasValue
                                ? topPart.ReleasedDate.Value.ToString("dd.MM.yyyy")
                                : "—")
                        </td>
                        
                    </tr>
                }
        </tbody>

    </table>

</div>

@code {
    private List<TopPartListItemDto> topParts = new();
    private List<TopPartCategoryDto> categories = new();

    protected override async Task OnInitializedAsync()
        {
            await ReloadAsync();
            categories = await TopPartService.GetCategoriesAsync();
        }

    public async Task<TopPartListItemDto?> ReloadAsync(
        int? selectedTopPartId = null,
        byte? typeFilter = null,
        int? categoryFilter = null,
        string? searchFilter = null,
        uint? relatedTopPartId = null)
            {
                topParts = await TopPartService.GetAllAsync(
                    typeFilter,
                    categoryFilter,
                    searchFilter,
                    relatedTopPartId);

                return selectedTopPartId.HasValue
                    ? topParts.FirstOrDefault(x => x.Id == selectedTopPartId.Value)
                    : null;
            }

    [Parameter]
    public EventCallback<TopPartListItemDto?> OnSelected { get; set; }

    [Parameter]
    public int? SelectedTopPartId { get; set; }

    [Parameter]
    public byte? TopPartTypeFilter { get; set; }

    [Parameter]
    public int? TopPartCategoryFilter { get; set; }

    [Parameter]
    public string? TopPartSearchFilter { get; set; }

    [Parameter]
    public uint? RelatedTopPartId { get; set; }

    private async Task SelectTopPart(TopPartListItemDto topPart)
        {
            if (SelectedTopPartId == topPart.Id)
            {
                await OnSelected.InvokeAsync(null);
                return;
            }

            await OnSelected.InvokeAsync(topPart);
        }

}