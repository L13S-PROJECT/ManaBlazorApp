@using ManaApp.Models
@using ManaApp.Components

<div class="ptv2-tasks-grid">
    <div class="ptv2-tasks-section">
    <div class="ptv2-tasks-header">
        <div>NOSAUKUMS</div>
        <div>GATAVS</div>
        <div>APJOMS</div>
        <div>PIEŠĶIRTS</div>
        <div>PIEŅĒMA</div>
        <div>SĀKUMS</div>
        <div>PABEIGTS</div>
        <div>KOMENTĀRS</div>
        <div></div>
    </div>

    <!-- ŠEIT VĒLĀK NĀKS xxxTasks.razor -->
<div class="ptv2-section">
    <div class="ptv2-tasks-subheader">DETAIL</div>
<DetailTasks 
    @key="SelectedBatch"
    SelectedBatch="SelectedBatch"
    OnDataChanged="HandleDataChanged" />
</div>

<div class="ptv2-section">
    <div class="ptv2-tasks-subheader">ASSEMBLY</div>
    <AssemblyTasks 
    @key="SelectedBatch?.BatchProductId"
    SelectedBatch="SelectedBatch"
    OnDataChanged="OnDataChanged" />
</div>

<div class="ptv2-section">
    <div class="ptv2-tasks-subheader">FINISHING</div>
    <FinishingTasks 
    @key="SelectedBatch?.BatchProductId"
    SelectedBatch="SelectedBatch"
    OnDataChanged="OnDataChanged" />
</div>

</div>
</div>

@code {
    [Parameter] public ProductBatchRow? SelectedBatch { get; set; }

    [Parameter] public EventCallback OnDataChanged { get; set; }

    private void HandleDataChanged()
    {
        OnDataChanged.InvokeAsync(null);
    }
}
