@* Workflow viever razor *@

@using ManaApp.Models
@using ManaApp.Components.Workflow
@using ManaApp.Services.Workflow
@inject WorkflowApiService WorkflowApi

@namespace ManaApp.Components.Products

   
    <div class="technology-panel">

    <div class="technology-panel-header">
        Tehnoloģijas bloks
    </div>

    <div class="technology-panel-body">

    @if (VersionId is null)
{
    <div>Izvēlies produktu.</div>
}
else if (loading)
{
    <div>Ielādēju...</div>
}

else
{    
    <div class="workflow-list">

    
            <div class="workflow-actions">

                <button class="btn btn-primary"
                        @onclick="OpenTechnologyEditor">
                    Tehnoloģijas redaktors
                </button>

            </div>

    <div class="workflow-top-parts">

        @foreach (var part in productTopParts
            .Where(x => x.ParentProductTopPartId == null)
            .OrderBy(x => x.TopPartName))
        {
            <WorkflowPartTree
                Part="part"
                Parts="productTopParts" />
        }

    </div>

</div>

    
}
</div>
</div>


<TechnologyEditor
    VersionId="VersionId"
    Visible="isTechnologyEditorOpen"
    VisibleChanged="OnTechnologyEditorClosed" />

@code
{
    [Parameter]
    public int? VersionId { get; set; }
    private bool loading;    
    private List<WorkflowPartModel> productTopParts = new();

    private bool isTechnologyEditorOpen = false;

    private async Task OpenTechnologyEditor()
        {
            if (VersionId is null)
                return;

            var response = await WorkflowApi.CreateWorkflowAsync(
                 VersionId.Value);
                 
Console.WriteLine($"CreateWorkflow status = {response.StatusCode}");

            if (!response.IsSuccessStatusCode)
                return;

            isTechnologyEditorOpen = true;
        }

    protected override async Task OnParametersSetAsync()
        {
           
            if (VersionId is null || VersionId <= 0)
            {
                productTopParts.Clear();
                return;
            }

            loading = true;

            await LoadProductTopPartsAsync();
            loading = false;
        }
          
        
    private async Task OnTechnologyEditorClosed(bool visible)
            {
                isTechnologyEditorOpen = visible;

                if (!visible && VersionId.HasValue)
                {
                    await OnParametersSetAsync();
                }
            }
        
    private async Task LoadProductTopPartsAsync()
            {
                if (!VersionId.HasValue)
                    return;

                productTopParts =
                    await WorkflowApi.LoadProductPartsAsync(VersionId.Value);
            }
   
}