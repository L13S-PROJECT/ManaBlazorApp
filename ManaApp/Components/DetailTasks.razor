@* Detail Tasks Component tikai stage=1; DETAIL POSMAM*@


@using ManaApp.Models
@using ManaApp.Components
@inject HttpClient Http
@inject IJSRuntime JS


@if (SelectedBatch is null)
{
    <div class="ptv2-detail-placeholder">
        Izvēlies Ražošanas partiju, lai redzētu detaļas
    </div>
    return;
}

<div class="@(IsReadOnly ? "ptv2-readonly" : "")">

@if (IsReadOnly && SelectedBatch is not null)
{
    var selectedPart = Parts.FirstOrDefault(p => p.ProductToPartId == SelectedChildPartId);

    <div class="ptv2-info-banner">

        @if (selectedPart is not null)
        {
            <span class="info-part">
    @selectedPart.TopPartName.ToUpper()
    @{
        var qty = qtyList
            .FirstOrDefault(x => x.ProductToPartId == SelectedChildPartId)?
            .ChildQty ?? 0;
    }
    <span class="info-qty">(@qty gb)</span>
</span>
        }

        <span class="info-meta">
            <strong>@SelectedBatch.BatchCode</strong>
            <span class="info-sep"> </span>
            @SelectedBatch.CategoryName
            <span class="info-sep"> </span>
            @SelectedBatch.ProductCode
        </span>

    </div>
}

@foreach (var p in Parts)
{
<div class="ptv2-tasks-row @(IsReadOnly ? "ptv2-row-disabled" : "")">
    <!-- 1. Nosaukums -->
            <div class="ptv2-part-name" title="@p.TopPartName">
                <span class="ptv2-part-indicator
                    @(DetailedIndicators.TryGetValue(p.ProductToPartId, out var st)
                        ? $"state-{st}"
                        : "state-gray")">
                </span>

                @p.TopPartName
            </div>
    <!-- 2. Gatavs -->
        <div>
<input type="checkbox"
       class="ptv2-switch"
       checked="@IsPartActivated(p.ProductToPartId)"
       disabled="@(IsReadOnly || IsPartActivated(p.ProductToPartId))"
       @onclick:preventDefault="true"
       @onclick="() => OnActivatePart(p.ProductToPartId)" />
        </div>

    <!-- 3. Apjoms -->
    <div>
@(string.IsNullOrWhiteSpace(p.QtyDisplay) ? "0" : p.QtyDisplay)

    </div>

    <!-- 4. Piešķirts -->
    <div></div>

    <!-- 5. Pieņēma -->
    <div></div>

    <!-- 6. Sākums (NO SUMMARY API) -->
    <div> </div>

    <!-- 7. Pabeigts (NO SUMMARY API) -->
    <div> </div>

    <!-- 8. Komentārs -->
    <div></div>

    <!-- 9. Done -->
    <div></div>
</div>

@foreach (var step in p.Steps)
{

if (AggregatedByStep.TryGetValue((step.Id, p.ProductToPartId), out var aggList))
{
    var agg = aggList.FirstOrDefault();

    var t = new DetailTaskRow
{
    TaskId = aggList.First().TaskId,
    TopPartStepId = aggList.First().TopPartStepId,
    ProductToPartId = aggList.First().ProductToPartId,

    Assigned_To = aggList.Select(x => x.Assigned_To).Distinct().Count() == 1
        ? aggList.First().Assigned_To
        : null,

    Claimed_By = aggList.Select(x => x.Claimed_By).Distinct().Count() == 1
        ? aggList.First().Claimed_By
        : null,

    StartedAt = aggList.Where(x => x.StartedAt.HasValue).Any()
        ? aggList.Min(x => x.StartedAt)
        : null,

    FinishedAt = aggList.All(x => x.FinishedAt.HasValue)
        ? aggList.Max(x => x.FinishedAt)
        : null,

    Comment = aggList.Select(x => x.Comment).FirstOrDefault(c => !string.IsNullOrWhiteSpace(c)),

    IsCommentForEmployee = aggList.Any(x => x.IsCommentForEmployee),

    Status =
        aggList.Any(x => x.Status == 2) ? 2 :
        aggList.All(x => x.Status == 3) ? 3 :
        aggList.All(x => x.Status == 1) ? 1 :
        5
};

    <div class="ptv2-tasks-row sub task @(IsReadOnly ? "ptv2-row-disabled" : "")">
                <!-- 1. Nosaukums (tukšs – step jau ir augstāk) -->
                    <div title="@step.StepName">
                        @step.StepName
                    </div>

                        <!-- 2. Gatavs -->
                        <div></div>

                        <!-- 3. Apjoms -->
                        <div></div>

                        <!-- 4. Piešķirts -->
                        <div>
                            @if (t.Status == 2 || t.Status == 3 || t.Claimed_By != null || t.StartedAt != null)
                                {
                                    <div class="assigned-readonly">
                                        @Employees.FirstOrDefault(e => e.Id == t.Assigned_To)?.Name
                                    </div>
                                }
                                else
                                {
                                    <select value="@(agg?.Assigned_To)"
                                        disabled="@(IsReadOnly || t.Status == 2 || t.Status == 3)"
                                            @onchange="async e => {
                                                var val = int.TryParse(e.Value?.ToString(), out var v) ? v : (int?)null;
                                                agg!.Assigned_To = val;
                                                await OnAssignedChanged(step.Id, p.ProductToPartId, e);
                                            }">
                                        <option value="">—</option>
                                        @foreach (var emp in Employees)
                                        {
                                            <option value="@emp.Id">@emp.Name</option>
                                        }
                                    </select>
                                }
                        </div>

                        <!-- 5. Pieņēma -->
                        <div>
                            @Employees.FirstOrDefault(e => e.Id == t.Claimed_By)?.Name

                        </div>

                <!-- 6. Sākums -->
                        <div>
                            @(t.StartedAt.HasValue
                                ? t.StartedAt.Value.ToString("dd.MM.yyyy")
                                : "—")
                        </div>

                <!-- 7. Pabeigts -->
                        <div>
                            @(t.FinishedAt.HasValue
                                ? t.FinishedAt.Value.ToString("dd.MM.yyyy")
                                : "—")
                        </div>

                <!-- 8. Komentārs (vizuāli, funkcija vēlāk) -->
                <div class="ptv2-comment-wrap">
                    <input
                        type="text"
                        class="ptv2-comment-input @(string.IsNullOrWhiteSpace(t.Comment) ? "ptv2-comment-empty" : "")"
                        value="@(string.IsNullOrWhiteSpace(t.Comment) ? "(Pievienot komentāru)" : t.Comment)"
                        readonly />
                        <button
                            type="button"
                            class="ptv2-comment-edit"
                            title="Labot komentāru"
                            @onclick="() => OpenCommentEditor(t)">
                            ✎
                        </button>

                </div>


                        <!-- 9. Done (vizuāli checkbox, funkcija vēlāk) -->
                <div class="ptv2-done-cell">
                <div class="ptv2-done-cell" style="position:relative; z-index:5;">
                    <input type="checkbox"
                        disabled="@IsReadOnly"
                        class="ptv2-done-checkbox"
                        style="position:relative; z-index:6;"
                        title="Redzams darbiniekam"
                        checked="@t.IsCommentForEmployee"
                        @onchange="e => OnCommentVisibilityChanged(t, e)" />
                </div>
                </div>

            </div>
        }
    }



}

@if (IsCommentPopupOpen && EditingTask is not null)
{
    <div class="ptv2-popup-backdrop">
        <div class="ptv2-popup">
            <h4>Komentārs</h4>

                    <textarea
                        style="width:100%; height:80px;"
                        @bind="EditingCommentText">
                    </textarea>

            <div style="margin-top:8px; text-align:right;">
                <button @onclick="CancelComment">Atcelt</button>
                <button style="margin-left:6px;" @onclick="ConfirmComment">OK</button>
            </div>
        </div>
    </div>
}
</div>

@code {

    // glabās ProductToPartId, kuri jau ir aktivizēti šai partijai
    private HashSet<int> ActivatedParts = new();
    private HashSet<(int BatchProductId, int ProductToPartId)> ActivatedChildParts = new();
    
    // DETAILED indikatori pa detaļām
    private Dictionary<int, string> DetailedIndicators = new();
    private Dictionary<(int BatchProductId, int ProductToPartId), string> DetailedIndicatorsChild = new();
    private List<DetailQtyRow> qtyList = new();
    [Parameter] public ProductBatchRow? SelectedBatch { get; set; }
    [Parameter] public EventCallback OnDataChanged { get; set; }
// Parts ir ProductTopParts konkrētajai VersionId (no SelectedBatch) 26.01.2026
    private List<DetailPartRow> Parts = new();
    [Parameter] public int? SelectedChildPartId { get; set; }
private sealed class DetailedIndicatorRow
{
    public int ProductToPartId { get; set; }
    public string State { get; set; } = "";
}
    [Parameter] public bool IsReadOnly { get; set; }

Dictionary<(int TopPartStepId, int ProductToPartId), List<DetailTaskRow>> TasksByStep
    = new();

Dictionary<(int TopPartStepId, int ProductToPartId), List<DetailTaskAggregatedRow>> AggregatedByStep
    = new();


private List<DetailTaskAggregatedRow> AggregatedTasks = new();

private bool hasAnyParent;
private bool hasAnyChild;
private bool isChildOnly;

protected override async Task OnParametersSetAsync()
{
        Parts.Clear();
        TasksByStep.Clear();
        ActivatedParts.Clear();

    if (SelectedBatch?.VersionId is not int vid || vid <= 0)
        return;

    var dto = await Http.GetFromJsonAsync<DetailTasksDto>(
    $"http://localhost:5270/api/tasks/detail-tasks?batchProductId={SelectedBatch.BatchProductId}"
);

if (dto is not null)
{
    Parts = dto.Parts
        .Select(x => new DetailPartRow
        {
            ProductToPartId = x.ProductToPartId,
            TopPartName = x.TopPartName ?? "",
            Qty = x.Qty,
            QtyDisplay = x.QtyDisplay,  
            StartDate = x.StartDate,
            EndDate = x.EndDate,
            Steps = x.Steps
            .Select(s => new TopPartStepRow
            {
                Id = s.StepId,
                StepName = s.StepName ?? "",
                ProductToPartId = x.ProductToPartId
            }).ToList()
        })
        .ToList();

    ActivatedParts = dto.Parts
        .Where(x => x.IsActivated)
        .Select(x => x.ProductToPartId)
        .ToHashSet();

    DetailedIndicators = dto.Parts.ToDictionary(
        x => x.ProductToPartId,
        x => x.Indicator
    );
}


    if (SelectedBatch?.BatchProductId is not int bpId || bpId <= 0)
        return;

    var aggUrl =
        $"http://localhost:5270/api/tasks/aggregated-by-batch" +
        $"?batchProductId={bpId}&stepType=1";

    AggregatedTasks =
        await Http.GetFromJsonAsync<List<DetailTaskAggregatedRow>>(aggUrl)
        ?? new();

    AggregatedByStep = AggregatedTasks
    .GroupBy(x => (x.TopPartStepId, x.ProductToPartId))
    .ToDictionary(
        g => g.Key,
        g => g.ToList()
    );

    qtyList =
    await Http.GetFromJsonAsync<List<DetailQtyRow>>(
        $"http://localhost:5270/api/batches/detail-qty?batchProductId={bpId}"
    ) ?? new();

    hasAnyParent = qtyList.Any(x => x.ParentQty > 0);
    hasAnyChild  = qtyList.Any(x => x.ChildQty > 0);
    isChildOnly = !hasAnyParent && hasAnyChild;

    // tikai Child scenārijs
    if (isChildOnly)
    {
        Parts = Parts
            .Where(p =>
                qtyList.Any(x =>
                    x.ProductToPartId == p.ProductToPartId
                    && x.ChildQty > 0))
            .ToList();
    }

    // Parent + Child scenārijs – NEFILTRĒJAM detaļas
    // (rādām pilnu tehnoloģiju, pat ja child nav visām detaļām)
    if (hasAnyParent && hasAnyChild)
        {
            // neko nedaram – Parts paliek pilns saraksts
        }
    
    // child-only: ielādējam aktivētās detaļas konkrētajam batch
if (isChildOnly)
{
    ActivatedChildParts.Clear();
    DetailedIndicatorsChild.Clear();

    var childBatchIds = qtyList
        .Where(x => x.BatchProductId.HasValue)
        .Select(x => x.BatchProductId!.Value)
        .Distinct()
        .ToList();

   foreach (var childBatchProductId in childBatchIds)
{
    var activeParts =
        await Http.GetFromJsonAsync<List<int>>(
            $"http://localhost:5270/api/tasks/active-parts?batchProductId={childBatchProductId}"
        ) ?? new();
    
    var indicators =
    await Http.GetFromJsonAsync<List<DetailedIndicatorRow>>(
        $"http://localhost:5270/api/tasks/detailed-indicators?batchProductId={childBatchProductId}"
    ) ?? new();

foreach (var ind in indicators)
{
    DetailedIndicatorsChild[(childBatchProductId, ind.ProductToPartId)] = ind.State;
}

    foreach (var id in activeParts)
    {
        ActivatedChildParts.Add((childBatchProductId, id));
    
    }

}
}
}

private List<EmployeeRow> Employees = new();

protected override async Task OnInitializedAsync()
{
    Employees =
        await Http.GetFromJsonAsync<List<EmployeeRow>>(
            "http://localhost:5270/api/employees")
        ?? new();
}

public sealed class EmployeeRow
{
    public int Id { get; set; }
    public string Name { get; set; } = "";
}

async Task OnAssignedChanged(int stepId, int partId, ChangeEventArgs e)
{
    int? empId =
        int.TryParse(e.Value?.ToString(), out var v)
            ? v
            : (int?)null;

    // UI sync
    // 🔵 sync raw (lai vecā loģika neplīst)
        if (TasksByStep.TryGetValue((stepId, partId), out var list))
            {
                foreach (var task in list)
                {
                    task.Assigned_To = empId;
                }
            }

// 🟢 sync aggregated (tas ir tas, ko rāda dropdown)
        if (AggregatedByStep.TryGetValue((stepId, partId), out var aggList))
            {
                foreach (var task in aggList)
                {
                    task.Assigned_To = empId;
                }
            }

    await Http.PostAsJsonAsync(
            "http://localhost:5270/api/tasks/update-assignee-root",
            new
            {
                BatchProductId = SelectedBatch!.BatchProductId,
                TopPartStepId = stepId,
                ProductToPartId = partId,
                Assigned_To = empId,
                IsRoot = true 
            });
}

