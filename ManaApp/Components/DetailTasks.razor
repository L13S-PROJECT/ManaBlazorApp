@* Detail Tasks Component tikai stage=1; DETAIL POSMAM*@


@using ManaApp.Models
@using ManaApp.Components
@inject HttpClient Http
@inject IJSRuntime JS


@if (SelectedBatch is null)
{
    <div class="ptv2-detail-placeholder">
        Izvēlies Ražošanas partiju, lai redzētu detaļas
    </div>
    return;
}

@foreach (var p in Parts)
{
<div class="ptv2-tasks-row">
    <!-- 1. Nosaukums -->
            <div class="ptv2-part-name" title="@p.TopPartName">
                <span class="ptv2-part-indicator
                    @(DetailedIndicators.TryGetValue(p.ProductToPartId, out var st)
                        ? $"state-{st}"
                        : "state-gray")">
                </span>

                @p.TopPartName
            </div>
    <!-- 2. Gatavs -->
        <div>
<input type="checkbox"
       class="ptv2-switch"
       checked="@ActivatedParts.Contains(p.ProductToPartId)"
       disabled="@ActivatedParts.Contains(p.ProductToPartId)"
       @onclick:preventDefault="true"
       @onclick="() => OnActivatePart(p.ProductToPartId)" />
        </div>

    <!-- 3. Apjoms -->
    <div>
@{
    var qty = qtyList.FirstOrDefault(x => x.ProductToPartId == p.ProductToPartId);

    var parentQty = qty?.ParentQty ?? 0;
    var childQty  = qty?.ChildQty ?? 0;
    var baseQty   = p.Quantity;
}

@if (parentQty > 0 && childQty > 0)
{
    @($"{parentQty}+{childQty}")
}

// tikai Parent
else if (parentQty > 0)
{
    @($"{baseQty * parentQty}")
}
// tikai Child
else if (childQty > 0)
{
    @($"+{childQty}")
}
// Parent scenārijs bet nav konkrētai detaļai → katalogs
else if (hasAnyParent)
{
    @($"{baseQty}")
}


</div>

    <!-- 4. Piešķirts -->
    <div></div>

    <!-- 5. Pieņēma -->
    <div></div>

    <!-- 6. Sākums (NO SUMMARY API) -->
    <div> </div>

    <!-- 7. Pabeigts (NO SUMMARY API) -->
    <div> </div>

    <!-- 8. Komentārs -->
    <div></div>

    <!-- 9. Done -->
    <div></div>
</div>

@foreach (var step in p.Steps)
{

@if (TasksByStep.TryGetValue((step.Id, p.ProductToPartId), out var tasks))
{
    var t = tasks.First();
    
    AggregatedByStep.TryGetValue((step.Id, p.ProductToPartId), out var aggList);
        var agg = aggList?.FirstOrDefault();

    <div class="ptv2-tasks-row sub task">
                <!-- 1. Nosaukums (tukšs – step jau ir augstāk) -->
                    <div title="@step.StepName">
                        @step.StepName
                    </div>

                        <!-- 2. Gatavs -->
                        <div></div>

                        <!-- 3. Apjoms -->
                        <div></div>

                        <!-- 4. Piešķirts -->
                        <div>
                            @if (t.Status == 2 || t.Status == 3)
                                {
                                    <div class="assigned-readonly">
                                        @Employees.FirstOrDefault(e => e.Id == t.Assigned_To)?.Name
                                    </div>
                                }
                                else
                                {
                                    <select value="@(agg?.Assigned_To)"
                                            @onchange="async e => {
                                                var val = int.TryParse(e.Value?.ToString(), out var v) ? v : (int?)null;
                                                agg!.Assigned_To = val;
                                                await OnAssignedChanged(step.Id, p.ProductToPartId, e);
                                            }">
                                        <option value="">—</option>
                                        @foreach (var emp in Employees)
                                        {
                                            <option value="@emp.Id">@emp.Name</option>
                                        }
                                    </select>
                                }
                        </div>

                        <!-- 5. Pieņēma -->
                        <div>
                            @Employees.FirstOrDefault(e => e.Id == t.Claimed_By)?.Name

                        </div>

                <!-- 6. Sākums -->
                        <div>
                            @(t.StartedAt.HasValue
                                ? t.StartedAt.Value.ToString("dd.MM.yyyy")
                                : "—")
                        </div>

                <!-- 7. Pabeigts -->
                        <div>
                            @(t.FinishedAt.HasValue
                                ? t.FinishedAt.Value.ToString("dd.MM.yyyy")
                                : "—")
                        </div>

                <!-- 8. Komentārs (vizuāli, funkcija vēlāk) -->
                <div class="ptv2-comment-wrap">
                    <input
                        type="text"
                        class="ptv2-comment-input @(string.IsNullOrWhiteSpace(t.Comment) ? "empty" : "")"
                        value="@(string.IsNullOrWhiteSpace(t.Comment) ? "(Pievienot komentāru)" : t.Comment)"
                        readonly />
                        <button
                            type="button"
                            class="ptv2-comment-edit"
                            title="Labot komentāru"
                            @onclick="() => OpenCommentEditor(t)">
                            ✎
                        </button>

                </div>


                        <!-- 9. Done (vizuāli checkbox, funkcija vēlāk) -->
                <div class="ptv2-done-cell">
                <div class="ptv2-done-cell" style="position:relative; z-index:5;">
                    <input type="checkbox"
                        class="ptv2-done-checkbox"
                        style="position:relative; z-index:6;"
                        title="Redzams darbiniekam"
                        checked="@t.IsCommentForEmployee"
                        @onchange="e => OnCommentVisibilityChanged(t, e)" />
                </div>
                </div>

            </div>
        }
    }



}

@if (IsCommentPopupOpen && EditingTask is not null)
{
    <div class="ptv2-popup-backdrop">
        <div class="ptv2-popup">
            <h4>Komentārs</h4>

                    <textarea
                        style="width:100%; height:80px;"
                        @bind="EditingCommentText">
                    </textarea>

            <div style="margin-top:8px; text-align:right;">
                <button @onclick="CancelComment">Atcelt</button>
                <button style="margin-left:6px;" @onclick="ConfirmComment">OK</button>
            </div>
        </div>
    </div>
}

@code {

    // glabās ProductToPartId, kuri jau ir aktivizēti šai partijai
    private HashSet<int> ActivatedParts = new();
    
    // DETAILED indikatori pa detaļām
    private Dictionary<int, string> DetailedIndicators = new();
    private List<DetailQtyRow> qtyList = new();
    [Parameter] public ProductBatchRow? SelectedBatch { get; set; }
    [Parameter] public EventCallback OnDataChanged { get; set; }
// Parts ir ProductTopParts konkrētajai VersionId (no SelectedBatch) 26.01.2026
    private List<DetailPartRow> Parts = new();

private sealed class DetailedIndicatorRow
{
    public int ProductToPartId { get; set; }
    public string State { get; set; } = "";
}


Dictionary<(int TopPartStepId, int ProductToPartId), List<DetailTaskRow>> TasksByStep
    = new();

Dictionary<(int TopPartStepId, int ProductToPartId), List<DetailTaskAggregatedRow>> AggregatedByStep
    = new();


private List<DetailTaskAggregatedRow> AggregatedTasks = new();

private bool hasAnyParent;
private bool hasAnyChild;

protected override async Task OnParametersSetAsync()
{
        Parts.Clear();
        TasksByStep.Clear();
        ActivatedParts.Clear();

    if (SelectedBatch?.VersionId is not int vid || vid <= 0)
        return;

// 🆕 ielādējam aktivizētās detaļas (status != 5)
if (SelectedBatch?.BatchProductId is int batchProductId && batchProductId > 0)
{
var activeParts =
    await Http.GetFromJsonAsync<List<int>>(
        $"http://localhost:5270/api/tasks/active-parts?batchProductId={batchProductId}"
    ) ?? new();

    ActivatedParts = activeParts.ToHashSet();
}

// 🆕 ielādējam DETAILED indikatorus (gray / blue / yellow / green)
if (SelectedBatch?.BatchProductId is int batchProductId2 && batchProductId2 > 0)
{
    var indicators =
        await Http.GetFromJsonAsync<List<DetailedIndicatorRow>>(
            $"http://localhost:5270/api/tasks/detailed-indicators?batchProductId={batchProductId2}"
        ) ?? new();

    DetailedIndicators = indicators.ToDictionary(
        x => x.ProductToPartId,
        x => x.State
    );
}

    // 1) Ielādējam ProductTopParts (DETAIL)
    var partsUrl =
        $"http://localhost:5270/api/products/details?versionId={vid}&stepType=1";

    Parts =
        await Http.GetFromJsonAsync<List<DetailPartRow>>(partsUrl)
        ?? new();

    
    if (SelectedBatch?.BatchProductId is not int bpId || bpId <= 0)
        return;

    // 2) Ielādējam DETAIL taskus ŠAI PARTIJAI
    var tasksUrl =
        $"http://localhost:5270/api/tasks/by-batch" +
        $"?batchProductId={bpId}&stepType=1";

    var tasks =
        await Http.GetFromJsonAsync<List<DetailTaskRow>>(tasksUrl)
        ?? new();

    var aggTasks =
    await Http.GetFromJsonAsync<List<DetailTaskRow>>(
        $"http://localhost:5270/api/tasks/aggregated-by-batch?batchProductId={bpId}&stepType=1"
    ) ?? new();

    var aggUrl =
        $"http://localhost:5270/api/tasks/aggregated-by-batch" +
        $"?batchProductId={bpId}&stepType=1";

    AggregatedTasks =
        await Http.GetFromJsonAsync<List<DetailTaskAggregatedRow>>(aggUrl)
        ?? new();


    qtyList =
    await Http.GetFromJsonAsync<List<DetailQtyRow>>(
        $"http://localhost:5270/api/batches/detail-qty?batchProductId={bpId}"
    ) ?? new();

    hasAnyParent = qtyList.Any(x => x.ParentQty > 0);
    hasAnyChild  = qtyList.Any(x => x.ChildQty > 0);

    // tikai Child scenārijs
    if (!hasAnyParent && hasAnyChild)
    {
        Parts = Parts
            .Where(p =>
                qtyList.Any(x =>
                    x.ProductToPartId == p.ProductToPartId
                    && x.ChildQty > 0))
            .ToList();
    }
        
    // 3) Grupējam pēc TopPartStep_ID

    // 🔵 RAW taski (esošā loģika)
    TasksByStep = tasks
        .GroupBy(t => (t.TopPartStepId, t.ProductToPartId))
        .ToDictionary(g => g.Key, g => g.ToList());

    // 🟢 Aggregated (jaunā loģika)
    AggregatedByStep = AggregatedTasks
        .GroupBy(t => (t.TopPartStepId, t.ProductToPartId))
        .ToDictionary(g => g.Key, g => g.ToList());

    // 4) Aprēķinām PART Start / End no taskiem
foreach (var p in Parts)
{
    var partTasks = tasks
        .Where(t =>
            p.Steps.Any(s => s.Id == t.TopPartStepId))
        .ToList();

    if (partTasks.Count == 0)
        continue;

    p.StartDate = partTasks
        .Where(t => t.StartedAt.HasValue)
        .Min(t => t.StartedAt);

    p.EndDate = partTasks
        .Where(t => t.FinishedAt.HasValue)
        .Max(t => t.FinishedAt);
}

}

private List<EmployeeRow> Employees = new();

protected override async Task OnInitializedAsync()
{
    Employees =
        await Http.GetFromJsonAsync<List<EmployeeRow>>(
            "http://localhost:5270/api/employees")
        ?? new();
}

public sealed class EmployeeRow
{
    public int Id { get; set; }
    public string Name { get; set; } = "";
}

async Task OnAssignedChanged(int stepId, int partId, ChangeEventArgs e)
{
    int? empId =
        int.TryParse(e.Value?.ToString(), out var v)
            ? v
            : (int?)null;

    // UI sync
    // 🔵 sync raw (lai vecā loģika neplīst)
        if (TasksByStep.TryGetValue((stepId, partId), out var list))
            {
                foreach (var task in list)
                {
                    task.Assigned_To = empId;
                }
            }

// 🟢 sync aggregated (tas ir tas, ko rāda dropdown)
        if (AggregatedByStep.TryGetValue((stepId, partId), out var aggList))
            {
                foreach (var task in aggList)
                {
                    task.Assigned_To = empId;
                }
            }

    await Http.PostAsJsonAsync(
        "http://localhost:5270/api/tasks/update-assignee-aggregated",
        new
        {
            BatchProductId = SelectedBatch!.BatchProductId,
            TopPartStepId = stepId,
            ProductToPartId = partId,
            Assigned_To = empId
        });
}

private sealed class DetailTaskRow
{
    public int TaskId { get; set; }
    public int Status { get; set; }
    public int? Assigned_To { get; set; }
    public int Done { get; set; }
    public int? ParentBatchProductId { get; set; }
    public int? ProductToPartId_BP { get; set; }
    public int ProductToPartId { get; set; }
    public int TopPartStepId { get; set; }
    public int BatchPlannedQty { get; set; }
    public int QtyPerProduct { get; set; }
    public int TopPartId { get; set; }
    // 🆕 NO EmployeeTasks
    public int? Claimed_By { get; set; }
    public DateTime? StartedAt { get; set; }
    public DateTime? FinishedAt { get; set; }
    public string? Comment { get; set; }
    public bool IsCommentForEmployee { get; set; }
}

private sealed class DetailTaskAggregatedRow
{
    public int TopPartStepId { get; set; }
    public int ProductToPartId { get; set; }

    public string? StepName { get; set; }
    public string? TopPartName { get; set; }

    public int TotalQty { get; set; }

    public int? Assigned_To { get; set; }
    public int? Claimed_By { get; set; }

    public DateTime? StartedAt { get; set; }
    public DateTime? FinishedAt { get; set; }

    public int Status { get; set; }
}

private sealed class DetailSummaryRow
{
    public int ProductToPartId { get; set; }
    public DateTime? StartedAt { get; set; }
    public DateTime? FinishedAt { get; set; }
}
// switch pogas funkcija 27.01.2026
async Task OnActivatePart(int productToPartId)
{
    if (SelectedBatch?.BatchId is not int batchId || batchId <= 0)
        return;

    var part = Parts.FirstOrDefault(p => p.ProductToPartId == productToPartId);
    if (part is null)
        return;

var batchCode = SelectedBatch?.BatchCode ?? "—";

var ok = await JS.InvokeAsync<bool>(
    "confirm",
    $"Vai detaļa \"{part.TopPartName}\" (produkts: {SelectedBatch?.ProductCode}) partijā {batchCode} ir gatava?"
);

if (!ok)
    return;

Console.WriteLine(
    $"[UI] BatchProductId={SelectedBatch?.BatchProductId}, ProductToPartId={productToPartId}"
);


    await Http.PostAsJsonAsync(
    "http://localhost:5270/api/tasks/activate-part",
    new
    {
        BatchProductId = SelectedBatch!.BatchProductId,
        ProductToPartId = productToPartId
    }
    );

var activeParts =
    await Http.GetFromJsonAsync<List<int>>(
    $"http://localhost:5270/api/tasks/active-parts?batchProductId={SelectedBatch!.BatchProductId}"
) ?? new();

ActivatedParts = activeParts.ToHashSet();

await InvokeAsync(StateHasChanged);

// pārlādējam arī indikatorus šai rindai
if (SelectedBatch?.BatchProductId is int batchProductId2 && batchProductId2 > 0)
{
    var indicators =
        await Http.GetFromJsonAsync<List<DetailedIndicatorRow>>(
            $"http://localhost:5270/api/tasks/detailed-indicators?batchProductId={batchProductId2}"
        ) ?? new();

    DetailedIndicators = indicators.ToDictionary(
        x => x.ProductToPartId,
        x => x.State
    );
}

await InvokeAsync(StateHasChanged);
await OnDataChanged.InvokeAsync();
}

    private bool IsCommentPopupOpen = false;
    private int EditingTaskId;
    private string? EditingComment;
    private DetailTaskRow? EditingTask;

void OpenCommentEditor(DetailTaskRow task)
{
    EditingTask = task;
    EditingCommentText = task.Comment ?? "";
    IsCommentPopupOpen = true;
}


private string EditingCommentText = "";

void CancelComment()
{
    IsCommentPopupOpen = false;
    EditingTask = null;
}

async Task ConfirmComment()
{
    if (EditingTask is not null)
    {
        await Http.PostAsJsonAsync(
            "http://localhost:5270/api/tasks/update-comment",
            new
            {
                TaskId = EditingTask.TaskId,
                Comment = EditingCommentText,
                IsForEmployee = true
            });

        EditingTask.Comment = EditingCommentText;
    }

    IsCommentPopupOpen = false;
    EditingTask = null;

    await OnDataChanged.InvokeAsync();
}

async Task OnCommentVisibilityChanged(DetailTaskRow task, ChangeEventArgs e)
{
    var isChecked = (bool)e.Value!;

    await Http.PostAsJsonAsync(
        "http://localhost:5270/api/tasks/update-comment-visibility",
        new
        {
            TaskId = task.TaskId,
            IsCommentForEmployee = isChecked
        });

    task.IsCommentForEmployee = isChecked; // UI sync
}

private Dictionary<int, List<dynamic>> tasksGrouped = new();

private sealed class DetailQtyRow
{
    public int ProductToPartId { get; set; }
    public string TopPartName { get; set; } = "";
    public int ParentQty { get; set; }
    public int ChildQty { get; set; }
}

int? GetAggregatedAssigned(int stepId, int partId)
{
    if (AggregatedByStep.TryGetValue((stepId, partId), out var list))
    {
        return list.FirstOrDefault()?.Assigned_To;
    }

    return null;
}

}
