{
    public int TopPartStepId { get; set; }
    public int ProductToPartId { get; set; }
    public int TaskId { get; set; }
    public string? StepName { get; set; }
    public string? TopPartName { get; set; }

    public int TotalQty { get; set; }

    public int? Assigned_To { get; set; }
    public int? Claimed_By { get; set; }

    public DateTime? StartedAt { get; set; }
    public DateTime? FinishedAt { get; set; }
    public string? Comment { get; set; }
    public bool IsCommentForEmployee { get; set; }
    public int Status { get; set; }
}

private sealed class DetailSummaryRow
{
    public int ProductToPartId { get; set; }
    public DateTime? StartedAt { get; set; }
    public DateTime? FinishedAt { get; set; }
}
// switch pogas funkcija 27.01.2026
async Task OnActivatePart(int productToPartId)
{
    if (SelectedBatch?.BatchProductId is not int batchProductId || batchProductId <= 0)
    return;

    var part = Parts.FirstOrDefault(p => p.ProductToPartId == productToPartId);
    if (part is null)
        return;

var batchCode = SelectedBatch?.BatchCode ?? "—";

var ok = await JS.InvokeAsync<bool>(
    "confirm",
    $"Vai detaļa \"{part.TopPartName}\" (produkts: {SelectedBatch?.ProductCode}) partijā {batchCode} ir gatava?"
);

var hasTasks = part.Steps.Any(s =>
    TasksByStep.ContainsKey((s.Id, productToPartId)));



if (!ok)
    return;

var targetBatchProductId = SelectedBatch!.BatchProductId;

// Child only gadījumā jāņem konkrētās detaļas batchProduct
if (isChildOnly)
{
   var matches = qtyList
    .Where(x => x.ProductToPartId == productToPartId)
    .ToList();

var match = matches
    .FirstOrDefault(x => x.BatchProductId == SelectedBatch!.BatchProductId)
    ?? matches.FirstOrDefault();

if (match?.BatchProductId != null && match.BatchProductId > 0)
    {
        targetBatchProductId = match.BatchProductId.Value;
    }
}

await Http.PostAsJsonAsync(
    "http://localhost:5270/api/tasks/activate-part",
    new
    {
        BatchProductId = targetBatchProductId,
        ProductToPartId = productToPartId
    }
);

var activeParts =
    await Http.GetFromJsonAsync<List<int>>(
    $"http://localhost:5270/api/tasks/active-parts?batchProductId={targetBatchProductId}"
) ?? new();

// ❗ FIX: child-only → NEPĀRRAKSTĀM visu setu
if (isChildOnly)
{
    // iztīram tikai konkrētā child batch ierakstus
    ActivatedChildParts.RemoveWhere(x => x.BatchProductId == targetBatchProductId);

    // ieliekam aktuālos no DB
    foreach (var id in activeParts)
    {
        ActivatedChildParts.Add((targetBatchProductId, id));
    }
}
else
{
    ActivatedParts = activeParts.ToHashSet();
}

await InvokeAsync(StateHasChanged);

if (!isChildOnly)
{
    await OnParametersSetAsync();
}
await InvokeAsync(StateHasChanged);
await OnDataChanged.InvokeAsync();
}

    private bool IsCommentPopupOpen = false;
    private int EditingTaskId;
    private string? EditingComment;
    private DetailTaskRow? EditingTask;

void OpenCommentEditor(DetailTaskRow task)
{
    EditingTask = task;
    EditingCommentText = task.Comment ?? "";
    IsCommentPopupOpen = true;
}


private string EditingCommentText = "";

void CancelComment()
{
    IsCommentPopupOpen = false;
    EditingTask = null;
}

async Task ConfirmComment()
{
    if (EditingTask is not null)
    {
        await Http.PostAsJsonAsync(
            "http://localhost:5270/api/tasks/update-comment",
            new
            {
                TaskId = EditingTask.TaskId,
                Comment = EditingCommentText,
                IsForEmployee = true
            });
    }

    IsCommentPopupOpen = false;
    EditingTask = null;

    // pārlādē visu no API (nepaļaujamies uz lokālo objektu)
    await OnParametersSetAsync();

    await InvokeAsync(StateHasChanged);
}

async Task OnCommentVisibilityChanged(DetailTaskRow task, ChangeEventArgs e)
{
    var isChecked = (bool)e.Value!;

    await Http.PostAsJsonAsync(
        "http://localhost:5270/api/tasks/update-comment-visibility",
        new
        {
            TaskId = task.TaskId,
            IsCommentForEmployee = isChecked
        });

    task.IsCommentForEmployee = isChecked; // UI sync

    if (AggregatedByStep.TryGetValue((task.TopPartStepId, task.ProductToPartId), out var list))
{
    foreach (var x in list)
    {
        x.IsCommentForEmployee = isChecked;
    }
}
}

private Dictionary<int, List<dynamic>> tasksGrouped = new();

private sealed class DetailQtyRow
{
    public int ProductToPartId { get; set; }
    public int? BatchProductId { get; set; }
    public string TopPartName { get; set; } = "";
    public int ParentQty { get; set; }
    public int ChildQty { get; set; }
}

int? GetAggregatedAssigned(int stepId, int partId)
{
    if (AggregatedByStep.TryGetValue((stepId, partId), out var list))
    {
        return list.FirstOrDefault()?.Assigned_To;
    }

    return null;
}

private bool IsPartActivated(int productToPartId)
{
    if (isChildOnly)
    {
        var match = qtyList
    .FirstOrDefault(x =>
        x.ProductToPartId == productToPartId &&
        ActivatedChildParts.Any(a =>
            a.ProductToPartId == productToPartId &&
            a.BatchProductId == x.BatchProductId));

        if (match?.BatchProductId is int childBpId && childBpId > 0)
        {
            return ActivatedChildParts.Contains((childBpId, productToPartId));
        }

        return false;
    }

    // Parent vai Parent+Child
    return ActivatedParts.Contains(productToPartId);
}

private string GetIndicatorState(int productToPartId)
{
    if (!isChildOnly)
    {
        return DetailedIndicators.TryGetValue(productToPartId, out var st)
            ? st
            : "gray";
    }

    // C scenārijs – skatāmies vai ir aktīvs jebkurš child
    var hasActive = ActivatedChildParts
        .Any(x => x.ProductToPartId == productToPartId);

    return hasActive ? "blue" : "gray";
}

}
