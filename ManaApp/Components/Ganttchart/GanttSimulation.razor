@*GanttSimulation.razor - laika simulācijas kopsavilkums*@

@using ManaApp.Services
@inject HttpClient Http
@inject GanttSimulationService Service

<div class="simulation-table">

    <div class="simulation-toolbar">
        <input type="text" placeholder="Meklēt..." />
        <button>Arhīvs</button>
    </div>

    <div class="simulation-header">

    <div class="header-row top">

        <div class="cell info" style="grid-column: span 5;">Informācija par preci</div>

        <div class="cell detail" style="grid-column: span 3;">Detail</div>

        <div class="cell assembly" style="grid-column: span 2;">Assembly</div>

        <div class="cell finishing" style="grid-column: span 6;">Finishing</div>

    </div>

        <div class="header-row bottom">
            <div class="cell">Batch</div>
            <div class="cell">Nosaukums</div>
            <div class="cell">Kods</div>
            <div class="cell">Versija</div>
            <div class="cell">Apjoms</div>

            <div class="cell">Status</div>
            <div class="cell">Neiesākti</div>
            <div class="cell">Laiks</div>

            <div class="cell">Status</div>
            <div class="cell">Laiks</div>

            <div class="cell">Nekrāsoti</div>
            <div class="cell">Laiks</div>
            <div class="cell">Status</div>
            <div class="cell">Apjoms</div>
            <div class="cell">Laiks</div>
            <div class="cell">Pabeigti</div>
        </div>

        <div class="simulation-body">
        
   @foreach (var row in ordered)
    {
        <div class="header-row bottom">

            <div class="cell">@row.BatchCode</div>
            <div class="cell">@row.ProductName</div>
            <div class="cell">@row.ProductCode</div>
            <div class="cell">@row.VersionName</div>
            <div class="cell">@row.Planned</div>

<!-- detail lauku -->
           @{
                var tasks = tasksByBatch.ContainsKey(row.BatchProductId)
                    ? tasksByBatch[row.BatchProductId]
                    : new List<TaskDto>();

                var detail = detailResults[row.BatchProductId];
            }

        <div class="cell">@detail.Status</div>
    
        <div class="cell">
            @(detail.NotStartedText ?? "-")
        </div>

        <div class="cell">@detail.FinishDateText</div>

<!-- pārējie pagaidām tukši -->
            <div class="cell"></div>
            <div class="cell"></div>

            <div class="cell"></div>
            <div class="cell"></div>
            <div class="cell"></div>
            <div class="cell"></div>
            <div class="cell"></div>
            <div class="cell"></div>

        </div>
    }

</div>

    </div>

</div>


@code {
    List<BatchSimulationRow> data = new();
    Dictionary<int, List<TaskDto>> tasksByBatch = new();
    Dictionary<int, GanttSimulationService.DetailResult> detailResults = new();
    List<BatchSimulationRow> ordered = new();
    List<TaskDto> allTasks = new();
    protected override async Task OnInitializedAsync()
    {
        
        data = await Http.GetFromJsonAsync<List<BatchSimulationRow>>("api/batches/list-production") ?? new();
        
    foreach (var row in data)
    {
        var tasks = await Http.GetFromJsonAsync<List<TaskDto>>(
            $"api/production/gantt?batchProductId={row.BatchProductId}"
        );

        tasksByBatch[row.BatchProductId] = tasks ?? new();

        if (tasks != null)
            allTasks.AddRange(tasks);
    }

        ordered = data
            .OrderByDescending(x => x.IsPriority)
            .ThenBy(x => x.Priority)
            .ToList();
        
        var allTasksOrdered = allTasks
            .OrderBy(t => t.BatchProductId)
            .ThenBy(t => t.StepOrder)
            .ToList();

var allDetails = await Service.CalculateDetailGlobal(allTasksOrdered, ordered);

foreach (var kvp in allDetails)
{
    detailResults[kvp.Key] = kvp.Value;
}

// TESTS — globālā secība (tikai pārbaudei)
var debugOrder = allTasksOrdered
    .Select(t => $"BP:{t.BatchProductId} Step:{t.StepOrder}")
    .ToList();

foreach (var line in debugOrder)
{
    Console.WriteLine(line);
}

// grupējam step pa batch (lai kontrolētu secību)
var stepsByBatch = allTasksOrdered
    .GroupBy(t => t.BatchProductId)
    .ToDictionary(g => g.Key, g => g.OrderBy(x => x.StepOrder).ToList());

// katram batch sekosim līdzi kurš step ir nākamais
var batchPointers = stepsByBatch
    .ToDictionary(k => k.Key, v => 0);

// paņemam pirmo pieejamo step no katra batch
var availableSteps = new List<TaskDto>();

foreach (var kvp in stepsByBatch)
{
    var batchId = kvp.Key;
    var steps = kvp.Value;

    if (steps.Count > 0)
    {
        availableSteps.Add(steps[0]);
    }
}

// sakārtojam pēc StepOrder (mazākais = pirmais)
availableSteps = availableSteps
    .OrderBy(t => t.StepOrder)
    .ThenBy(t => t.BatchProductId)
    .ToList();

// DEBUG — kādi darbi ir pieejami startam
foreach (var step in availableSteps)
{
    Console.WriteLine($"QUEUE -> BP:{step.BatchProductId} Step:{step.StepOrder}");
}

    }

    public int DetailedInProgress { get; set; }
    public int DetailedFinish { get; set; }
}