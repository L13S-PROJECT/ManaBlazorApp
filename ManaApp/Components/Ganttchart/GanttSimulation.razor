@*GanttSimulation.razor - laika simulācijas kopsavilkums*@

@using ManaApp.Services
@inject HttpClient Http
@inject GanttSimulationService Service
@using System.Text.RegularExpressions

<div class="simulation-table" @onclick="ClosePopup">
<div class="simulation-toolbar">

    <div class="search-box">
        <input type="text"
               placeholder="Meklēt..."
               value="@searchText"
               @oninput="OnSearchInput" />

        @if (!string.IsNullOrWhiteSpace(searchText))
        {
            <button class="clear-btn" @onclick="ClearSearch">✖</button>
        }
    </div>

    <label>Detail:</label>
        <select @bind="selectedDetailStatus">
            <option value="">Visi</option>
            <option value="Nav iesākts">Nav iesākts</option>
            <option value="Procesā">Procesā</option>
            <option value="Pabeigts">Pabeigts</option>
        </select>

<label>Assembly:</label>
    <select @bind="selectedAssemblyStatus">
        <option value="">Visi</option>
        <option value="Gaida">Gaida</option>
        <option value="Procesā">Procesā</option>
        <option value="Pabeigts">Pabeigts</option>
    </select>

<label>Finishing:</label>
    <select @bind="selectedFinishingStatus">
        <option value="">Visi</option>
        <option value="Procesā">Procesā</option>
        <option value="Pabeigts">Pabeigts</option>
    </select>

    <div class="archive-switch">
        <span>Arhīvs</span>
        <label class="switch">
            <input type="checkbox" @bind="showArchive" />
            <span class="slider"></span>
        </label>
    </div>

</div>

    <div class="simulation-header">

    <div class="header-row top">

        <div class="cell info" style="grid-column: span 5;">Informācija par preci</div>

        <div class="cell detail" style="grid-column: span 3;">Detail</div>

        <div class="cell assembly" style="grid-column: span 2;">Assembly</div>

        <div class="cell finishing" style="grid-column: span 6;">Finishing</div>

    </div>
    
        <div class="header-row bottom header-bottom">
            <div class="cell">Batch</div>
            <div class="cell">Nosaukums</div>
            <div class="cell">Kods</div>
            <div class="cell">Versija</div>
            <div class="cell">Apjoms</div>

            <div class="cell">Status</div>
            <div class="cell">Neiesākti</div>
            <div class="cell">Laiks</div>

            <div class="cell">Status</div>
            <div class="cell">Laiks</div>

            <div class="cell">Nekrāsoti</div>
            <div class="cell">Laiks</div>
            <div class="cell">Status</div>
            <div class="cell">Apjoms</div>
            <div class="cell">Laiks</div>
            <div class="cell">Pabeigti</div>
        </div>

        <div class="simulation-body">

@{
    var filteredRows = mergedOrdered.Where(r =>
    {
        var resultKey = allTasks
            .Where(t => t.BatchProductId == r.BatchProductId)
            .Select(t => t.ParentBatchId ?? t.BatchProductId)
            .FirstOrDefault();

        return detailResults.ContainsKey(resultKey)

        &&
        (
            showArchive
                ? true
                : !(detailResults[resultKey].FinishingStatus == "Pabeigts"
                    && (detailResults[resultKey].FinishingAvailableQty ?? 0) == 0)
        )
        &&
        (
            string.IsNullOrWhiteSpace(searchText) ||
            (r.ProductName != null && r.ProductName.Contains(searchText, StringComparison.OrdinalIgnoreCase)) ||
            (r.ProductCode != null && r.ProductCode.Contains(searchText, StringComparison.OrdinalIgnoreCase)) ||
            (r.BatchCode != null && r.BatchCode.Contains(searchText, StringComparison.OrdinalIgnoreCase))
        )
        &&
        (
            string.IsNullOrWhiteSpace(selectedDetailStatus) ||
            detailResults[resultKey].Status == selectedDetailStatus
        )
        &&
        (
            string.IsNullOrWhiteSpace(selectedAssemblyStatus) ||
            detailResults[resultKey].AssemblyStatus == selectedAssemblyStatus
        )
        &&
        (
            string.IsNullOrWhiteSpace(selectedFinishingStatus) ||
            detailResults[resultKey].FinishingStatus == selectedFinishingStatus
        );
    }).ToList();
}

@foreach (var row in filteredRows)
{
    
        var resultKey = allTasks
            .Where(t => t.BatchProductId == row.BatchProductId)
            .Select(t => t.ParentBatchId ?? t.BatchProductId)
            .FirstOrDefault();

        var detail = detailResults.ContainsKey(resultKey)
            ? detailResults[resultKey]
            : new GanttSimulationService.DetailResult();
    

    <div class="data-row 
        @(IsFinished(detail) ? "text-gray" : "")
            @(openedBatchId == row.BatchProductId ? "row-active" : "")">

            <div class="cell">@Highlight(row.BatchCode)</div>
            <div class="cell product-cell">
                @{
                    var key = $"{row.BatchId}_{row.VersionId}";
                    var flag = batchFlags.ContainsKey(key) ? batchFlags[key] : "";
                }

                <span class="product-name"
                    title="@row.ProductName">
                    @Highlight(row.ProductName)
                </span>

                @if (flag == "+")
                {
                    <span class="text-blue">+</span>
                }
                else if (flag == "!")
                {
                    var partName = allTasks
                        .Where(t => t.BatchProductId == row.BatchProductId && t.StepType == 1)
                        .Select(t => t.PartName)
                        .FirstOrDefault() ?? "-";

                    <span class="detail-part" title="@partName">
                        @partName
                    </span>
                }
            </div>
            <div class="cell">@Highlight(row.ProductCode)</div>
            <div class="cell">@row.VersionName</div>
            <div class="cell">@row.Planned</div>



        <div class="cell">@detail.Status</div>
    
        <div class="cell text-gray">
            @(detail.NotStartedText ?? "-")
        </div>

        <div class="cell @GetDetailClass(detail)">
            @(detail.FinishDateText ?? "-")
        </div>

<!-- Assembly posms -->
        <div class="cell">
            @(detail.AssemblyStatus ?? "-")
        </div>
        <div class="cell @GetAssemblyClass(detail)">
            @(detail.AssemblyTimeText ?? "-")
        </div>

<!-- Finishing posms -->

            <div class="cell">
                @(detail.FinishingAvailableQty > 0 
                    ? detail.FinishingAvailableQty 
                    : "-")

                <div class="info-wrapper">

    <button class="info-btn"
        @onclick="(e) => TogglePopup(row.BatchProductId, e)"
        @onclick:stopPropagation>
        ℹ️
    </button>

    @if (openedBatchId == row.BatchProductId)
    {
        <div class="finishing-popup"
                @onclick:stopPropagation
             style="top:@(popupY + 10)px; left:@(popupX + 10)px;">

            <div class="popup-card">

                <div class="popup-header">
                    <b>Finishing info</b>
                    <button class="close-btn" @onclick="() => openedBatchId = null">✖</button>
                </div>

                <div class="popup-row">
                    <span>Plānots:</span>
                    <b>@detail.PlannedQty</b>
                </div>

                <div class="popup-row">
                    <span>Nekrāsoti:</span>
                    <b>@(detail.FinishingAvailableQty ?? 0)</b>
                </div>

                <div class="popup-section">
                    <b>Krāsošanā:</b>
                </div>

                @foreach (var t in tasksByBatch[row.BatchProductId]
                    .Where(t => t.StepType == 3 && t.QtyDone > 0)
                    .OrderBy(t => t.Status == 1 ? 0 : t.Status == 2 ? 1 : 2))
                {
                    <div class="popup-row small grid">
                        <span class="col-qty">@t.QtyDone gb</span>
                        <span class="col-ral">@t.RalColorName</span>
                        <span class="col-status">
                            @(t.Status == 1 ? "Gaida" :
                            t.Status == 2 ? "Procesā" :
                            t.Status == 3 ? "Pabeigts" : "-")
                        </span>
                    </div>
                }

            </div>
        </div>
    }
    

</div>
            </div>
            <div class="cell text-gray">
                @(detail.FinishingRemainingTimeText ?? "-")
            </div>

            <div class="cell">
                @(detail.FinishingStatus ?? "-")
            </div>

            <div class="cell">
                @(detail.FinishingInProgressQty > 0 
                    ? detail.FinishingInProgressQty 
                    : "-")
            </div>

            <div class="cell @GetFinishingClass(detail)">
                @(detail.FinishingTimeText ?? "-")
            </div>
            <div class="cell">
                @(detail.FinishingDoneQty > 0 
                    ? detail.FinishingDoneQty 
                    : "-")
            </div>

        </div>

    }

</div>

    </div>

</div>

@code {
    List<BatchSimulationRow> data = new();
    Dictionary<int, List<TaskDto>> tasksByBatch = new();
    Dictionary<int, GanttSimulationService.DetailResult> detailResults = new();
    List<BatchSimulationRow> ordered = new();
    Dictionary<int, bool> parentHasChildMap = new();
    List<BatchSimulationRow> mergedOrdered = new();
    private Dictionary<string, string> batchFlags = new();
    List<TaskDto> allTasks = new();
    protected override async Task OnInitializedAsync()
    {
        var flags = await Http.GetFromJsonAsync<Dictionary<string, string>>("api/batches/batch-flags");

            if (flags != null)
                batchFlags = flags;

        data = await Http.GetFromJsonAsync<List<BatchSimulationRow>>("api/batches/list-production") ?? new();
        
    var allTasksFromApi = await Http.GetFromJsonAsync<List<TaskDto>>("api/production/gantt");

        allTasks = allTasksFromApi ?? new List<TaskDto>();

        tasksByBatch = allTasks
            .GroupBy(t => t.BatchProductId)
            .ToDictionary(g => g.Key, g => g.ToList());

        ordered = data
            .Where(x =>
                    {
                        var key = $"{x.BatchId}_{x.VersionId}";
                        var flag = batchFlags.ContainsKey(key) ? batchFlags[key] : "";

                        
                        var hasParent = allTasks.Any(t =>
                            t.BatchProductId == x.BatchProductId &&
                            t.ParentBatchId.HasValue);

                        if (flag == "!" && hasParent)
                            return false;

                        return true;
                    })
            .OrderByDescending(x => x.IsPriority)
            .ThenBy(x => x.Priority)
            .ToList();

mergedOrdered = ordered
    .GroupBy(r => new { r.BatchId, r.VersionId })
    .Select(g =>
            {
                var parent = g.FirstOrDefault(x =>
                {
                    var key = $"{x.BatchId}_{x.VersionId}";
                    return batchFlags.ContainsKey(key) && batchFlags[key] == "+";
                });

        var children = g.Where(x =>
            {
                var key = $"{x.BatchId}_{x.VersionId}";
                return batchFlags.ContainsKey(key) && batchFlags[key] == "!";
            }).ToList();

        //  tikai child (nav parent)
        if (parent == null)
            return g.First();

        //  parent + child → MERGE
        if (children.Any())
        {
            parent.Planned = children.Sum(x => x.Planned);
            return parent;
        }

        //  tikai parent
        return parent;
    })
    .ToList();
        
var allTasksOrdered = allTasks
    .OrderByDescending(t => t.IsPriority)
    .ThenBy(t => t.Priority)
    .ThenBy(t => t.BatchProductId)
    .ThenBy(t => t.StepOrder)
    .ToList();

var tasksByParent = allTasksOrdered
    .GroupBy(t => t.ParentBatchId ?? t.BatchProductId)
    .ToDictionary(g => g.Key, g => g.ToList());

var mergedTasks = new List<TaskDto>();

foreach (var group in tasksByParent.Values)
{
    var hasParent = group.Any(t => t.ParentBatchId == null);
    var hasChild = group.Any(t => t.ParentBatchId != null);

    // 1) tikai Parent
    if (hasParent && !hasChild)
    {
        mergedTasks.AddRange(group);
        continue;
    }

    // 2) tikai Child
    if (!hasParent && hasChild)
    {
        mergedTasks.AddRange(group.Where(t => t.StepType == 1));
        continue;
    }

    // 3) Parent + Child
    foreach (var t in group)
    {
        // DETAIL → parent + child
        if (t.StepType == 1)
        {
            mergedTasks.Add(t);
            continue;
        }

        // Assembly + Finishing → tikai parent
        if ((t.StepType == 2 || t.StepType == 3) && t.ParentBatchId == null)
        {
            mergedTasks.Add(t);
        }
    }
}

mergedTasks = mergedTasks
    .Where(t => t.BatchProductId > 0)
    .ToList();

var filteredOrdered = ordered
    .Where(o => o.BatchProductId > 0) // 🚨 aizsardzība pret 0
    .Where(o =>
        mergedTasks.Any(t => t.BatchProductId == o.BatchProductId)
    )
    .ToList();

filteredOrdered = filteredOrdered
    .Where(x => x.BatchProductId > 0)
    .ToList();

var allDetails = await Service.CalculateDetailGlobal(mergedTasks, filteredOrdered);

foreach (var kvp in allDetails)
{
    detailResults[kvp.Key] = kvp.Value;
}

parentHasChildMap = allTasks
    .Where(t => t.ParentBatchId.HasValue)
    .GroupBy(t => t.ParentBatchId!.Value)
    .ToDictionary(g => g.Key, g => true);

// TESTS — globālā secība (tikai pārbaudei)
var debugOrder = allTasksOrdered
    .Select(t => $"BP:{t.BatchProductId} Step:{t.StepOrder}")
    .ToList();

// grupējam step pa batch (lai kontrolētu secību)
var stepsByBatch = allTasksOrdered
    .GroupBy(t => t.BatchProductId)
    .ToDictionary(g => g.Key, g => g.OrderBy(x => x.StepOrder).ToList());

// katram batch sekosim līdzi kurš step ir nākamais
var batchPointers = stepsByBatch
    .ToDictionary(k => k.Key, v => 0);

// paņemam pirmo pieejamo step no katra batch
var availableSteps = new List<TaskDto>();

foreach (var kvp in stepsByBatch)
{
    var batchId = kvp.Key;
    var steps = kvp.Value;

    if (steps.Count > 0)
    {
        availableSteps.Add(steps[0]);
    }
}

// sakārtojam pēc StepOrder (mazākais = pirmais)
availableSteps = availableSteps
    .OrderBy(t => t.StepOrder)
    .ThenBy(t => t.BatchProductId)
    .ToList();

    }
private string GetAssemblyClass(GanttSimulationService.DetailResult detail)
{
    // 🔘 pelēks – ja Detail vēl ir 5 (rāda tikai ilgumu)
    if (detail.HasDetailNotStarted)
        return "text-gray";

    // 🟡 dzeltena – Detail pabeigts, Assembly nav pabeigts
    if (detail.Status == "Pabeigts" && detail.AssemblyStatus != "Pabeigts")
        return "bg-yellow";

    // 🟢 zaļš – Assembly pabeigts
    if (detail.AssemblyStatus == "Pabeigts")
        return "bg-green";

    // ⚫ default
    return "";
}
    public int DetailedInProgress { get; set; }
    public int DetailedFinish { get; set; }

int? openedBatchId = null;
double popupX, popupY;

void TogglePopup(int batchId, MouseEventArgs e)
{
    if (openedBatchId == batchId)
    {
        openedBatchId = null;
        return;
    }

    openedBatchId = batchId;

    popupX = e.ClientX;
    popupY = e.ClientY;
}

private string GetDetailClass(GanttSimulationService.DetailResult detail)
{
    if (detail.Status == "Pabeigts")
        return "bg-green";

    if (detail.Status == "Procesā")
        return "bg-yellow";

    return "";
}

private string GetFinishingClass(GanttSimulationService.DetailResult detail)
{
    // 1) Procesā (status 1/2)
    if (detail.FinishingStatus == "Procesā")
        return "bg-yellow";

    // 2) Pabeigts, bet vēl ir atlikums (nekrāsoti)
    if (detail.FinishingStatus == "Pabeigts" && (detail.FinishingAvailableQty ?? 0) > 0)
        return "bg-blue";

    // 3) Viss pabeigts
    if (detail.FinishingStatus == "Pabeigts" && (detail.FinishingAvailableQty ?? 0) == 0)
        return "bg-green";

    return "";
}

void ClearSearch()
{
    debounceCts?.Cancel();
    searchText = "";
}

private MarkupString Highlight(string? text)
{
    if (string.IsNullOrWhiteSpace(searchText) || string.IsNullOrWhiteSpace(text))
        return (MarkupString)(text ?? "");

    var pattern = Regex.Escape(searchText);

    var result = Regex.Replace(
        text,
        pattern,
        match => $"<span class='highlight'>{match.Value}</span>",
        RegexOptions.IgnoreCase
    );

    return (MarkupString)result;
}

string searchText = "";
CancellationTokenSource? debounceCts;

async Task OnSearchInput(ChangeEventArgs e)
{
    debounceCts?.Cancel();
    debounceCts = new CancellationTokenSource();

    try
    {
        await Task.Delay(300, debounceCts.Token); // 300ms debounce
        searchText = e.Value?.ToString() ?? "";
        StateHasChanged();
    }
    catch (TaskCanceledException)
    {
        // ignorējam
    }
}

string selectedStatus = "";

string selectedDetailStatus = "";
string selectedAssemblyStatus = "";
string selectedFinishingStatus = "";

void ClearAllFilters()
{
    searchText = "";
    selectedDetailStatus = "";
    selectedAssemblyStatus = "";
    selectedFinishingStatus = "";
}

bool showArchive = false;

bool IsFinished(GanttSimulationService.DetailResult detail)
{
    return detail.FinishingStatus == "Pabeigts"
        && (detail.FinishingAvailableQty ?? 0) == 0;
}

void ClosePopup()
{
    openedBatchId = null;
}

}