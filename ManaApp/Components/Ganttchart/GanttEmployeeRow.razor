@*Gantt Employee Row Component - darbinieku saraksts*@

@using ManaApp.Models

<div class="gantt-row">

    <!-- LEFT -->
    <div class="gantt-left">
        @EmployeeName
    </div>

    <!-- RIGHT -->
    <div class="gantt-right">

        @for (int d = 0; d < Days; d++)
        {
            <div class="gantt-cell">
            </div>
        }

    </div>

</div>

@code {

[Parameter]
public int? EmployeeId { get; set; }

[Parameter]
public string? EmployeeName { get; set; }

[Parameter]
public List<GanttRow>? Tasks { get; set; }
[Parameter]
public int? WorkCenterId { get; set; }

[Parameter]
public int Days { get; set; } = 31;

}