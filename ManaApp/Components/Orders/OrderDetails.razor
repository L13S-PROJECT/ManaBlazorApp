@* OrderDetails.razor  *@

@inject HttpClient Http
@using Microsoft.AspNetCore.Components

<div class="order-details-container">

    <div class="order-details-header">
        <h3>Pasūtījuma detalizācija</h3>
    </div>

    <div class="order-details-table-wrapper">

    <table class="order-details-table">

            <thead>
                <tr>
                    <th>Nr.</th>
                    <th>+</th>
                    <th>Nosaukums</th>
                    <th>Kods</th>
                    <th>Versija</th>
                    <th>Veids</th>
                    <th>Detaļa</th>
                    <th>RAL</th>
                    <th>Kl.kods</th>
                    <th>Pas.apj.</th>
                    <th>Izdots</th>
                    <th>Atl.</th>
                    <th>Stock</th>
                    <th>Izpild.</th>
                </tr>
            </thead>

            <tbody>

    @foreach (var item in items)
    {
        <tr>

            <td>@item.Id</td>

            <td>
                <button class="dispatch-add-button">+</button>
            </td>

            <td>@item.Name</td>

            <td>@item.ProductCode</td>

            <td>@item.VersionName</td>

            <td>@item.ItemType</td>

            <td>@item.TopPartName</td>

            <td>@item.RalName</td>

            <td>@item.CustomerCode</td>

            <td>@item.Quantity</td>

            <td>0</td>

            <td>@item.Quantity</td>

            <td>0</td>

            <td>Nē</td>

        </tr>
    }

</tbody>

        </table>

    </div>

</div>

@code {

    [Parameter]
    public int? OrderId { get; set; }

    private List<OrderItemRow> items = new();

    public class OrderItemRow
    {
        public int Id { get; set; }

        public string CustomerCode { get; set; } = "";

        public string Name { get; set; } = "";

        public int Quantity { get; set; }
        public string? VersionName { get; set; }
        public string ProductCode { get; set; } = "";
        public string ItemType { get; set; } = "";
        public string TopPartName { get; set; } = "";
        public string RalName { get; set; } = "";
    }

    protected override async Task OnParametersSetAsync()
    {
        if (OrderId is null)
        {
            items.Clear();
            return;
        }

        items = await Http.GetFromJsonAsync<List<OrderItemRow>>(
            $"http://localhost:5270/api/orders/{OrderId}/items")
            ?? new();
    }

}