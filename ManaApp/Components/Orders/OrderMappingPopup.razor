@using ManaApp.Models.Orders
@using System.Linq
@inject HttpClient Http
@inject IJSRuntime JS

@if (IsVisible && Item is not null)
{
    <div class="mapping-overlay">

        <div class="mapping-popup">

        <h3 class="mapping-title">
            Kodu salāgošana
        </h3>
        <div class="mapping-scroll">

        @if (Item?.VersionId is not null)
                {
                    <div class="mapping-suggestion-box">

                        Atrasts iepriekšējais mapping —
                        pārbaudi un apstiprini.

                    </div>
                }
            
            @if (Item?.VersionId is null)
                {
                    <div class="mapping-warning">

                        Mapping nav atrasts —
                        izvēlies produktu vai izveido arhivētu versiju.

                    </div>
                }
                    <button
                        type="button"
                        class="mapping-create-version-btn"
                        @onclick="CreateHistoricalVersion">

                        Izveidot arhivētu versiju

                    </button>
                @if (
                        (selectedVersionId is not null &&
                            Versions.Any(x =>
                                x.VersionId == selectedVersionId &&
                                !x.VersionIsActive))
                        ||
                        (selectedProductId is not null &&
                            Products.Any(x =>
                                x.ProductId == selectedProductId &&
                                !x.VersionIsActive))
                    )
                {
                    <div class="mapping-archived-warning">

                        Versija ir arhivēta —
                        pārbaudi!

                    </div>
                }

        <div class="mapping-info-row">
            <div class="mapping-label">
                Kods
            </div>

            <div class="mapping-value">
                @Item!.CustomerCode
            </div>
     </div>

    <div class="mapping-info-row">
        <div class="mapping-label">
            Nosaukums
        </div>

        <div class="mapping-name">
            @Item.Name
        </div>
    </div>

        <div style="margin-top:20px;">

@*Produkta drop-down *@

        <div class="mapping-field">

            <label class="mapping-field-label">
                Veids
            </label>

            <div class="custom-dropdown
                @(showValidationErrors && selectedParentCategoryId is null
                    ? "validation-error"
                    : "")">

    <div
        class="custom-dropdown-selected
        @(selectedParentCategoryId is not null ? "selected" : "")
        @(showParentDropdown ? "open" : "")"
        @onclick="ToggleParentDropdown">

        @(selectedParentCategoryId is null
            ? "Izvēlies veidu"
            : SelectedParentName)

    </div>

    @if (showParentDropdown)
    {
        <div class="custom-dropdown-menu">

            @foreach (var p in MappingList
                .GroupBy(x => x.ParentCategoryId)
                .Select(g => g.First())
                .OrderBy(x => x.ParentCategoryName))
            {
                <div
                    class="custom-dropdown-item"
                    @onclick="() => SelectParentCategory(p.ParentCategoryId, p.ParentCategoryName)">

                    @p.ParentCategoryName

                </div>
            }

        </div>
    }

</div>

</div>

            <div class="mapping-field">

    <label class="mapping-field-label">
        Kategorija
    </label>

    <div class="custom-dropdown
        @(showValidationErrors && selectedCategoryId is null
            ? "validation-error"
            : "")">

        <div
            class="custom-dropdown-selected
            @(selectedCategoryId is not null ? "selected" : "")
            @(showCategoryDropdown ? "open" : "")"
            @onclick="ToggleCategoryDropdown">

            @(selectedCategoryId is null
                ? "Izvēlies kategoriju"
                : SelectedCategoryName)

        </div>

        @if (showCategoryDropdown)
        {
            <div class="custom-dropdown-menu">

                @foreach (var c in Categories)
                {
                    <div
                        class="custom-dropdown-item"
                        @onclick="() => SelectCategory(c.CategoryId, c.CategoryName)">

                        @c.CategoryName

                    </div>
                }

            </div>
        }

    </div>

</div>



     <div class="mapping-field">

    <label class="mapping-field-label">
        Prece
    </label>

    <div class="custom-dropdown
        @(showValidationErrors && selectedProductId is null
            ? "validation-error"
            : "")">

        <div
            class="custom-dropdown-selected
            @(selectedProductId is not null ? "selected" : "")
            @(showProductDropdown ? "open" : "")"
            @onclick="ToggleProductDropdown">

            @(selectedProductId is null
                ? "Izvēlies preci"
                : SelectedProductName)

        </div>

        @if (showProductDropdown)
        {
            <div class="custom-dropdown-menu">

                @foreach (var p in Products)
                {
                    <div
                        class="custom-dropdown-item"
                        @onclick="() => SelectProduct(p.ProductId, p.ProductName)">

                        @(p.VersionIsActive
                            ? p.ProductName
                            : $"{p.ProductName} [ARHIVĒTS]")

                    </div>
                }

            </div>
        }

    </div>

</div>
</div>

@if (showValidationErrors && !isProduct && !isPart)
{
    <div class="mapping-checkbox-warning">

        Izvēlies veidu

    </div>
}

<div class="mapping-checkbox-row
@(showValidationErrors && !isProduct && !isPart
    ? "checkbox-validation-error"
    : "")">

    <label class="mapping-checkbox-label">

        <input
            type="checkbox"
            checked="@isProduct"
            @onchange="e => ToggleProduct((bool)e.Value!)" />

        Produkts

    </label>

    <label class="mapping-checkbox-label">

        <input
            type="checkbox"
            checked="@isPart"
            @onchange="e => TogglePart((bool)e.Value!)" />

        Detaļa

    </label>

</div>

                <div class="mapping-field">

    <label class="mapping-field-label">
        Versija
    </label>

    <div class="custom-dropdown
        @(showValidationErrors && selectedVersionId is null
            ? "validation-error"
            : "")">

        <div
            class="custom-dropdown-selected
            @(selectedVersionId is not null ? "selected" : "")
            @(showVersionDropdown ? "open" : "")"
            @onclick="ToggleVersionDropdown">

            @(selectedVersionId is null
                ? "Izvēlies versiju"
                : SelectedVersionName)

        </div>

        @if (showVersionDropdown)
        {
            <div class="custom-dropdown-menu">

                @foreach (var v in Versions)
                {
                    <div
                        class="custom-dropdown-item"
                        @onclick="() => SelectVersion(v.VersionId, v.VersionName)">

                        @(v.VersionIsActive
                            ? v.VersionName
                            : $"{v.VersionName} [ARCHIVED]")

                    </div>
                }

            </div>
        }

    </div>

</div>

                @if (isPart)
{
    <div class="mapping-field">

    <label class="mapping-field-label">
        Detaļa
    </label>

    @if (selectedVersionId is not null &&
         !stage1Parts.Any())
    {
        <div class="mapping-warning">

            Izvēlētajai versijai nav pievienota neviena detaļa.
            
        </div>
    }

    <div class="custom-dropdown
        @(showValidationErrors && selectedProductToPartId is null
            ? "validation-error"
            : "")">

        <div
            class="custom-dropdown-selected
            @(selectedProductToPartId is not null ? "selected" : "")
            @(showTopPartDropdown ? "open" : "")"
            @onclick="ToggleTopPartDropdown">

            @(selectedProductToPartId is null
                ? "Izvēlies TopPart"
                : SelectedTopPartName)

        </div>

        @if (showTopPartDropdown)
        {
            <div class="custom-dropdown-menu">

                @foreach (var p in stage1Parts)
                {
                    <div
                        class="custom-dropdown-item"
                        @onclick="() => SelectTopPart(p.Id, p.TopPartName, p.TopPartId)">

                        @p.TopPartName

                    </div>
                }

            </div>
        }

    </div>

</div>
}

       
                <div class="mapping-field">

    <label class="mapping-field-label">
        RAL krāsa
    </label>

    <div class="custom-dropdown
        @(showValidationErrors && selectedRalColorId is null
            ? "validation-error"
            : "")">

        <div
            class="custom-dropdown-selected
            @(selectedRalColorId is not null ? "selected" : "")
            @(showRalDropdown ? "open" : "")"
            @onclick="ToggleRalDropdown">

            @(selectedRalColorId is null
                ? "Izvēlies RAL"
                : SelectedRalName)

        </div>

        @if (showRalDropdown)
        {
            <div class="custom-dropdown-menu">

                @foreach (var r in ralColors)
                {
                    <div
                        class="custom-dropdown-item"
                        @onclick="() => SelectRal(r.Id, r.Name)">

                        @r.Name

                    </div>
                }

            </div>
        }

    </div>

</div>

                @if (showValidationErrors && HasValidationErrors)
                        {
                            <div class="mapping-warning">

                                Aizpildi visus obligātos laukus.

                            </div>
                        }
                
                @if (!string.IsNullOrWhiteSpace(validationMessage))
                    {
                        <div class="mapping-warning">

                            @validationMessage

                        </div>
                    }

<div class="mapping-button-row">

    <button
        class="mapping-save-button"
        @onclick="SaveMapping">

        SAGLABĀT

    </button>

    <button
        class="mapping-close-button"
        @onclick="Close">

        AIZVĒRT

    </button>

</div>
</div>
    </div>
</div>
}

@code {

    [Parameter]
    public bool IsVisible { get; set; }

    [Parameter]
    public OrderDraftItemViewModel? Item { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }
    [Parameter]
    public EventCallback OnSaved { get; set; }
    [Parameter]
    public List<MappingListItem> MappingList { get; set; } = new();
    
    List<Stage1PartItem> stage1Parts = new();
    List<RalColor> ralColors = new();

    [Parameter]
    public EventCallback<int> OnCreateHistoricalVersion { get; set; }
    OrderDraftItemViewModel? previousItem;

bool showValidationErrors;
int? selectedRalColorId;
bool showParentDropdown;

string SelectedParentName = "";

bool showCategoryDropdown;

string SelectedCategoryName = "";
bool showProductDropdown;

string SelectedProductName = "";
bool showVersionDropdown;

string SelectedVersionName = "";
bool showRalDropdown;

string SelectedRalName = "";

bool showTopPartDropdown;

void CloseAllDropdowns()
{
    showParentDropdown = false;
    showCategoryDropdown = false;
    showProductDropdown = false;
    showVersionDropdown = false;
    showRalDropdown = false;
    showTopPartDropdown = false;
}

string SelectedTopPartName = "";

bool HasValidationErrors =>
    selectedParentCategoryId is null ||
    selectedCategoryId is null ||
    selectedProductId is null ||
    selectedVersionId is null ||
    selectedRalColorId is null ||
    (!isProduct && !isPart) ||
    (isPart && selectedProductToPartId is null);


    int? selectedProductToPartId;
    int? selectedTopPartId;
    async Task Close()
    {
        await OnClose.InvokeAsync();
    }

    int? selectedParentCategoryId;
    int? selectedCategoryId;
    int? selectedProductId;
    int? selectedVersionId;
    bool isProduct;
    bool isPart;

    string? validationMessage;

    void ResetFromCategory()
{
    selectedProductId = null;
    selectedVersionId = null;

    selectedProductToPartId = null;
    selectedTopPartId = null;
    selectedRalColorId = null;

    stage1Parts.Clear();

    validationMessage = null;
}

void ResetFromProduct()
{
    selectedVersionId = null;

    selectedProductToPartId = null;
    selectedTopPartId = null;
    selectedRalColorId = null;

    stage1Parts.Clear();

    validationMessage = null;
}

void ResetFromVersion()
{
    selectedProductToPartId = null;
    selectedTopPartId = null;
    selectedRalColorId = null;

    validationMessage = null;
}

    IEnumerable<MappingListItem> Categories =>
    MappingList
        .Where(x => x.ParentCategoryId == selectedParentCategoryId)
        .GroupBy(x => x.CategoryId)
        .Select(g => g.First())
        .OrderBy(x => x.CategoryName);

    IEnumerable<MappingListItem> Products =>
    MappingList
        .Where(x => x.CategoryId == selectedCategoryId)
        .GroupBy(x => x.ProductId)
        .Select(g => g.First())
        .OrderBy(x => x.ProductName);
    
    IEnumerable<MappingListItem> Versions =>
    MappingList
        .Where(x => x.ProductId == selectedProductId)
        .OrderByDescending(x => x.VersionIsActive)
        .ThenByDescending(x => x.VersionName);

    void ToggleProduct(bool value)
        {
            isProduct = value;

            if (value)
            {
                isPart = false;
                ResetFromProduct();
            }
        }

void TogglePart(bool value)
        {
            isPart = value;

            if (value)
            {
                isProduct = false;
                ResetFromProduct();
            }
        }

void ToggleParentDropdown()
{
    var wasOpen = showParentDropdown;

    CloseAllDropdowns();

    showParentDropdown = !wasOpen;
}

void SelectParentCategory(int id, string name)
{
    selectedParentCategoryId = id;

    SelectedParentName = name;

    showParentDropdown = false;

    selectedCategoryId = null;
    selectedProductId = null;
    selectedVersionId = null;

    SelectedCategoryName = "";
    SelectedProductName = "";

    selectedProductToPartId = null;
    selectedTopPartId = null;
    selectedRalColorId = null;

    stage1Parts.Clear();

    validationMessage = null;
}

void ToggleCategoryDropdown()
{
    var wasOpen = showCategoryDropdown;

CloseAllDropdowns();

    showCategoryDropdown = !wasOpen;
}

void SelectCategory(int id, string name)
{
    selectedCategoryId = id;

    SelectedCategoryName = name;

    showCategoryDropdown = false;

    selectedProductId = null;
    selectedVersionId = null;

    SelectedProductName = "";

    selectedProductToPartId = null;
    selectedTopPartId = null;
    selectedRalColorId = null;

    stage1Parts.Clear();

    validationMessage = null;
}

void ToggleProductDropdown()
{
    var wasOpen = showProductDropdown;

CloseAllDropdowns();

    showProductDropdown = !wasOpen;
}

void SelectProduct(int id, string name)
{
    selectedProductId = id;

    var selected = Products
    .FirstOrDefault(x => x.ProductId == id);

        SelectedProductName =
            selected is not null && !selected.VersionIsActive
                ? $"{name} [ARHIVĒTS]"
                : name;

    showProductDropdown = false;

    ResetFromProduct();
}
void ToggleVersionDropdown()
{
    var wasOpen = showVersionDropdown;

    CloseAllDropdowns();

    showVersionDropdown = !wasOpen;
}

async Task SelectVersion(int id, string name)
{
    selectedVersionId = id;

    SelectedVersionName = name;

    showVersionDropdown = false;

    ResetFromVersion();

    await LoadStage1Parts();
}

void ToggleRalDropdown()
{
    var wasOpen = showRalDropdown;

    CloseAllDropdowns();

    showRalDropdown = !wasOpen;
}

void SelectRal(int id, string name)
{
    selectedRalColorId = id;

    SelectedRalName = name;

    showRalDropdown = false;
}

void ToggleTopPartDropdown()
{
    var wasOpen = showTopPartDropdown;

    CloseAllDropdowns();

    showTopPartDropdown = !wasOpen;
}

void SelectTopPart(
    int id,
    string name,
    int topPartId)
{
    selectedProductToPartId = id;

    selectedTopPartId = topPartId;

    SelectedTopPartName = name;

    showTopPartDropdown = false;
}

async Task LoadStage1Parts()
{
    if (selectedVersionId is null)
    {
        stage1Parts.Clear();
        return;
    }

    stage1Parts = await Http.GetFromJsonAsync<List<Stage1PartItem>>(
        $"http://localhost:5270/api/products/details-stage1?versionId={selectedVersionId}")
        ?? new();
}
void OnTopPartChanged()
{
    var selected = stage1Parts
        .FirstOrDefault(x => x.Id == selectedProductToPartId);

    selectedTopPartId = selected?.TopPartId;
}

protected override async Task OnInitializedAsync()
{
    ralColors = await Http.GetFromJsonAsync<List<RalColor>>(
        "http://localhost:5270/api/products/ral-list")
        ?? new();
}

async Task SaveMapping()
{
    showValidationErrors = true;

if (selectedParentCategoryId is null ||
    selectedCategoryId is null ||
    selectedProductId is null ||
    selectedVersionId is null ||
    selectedRalColorId is null ||
    (!isProduct && !isPart))
{
    return;
}

if (isPart && selectedProductToPartId is null)
{
    validationMessage =
        "Part mapping requires TopPart selection.";

    return;
}

var dto = new
{
    OrderDraftItemId = Item!.Id,

    CustomerName = "SIT RIGHT AB",
    CustomerCode = Item!.CustomerCode,

    VersionId = selectedVersionId,

    ProductToPartId = selectedProductToPartId,

    TopPartId = selectedTopPartId,

    RalColorId = selectedRalColorId,

    IsProduct = isProduct,

    IsPart = isPart
};

var response = await Http.PostAsJsonAsync(
    "http://localhost:5270/api/OrderDraft/save-map",
    dto);

if (!response.IsSuccessStatusCode)
{
    validationMessage =
        await response.Content.ReadAsStringAsync();

    return;
}

validationMessage = null;

showValidationErrors = false;

await OnSaved.InvokeAsync();

}

protected override void OnParametersSet()
{   
    if (Item is not null && previousItem != Item)
        {
            selectedParentCategoryId = null;
            SelectedParentName = "";

            selectedCategoryId = null;
            SelectedCategoryName = "";

            selectedProductId = null;
            SelectedProductName = "";

            selectedVersionId = Item.VersionId;
            SelectedVersionName = Item.VersionName ?? "";

            selectedProductToPartId = Item.ProductToPartId;
            SelectedTopPartName = Item.TopPartName ?? "";

            selectedTopPartId = Item.TopPartId;

            selectedRalColorId = Item.RalColorId;
            SelectedRalName = Item.RalColorName ?? "";

            isProduct = Item.IsProduct;
            isPart = Item.IsPart;

           if (Item.VersionId is not null)
                {
                    var mapping = MappingList
                        .FirstOrDefault(x => x.VersionId == Item.VersionId);

                    if (mapping is not null)
                    {
                        selectedParentCategoryId = mapping.ParentCategoryId;
                        SelectedParentName = mapping.ParentCategoryName;

                        selectedCategoryId = mapping.CategoryId;
                        SelectedCategoryName = mapping.CategoryName;

                        selectedProductId = mapping.ProductId;
                        SelectedProductName = mapping.ProductName;
                    }
                }
        }
    
    previousItem = Item;

    if (IsVisible && Item is null)
    {
        selectedParentCategoryId = null;
        selectedCategoryId = null;
        selectedProductId = null;
        stage1Parts.Clear();
        showParentDropdown = false;
        SelectedParentName = "";
        showCategoryDropdown = false;
        SelectedCategoryName = "";
        showProductDropdown = false;
        SelectedProductName = "";
        showVersionDropdown = false;
        SelectedVersionName = "";
        showRalDropdown = false;
        SelectedRalName = "";
        showTopPartDropdown = false;
        SelectedTopPartName = "";
    }

    if (selectedVersionId is not null)
        {
            _ = LoadStage1Parts();
        }
    
    if (selectedVersionId is not null)
        {
            var existingVersion = Versions
                .FirstOrDefault(x => x.VersionId == selectedVersionId);

            if (existingVersion is not null)
            {
                SelectedVersionName = existingVersion.VersionIsActive
                    ? existingVersion.VersionName
                    : $"{existingVersion.VersionName} [ARCHIVED]";
            }
        }

}

async Task OnVersionChanged()
{
    ResetFromVersion();

    await LoadStage1Parts();
}

async Task CreateHistoricalVersion()
{
    if (Item is null)
        return;

    if (selectedProductId is null)
{
    await JS.InvokeVoidAsync(
        "alert",
        "Vispirms izvēlies preci.");
    return;
}

await OnCreateHistoricalVersion.InvokeAsync(
    selectedProductId.Value);
}

}