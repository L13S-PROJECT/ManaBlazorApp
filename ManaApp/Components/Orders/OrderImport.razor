@* Ordersimprt.razor - šeit būs pasūtījumu importēšanas funkcionalitāte *@

@using ManaApp.Services
@using System.Net.Http.Json
@using ManaApp.Models.Pdf
@using ManaApp.DTOs.Orders
@using ManaApp.Models.Orders
@using ManaApp.Pages
@using ManaApp.Components.Products
@using static ManaApp.Pages.Products

@inject HttpClient Http
@inject IJSRuntime JS


@{
    bool hasDraft = header is not null;

    bool allMapped =
        pdfItems.Any() &&
        pdfItems.All(x => x.IsMapped);
}

<div class="orders-header">

    <div class="orders-header-center">

        <div class="orders-header-left">

            <label for="pdfUpload"
                class="orders-upload-button @(hasDraft ? "upload-disabled" : "")">

                Pievienot

            </label>

            <div class="hidden-file-input">
                <InputFile id="pdfUpload"
                        OnChange="OnFileSelected"
                        disabled="@hasDraft" />
            </div>

        </div>

        <div class="orders-header-box">
        <span class="orders-header-label">Pasūtītājs:</span>

        @if (header is not null)
        {
            <span>@header.Customer</span>
        }

    </div>

    <div class="orders-header-box">
        <span class="orders-header-label">Pasūtījuma Nr:</span>

            @if (header is not null)
            {
                <span>@header.OrderNumber</span>
            }

        </div>

        <div class="orders-header-box">
            <span class="orders-header-label">Datums:</span>

            @if (header is not null)
            {
                <span>@header.Date</span>
            }

        </div>

    </div>

    <div class="orders-header-right">

        <button class="orders-delete-button"
                disabled="@(!hasDraft)"
                @onclick="DeleteDraft">
            DZĒST
        </button>

        <button class="orders-save-button"
        disabled="@(!allMapped)"
        @onclick="SaveOrder">
            SAGLABĀT
        </button>

    </div>

</div>

<div class="orders-table-container">

<table class="orders-table">
    <colgroup>
        <col style="width: 180px;" />
        <col style="width: 520px;" />
        <col style="width: 80px;" />
        <col style="width: 90px;" />
        <col style="width: 140px;" />
        <col style="width: 90px;" />
        <col style="width: 140px;" />
        <col style="width: 120px;" />
        <col style="width: 220px;" />
    </colgroup>
    <thead>
        <tr>
            <th>Code</th>
            <th>Name</th>
            <th>Quantity</th>
            <th>Status</th>
            <th class="cell-product">Product</th>
            <th class="cell-version">Version</th>
            <th class="cell-ral">RAL</th>
            <th class="cell-type">Type</th>
            <th class="cell-toppart">TopPart</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var i in pdfItems ?? new())
{
            <tr class="@(i.IsMapped ? "" : "row-not-mapped")">
                <td>
                    <input @bind="i.CustomerCode" class="input-code" />
                </td>
                <td>
                    <input @bind="i.Name" class="input-name" />
                </td>
                <td>
                    <input type="number" @bind="i.Quantity" class="input-qty" />
                </td>
                <td class="status-cell @(i.IsMapped ? "status-ok" : "status-error")">

                    @if (i.IsMapped)
                            {
                                <span class="map-action mapped"
                                    title="Labot mapping"
                                    @onclick="() => OpenMappingPopup(i)">

                                    ✓

                                </span>
                            }
                            else
                            {
                                <span class="map-action"
                                    title="Pievienot mapping"
                                    @onclick="() => OpenMappingPopup(i)">

                                    +

                                </span>
                            }

                </td>

                <td class="cell-product">@i.ProductName</td>

                <td class="cell-version">

                    @if (!string.IsNullOrWhiteSpace(i.VersionName))
                    {
                        @i.VersionName

                        @if (!i.VersionIsActive)
                        {
                            <span class="archived-label">
                                (arhivēts)
                            </span>
                        }
                    }

                </td>

                <td class="cell-ral">@i.RalColorName</td>

                <td class="cell-type">@i.MappingType</td>

                <td class="cell-toppart">@i.TopPartName</td>
            </tr>
        }
    </tbody>
</table>
</div>



<OrderMappingPopup
    IsVisible="showMappingPopup"
    Item="selectedItem"
    MappingList="mappingList"
    OnCreateHistoricalVersion="OpenHistoricalVersionPopup"
    OnClose="ClosePopup"
    OnSaved="ReloadDraftItems" />

<NewProductDialog
    Visible="showHistoricalVersionDialog"
    VisibleChanged="@(v => showHistoricalVersionDialog = v)"
    Header="Jauna arhivēta versija"
    IsEdit="true"
    ShowValidation="showHistoricalValidation"
    ParentOptions="historicalParentOptions"
    ChildOptions="historicalChildOptions"
    SelectedParentId="historicalParentId"
    SelectedParentIdChanged="@(v => historicalParentId = v)"
    SelectedChildId="historicalChildId"
    SelectedChildIdChanged="@(v => historicalChildId = v)"
    NewName="@historicalProductName"
    NewNameChanged="@(v => historicalProductName = v)"
    NewCode="@historicalProductCode"
    NewCodeChanged="@(v => historicalProductCode = v)"
    CreateNewVersion="true"
    CreateNewVersionChanged="@(v => {})"
    CopyTechnologySteps="true"
    CopyTechnologyStepsChanged="@(v => {})"
    NewVersionName="@historicalVersionName"
    NewVersionNameChanged="@(v => historicalVersionName = v)"
    NewVersionRasejums="@historicalVersionRasejums"
    NewVersionRasejumsChanged="@(v => historicalVersionRasejums = v)"
    NewVersionDate="historicalVersionDate"
    NewVersionComment="@historicalVersionComment"
    NewVersionCommentChanged="@(v => historicalVersionComment = v)"
    OnSave="SaveHistoricalVersion"
    OnCancel="CloseHistoricalVersionDialog"
    IsHistoricalVersion="true"
    IsHistoricalVersionChanged="@(v => {})" />


@code {
    List<OrderDraftItemViewModel> pdfItems = new();
    OrderHeader? header;
    List<CustomerCodeMapResult> mapResults = new();
    
    int historicalProductId;

    bool showMappingPopup = false;
    OrderDraftItemViewModel? selectedItem;   

    bool showHistoricalVersionDialog = false;

bool showHistoricalValidation = false;

int? historicalParentId;
int? historicalChildId;

string historicalProductName = "";
string historicalProductCode = "";

string? historicalVersionName;
string? historicalVersionRasejums;
DateOnly? historicalVersionDate;
string? historicalVersionComment;

List<CategoryDto> historicalCategories = new();

List<CategoryDto> historicalParentOptions =>
    historicalCategories
        .Where(x => x.ParentId is null && x.IsActive)
        .ToList();

List<CategoryDto> historicalChildOptions =>
    historicalCategories
        .Where(x =>
            x.ParentId == historicalParentId &&
            x.IsActive)
        .ToList();
       
protected override async Task OnInitializedAsync()
{
    var response = await Http.GetAsync(
        "http://localhost:5270/api/OrderDraft/latest");

    if (!response.IsSuccessStatusCode)
        return;

    var result = await response.Content
        .ReadFromJsonAsync<OrderDraftLoadResult>();

    if (result is null)
        return;

    header = new OrderHeader
    {
        OrderNumber = result.Draft.OrderNumber,
        Customer = result.Draft.CustomerName,
        Date = result.Draft.OrderDate?.ToString("yyyy-MM-dd") ?? ""
    };

    pdfItems = result.Items.Select(x => new OrderDraftItemViewModel
    {
        Id = x.Id,
        CustomerCodeMapId = x.CustomerCodeMapId,
        CustomerCode = x.CustomerCode,
        Name = x.Name,
        Quantity = x.Quantity,
        VersionId = x.VersionId,
        VersionIsActive = x.VersionIsActive,
        ProductToPartId = x.ProductToPartId,
        RalColorId = x.RalColorId,
        IsMapped = x.IsMapped,
        TopPartId = x.TopPartId,

        IsProduct = x.IsProduct,

        IsPart = x.IsPart,

        ProductName = x.ProductName,

        VersionName = x.VersionName,

        RalColorName = x.RalColorName,

        TopPartName = x.TopPartName,

        MappingType = x.MappingType
    }).ToList();

    mappingList = await Http.GetFromJsonAsync<List<MappingListItem>>(
    "http://localhost:5270/api/products/mapping-list")
    ?? new();

}
private async Task OnFileSelected(InputFileChangeEventArgs e)
{
    var file = e.File;

    using var ms = new MemoryStream();
    await file.OpenReadStream(long.MaxValue).CopyToAsync(ms);

    using var content = new MultipartFormDataContent();

content.Add(
    new ByteArrayContent(ms.ToArray()),
    "file",
    file.Name);

var response = await Http.PostAsync(
    "http://localhost:5270/api/Pdf/parse",
    content);

var result = await response.Content.ReadFromJsonAsync<PdfParseResult>();

if (result is null)
    return;

header = result.Header;
pdfItems = result.Items.Select(x => new OrderDraftItemViewModel
{
    CustomerCode = x.Code,
    Name = x.Name,
    Quantity = x.Quantity
}).ToList();

var draftItems = pdfItems.Select(x => new OrderItem
{
    Code = x.CustomerCode,
    Name = x.Name,
    Quantity = x.Quantity
}).ToList();

await Http.PostAsJsonAsync(
    "http://localhost:5270/api/OrderDraft",
    new
    {
        Header = header,
        Items = draftItems
    });

var reloadResponse = await Http.GetAsync(
    "http://localhost:5270/api/OrderDraft/latest");

if (!reloadResponse.IsSuccessStatusCode)
    return;

var reloadResult = await reloadResponse.Content
    .ReadFromJsonAsync<OrderDraftLoadResult>();

if (reloadResult is null)
    return;


pdfItems = reloadResult.Items.Select(x => new OrderDraftItemViewModel
{
    Id = x.Id,
    CustomerCodeMapId = x.CustomerCodeMapId,
    CustomerCode = x.CustomerCode,
    Name = x.Name,
    Quantity = x.Quantity,

    VersionId = x.VersionId,
    VersionIsActive = x.VersionIsActive,
    ProductToPartId = x.ProductToPartId,
    RalColorId = x.RalColorId,
    TopPartId = x.TopPartId,

    IsMapped = x.IsMapped,
    IsProduct = x.IsProduct,
    IsPart = x.IsPart,

    ProductName = x.ProductName,
    VersionName = x.VersionName,
    RalColorName = x.RalColorName,
    TopPartName = x.TopPartName,
    MappingType = x.MappingType
}).ToList();

OpenNextUnmapped();

}

void OpenMappingPopup(OrderDraftItemViewModel item)
{
    showMappingPopup = true;

    selectedItem = item;

    selectedItem = new OrderDraftItemViewModel
        {
            Id = item.Id,
            CustomerCode = item.CustomerCode,
            Name = item.Name,
            Quantity = item.Quantity,

            VersionId = item.VersionId,
            VersionIsActive = item.VersionIsActive,
            ProductToPartId = item.ProductToPartId,
            TopPartId = item.TopPartId,
            RalColorId = item.RalColorId,

            IsMapped = item.IsMapped,

            IsProduct = item.IsProduct,
            IsPart = item.IsPart,

            ProductName = item.ProductName,
            VersionName = item.VersionName,
            RalColorName = item.RalColorName,
            TopPartName = item.TopPartName,

            MappingType = item.MappingType
        };

}

void OpenNextUnmapped()
{
    var next = pdfItems
        .FirstOrDefault(x => !x.IsMapped);

    if (next is null)
    {
        showMappingPopup = false;
        selectedItem = null;
        return;
    }

    showMappingPopup = false;

    StateHasChanged();

    OpenMappingPopup(next);
}

void ClosePopup()
{
    showMappingPopup = false;

    selectedItem = null;
}

List<MappingListItem> mappingList = new();

async Task ReloadDraftItems()
{
    var reloadResponse = await Http.GetAsync(
        "http://localhost:5270/api/OrderDraft/latest");

    if (!reloadResponse.IsSuccessStatusCode)
        return;

    var reloadResult = await reloadResponse.Content
        .ReadFromJsonAsync<OrderDraftLoadResult>();

    if (reloadResult is null)
        return;

    pdfItems = reloadResult.Items.Select(x => new OrderDraftItemViewModel
    {
        Id = x.Id,
        CustomerCodeMapId = x.CustomerCodeMapId,
        CustomerCode = x.CustomerCode,
        Name = x.Name,
        Quantity = x.Quantity,

        VersionId = x.VersionId,
        VersionIsActive = x.VersionIsActive,
        ProductToPartId = x.ProductToPartId,
        RalColorId = x.RalColorId,
        TopPartId = x.TopPartId,

        IsMapped = x.IsMapped,
        IsProduct = x.IsProduct,
        IsPart = x.IsPart,

        ProductName = x.ProductName,
        VersionName = x.VersionName,
        RalColorName = x.RalColorName,
        TopPartName = x.TopPartName,
        MappingType = x.MappingType
    }).ToList();

    OpenNextUnmapped();
    StateHasChanged();
}

async Task DeleteDraft()
{
    var confirmed = await JS.InvokeAsync<bool>(
        "confirm",
        "Vai tiešām dzēst melnrakstu?");

    if (!confirmed)
        return;

    var response = await Http.DeleteAsync(
        "http://localhost:5270/api/OrderDraft");

    if (!response.IsSuccessStatusCode)
        return;

    header = null;

    pdfItems.Clear();

    StateHasChanged();
}

async Task SaveOrder()
{
    if (!pdfItems.All(x => x.IsMapped))
    {
        await JS.InvokeVoidAsync(
            "alert",
            "Visām rindām jābūt Mapping.");

        return;
    }

    var response = await Http.PostAsJsonAsync(
    "http://localhost:5270/api/orders/save-draft",
    new SaveOrderRequest
    {
        OrderNumber = header?.OrderNumber ?? ""
    });

    if (!response.IsSuccessStatusCode)
{
    var error = await response.Content.ReadAsStringAsync();

    await JS.InvokeVoidAsync(
        "alert",
        error);

    return;
}

var confirmed = await JS.InvokeAsync<bool>(
    "confirm",
    "Vai saglabāt pasūtījumu?");

if (!confirmed)
    return;

header = null;

pdfItems.Clear();

StateHasChanged();
}

async Task OpenHistoricalVersionPopup(
    OrderDraftItemViewModel item)
{
    var mapping = mappingList
    .FirstOrDefault(x =>
        x.VersionId == item.VersionId);

            if (mapping is null)
            {
                mapping = mappingList
                    .FirstOrDefault(x =>
                        x.ProductName == item.ProductName);
            }

    if (mapping is null)
            {
                await JS.InvokeVoidAsync(
                    "alert",
                    "Neizdevās atrast saistīto produktu katalogā.");

                return;
            }

    historicalProductId = mapping.ProductId;

    historicalParentId = mapping.ParentCategoryId;

    historicalCategories =
    await Http.GetFromJsonAsync<List<CategoryDto>>(
        "http://localhost:5270/api/categories")
    ?? new();

    historicalChildId = mapping.CategoryId;

    historicalProductName = mapping.ProductName;

    historicalProductCode = mapping.ProductName;

    historicalVersionName = "";

    historicalVersionRasejums = "";

    historicalVersionDate = DateOnly.FromDateTime(DateTime.Today);

    historicalVersionComment = "";

    showHistoricalValidation = false;

    showHistoricalVersionDialog = true;
}

void CloseHistoricalVersionDialog()
{
    showHistoricalVersionDialog = false;
}

async Task SaveHistoricalVersion()
{
    showHistoricalValidation = true;

    if (historicalChildId is null ||
        string.IsNullOrWhiteSpace(historicalProductName) ||
        string.IsNullOrWhiteSpace(historicalProductCode) ||
        string.IsNullOrWhiteSpace(historicalVersionName) ||
        historicalVersionDate is null)
    {
        return;
    }

    var payload = new
    {
        productId = historicalProductId,

        productName = historicalProductName,

        productCode = historicalProductCode,

        categoryId = historicalChildId.Value,

        versionName = historicalVersionName,

        versionRasejums = historicalVersionRasejums,

        versionDate = historicalVersionDate?
            .ToString("yyyy-MM-dd"),

        versionComment = historicalVersionComment,

        createNewVersion = true,

        copyTechnologySteps = true,

        IsHistoricalVersion = true
    };

    var response = await Http.PutAsJsonAsync(
        "http://localhost:5270/api/products/update",
        payload);

    if (!response.IsSuccessStatusCode)
{
    var error = await response.Content.ReadAsStringAsync();

    await JS.InvokeVoidAsync(
        "alert",
        error);

    return;
}

    showHistoricalVersionDialog = false;

    mappingList = await Http.GetFromJsonAsync<List<MappingListItem>>(
        "http://localhost:5270/api/products/mapping-list")
        ?? new();

    if (selectedItem is not null)
            {
                var refreshed = mappingList
                    .Where(x => x.ProductId == historicalProductId)
                    .OrderByDescending(x => x.VersionId)
                    .FirstOrDefault();

                if (refreshed is not null)
                {
                    selectedItem.VersionId = refreshed.VersionId;

                    selectedItem.VersionName = refreshed.VersionName;

                    selectedItem.VersionIsActive = refreshed.VersionIsActive;

                    selectedItem.ProductName = refreshed.ProductName;
                }

                showMappingPopup = true;

                OpenMappingPopup(selectedItem);
            }

    StateHasChanged();
}


}
