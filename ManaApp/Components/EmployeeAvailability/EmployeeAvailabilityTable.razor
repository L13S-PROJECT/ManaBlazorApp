@using ManaApp.Models
@inject HttpClient Http
@inject IJSRuntime JS

<div class="ea-container">

<h4 class="ea-title">Darbinieku saraksts</h4>

<table class="table ea-table">
<thead>
    <tr>
        <th>Employee</th>
        <th>Default Start</th>
        <th>Default End</th>
        <th>Actual Start</th>
        <th>Actual End</th>
        <th>Stundas</th>
        <th class="ea-col-availability">Pieejamība</th>
        <th class="ea-col-notes">Piezīmes</th>
        <th class="ea-col-actions"></th>
    </tr>
</thead>
<tbody>
@foreach (var emp in Employees)
{
    var isUnavailable = IsUnavailable(emp.Id);
    var item = WorkLogs.FirstOrDefault(x => x.EmployeeID == emp.Id);

    var day = calendar.FirstOrDefault(x => x.WorkDate.Date == SelectedDate.Date);
    var isCustomDay = day != null;

    var isWeekend = SelectedDate.DayOfWeek == DayOfWeek.Saturday 
                || SelectedDate.DayOfWeek == DayOfWeek.Sunday;

    var isCompanyDayOff = day != null && (day.WorkStart == null || day.WorkEnd == null);

    var isDayOff = isWeekend || isCompanyDayOff;

    var start = emp.WorkStart;
    var end = isDayOff
    ? emp.WorkEnd
    : isCustomDay
        ? day?.WorkEnd
        : emp.WorkEnd;

    var startTime = item?.TimeFrom ?? start ?? TimeSpan.Zero;
    var endTime = item?.TimeTo ?? end ?? TimeSpan.Zero;

double hours = 0;

if (!isDayOff)
{
    var total = (endTime - startTime).TotalHours;

var breaksList = GetBreaksForDay();

    double breakHours = 0;

    foreach (var b in breaksList)
    {
        if (startTime <= b.To && endTime >= b.From)
        {
            var overlapStart = startTime > b.From ? startTime : b.From;
            var overlapEnd = endTime < b.To ? endTime : b.To;

            breakHours += (overlapEnd - overlapStart).TotalHours;
        }
    }

    hours = total - breakHours;
}

<tr class="ea-row 
    @(isUnavailable ? "ea-row-unavailable" : "")
    @(isDayOff ? "ea-row-off" : "")
    @(item != null ? "ea-row-modified" : "")
    @(selectedEmployeeId == emp.Id ? "ea-row-selected" : "")"
    style="cursor: default;"
    @onclick="() => OnEmployeeSelected(emp.Id)">

    <td class="ea-emp">@emp.Name</td>

<td class="ea-def-start @((item != null || isUnavailable) ? "ea-old" : "")">@start?.ToString(@"hh\:mm")</td>
<td class="ea-def-end @((item != null || isUnavailable) ? "ea-old" : "")">@end?.ToString(@"hh\:mm")</td>
<td class="ea-act-start">
@(item?.TimeFrom != null 
    ? item.TimeFrom.Value.ToString(@"hh\:mm") 
    : "")
</td>

<td class="ea-act-end">
@(item?.TimeTo != null 
    ? item.TimeTo.Value.ToString(@"hh\:mm") 
    : "")
</td>

<td class="ea-hours @(isUnavailable ? "ea-old" : "")">
    @Math.Max(0, Math.Round(hours, 2))
</td>

<td class="ea-availability ea-col-availability">
    @(GetAvailabilityText(emp.Id))
</td>

    <td class="ea-notes ea-col-notes">
        @item?.Notes</td>
    <td class="ea-col-actions">
    <button class="ea-btn-edit"
        title="Labot ierakstu"
            @onclick:stopPropagation="true"
            @onclick="() => { selectedEmployeeId = emp.Id; OpenEdit(emp, item); }">
        <span class="ea-icon-edit">✎</span>
    </button>
</td>
</tr>

}
</tbody>
</table>
</div>

@if (showPopup && selectedEmployee != null && selectedItem != null)
{
<div class="steps-dialog-modal">
    <div class="steps-dialog-window">
        <div class="steps-dialog">

<div class="steps-dialog-header">
    @selectedEmployee.Name - @SelectedDate.ToString("dd.MM.yyyy")
</div>

@if (isCompanyDayOff)
{
    <div style="color:red; font-weight:bold; margin-bottom:10px;">
        ⚠ Uzņēmumā šī diena ir brīvdiena
    </div>
}

@if (selectedEmployee != null && IsUnavailable(selectedEmployee.Id))
{
    <div style="color:#b45309; font-weight:bold; margin-bottom:10px;">
        ⚠ Darbinieks nav pieejams (@GetAvailabilityText(selectedEmployee.Id))
    </div>
}

<div class="steps-table-body">

<div class="steps-grid">

    <div>
        <label>From:</label>
        <div class="time-row">
            <input type="number" min="0" max="23"
                   class="steps-input time-part"
                   value="@SelectedDate.Add(selectedItem.TimeFrom ?? TimeSpan.Zero).Hour"
                   @onchange="e => selectedItem.TimeFrom = new TimeSpan(
                        int.Parse(e.Value!.ToString()!),
                        selectedItem.TimeFrom?.Minutes ?? 0,
                        0)" />

            <span>:</span>

            <input type="number" min="0" max="59"
                   class="steps-input time-part"
                   value="@SelectedDate.Add(selectedItem.TimeFrom ?? TimeSpan.Zero).Minute.ToString("D2")"
                  @onchange="e => selectedItem.TimeFrom = new TimeSpan(
                            selectedItem.TimeFrom?.Hours ?? 0,
                            int.Parse(e.Value!.ToString()!),
                            0)" />
        </div>
    </div>

    <div>
        <label>To:</label>
        <div class="time-row">
            <input type="number" min="0" max="23"
                   class="steps-input time-part"
                   value="@SelectedDate.Add(selectedItem.TimeTo ?? TimeSpan.Zero).Hour"
                @onchange="e => selectedItem.TimeTo = new TimeSpan(
                    int.Parse(e.Value!.ToString()!),
                    selectedItem.TimeTo?.Minutes ?? 0,
                    0)" />

            <span>:</span>

            <input type="number" min="0" max="59"
                   class="steps-input time-part"
                   value="@SelectedDate.Add(selectedItem.TimeTo ?? TimeSpan.Zero).Minute.ToString("D2")"
                   @onchange="e => selectedItem.TimeTo = new TimeSpan(
                        selectedItem.TimeTo?.Hours ?? 0,
                        int.Parse(e.Value!.ToString()!),
                        0)" />
        </div>
    </div>

    <div>
 Šeit varētu būt pārtraukumu iestatījumi
    </div>

    <div>
        <label>Stundas:</label>
        <div style="font-weight:bold; font-size:18px; color:#1d4ed8;">
            @CalculatedHours()
        </div>
    </div>

    <div style="grid-column: span 2;">
        <label>Notes:</label>
        <input type="text" class="steps-input" @bind="selectedItem.Notes" />
    </div>

</div>

</div>

<div class="steps-footer-wrapper steps-footer">
    <button class="steps-btn-save" @onclick="Save">Saglabāt</button>
    <button class="steps-btn-close" @onclick="() => showPopup = false">Aizvērt</button>
</div>
            </div>
        </div>
    </div>
}



@code {
    [Parameter]
public List<EmployeeWorkLogModel> WorkLogs { get; set; } = new();
    [Parameter]
public List<EmployeeDto> Employees { get; set; } = new();
[Parameter]
public DateTime SelectedDate { get; set; }
private List<CompanyCalendarModel> calendar = new();
private bool _useDefaultBreak = true;
[Parameter]
public List<EmployeeAvailabilityModel> Availability { get; set; } = new();
int? selectedEmployeeId;
bool useDefaultBreak
{
    get => _useDefaultBreak;
    set
    {
        _useDefaultBreak = value;

        if (selectedItem == null)
            return;

        if (_useDefaultBreak)
        {
            var day = calendar.FirstOrDefault(x => x.WorkDate.Date == SelectedDate.Date);
            selectedItem.BreakMinutes = day?.BreakMinutes ?? 60;
        }
    }
}

void AddAvailability()
{
WorkLogs.Add(new EmployeeWorkLogModel
{
    EmployeeID = Employees.First().Id,
    WorkDate = SelectedDate,
    TimeFrom = new TimeSpan(8, 0, 0),
    TimeTo = new TimeSpan(17, 0, 0),
    BreakMinutes = 60
});
}
private DateTime SetTime(int h, int m)
{
    return SelectedDate.Add(new TimeSpan(h, m, 0));
}
EmployeeDto? selectedEmployee;
EmployeeWorkLogModel? selectedItem;
bool showPopup = false;
bool isCompanyDayOff = false;

void OpenEdit(EmployeeDto emp, EmployeeWorkLogModel? item)
{
    selectedEmployee = emp;

    var day = calendar.FirstOrDefault(x => x.WorkDate.Date == SelectedDate.Date);

    if (item != null)
    {
        selectedItem = item;
    }
    else
{
var isCustomDay = day != null &&
    (
        day.WorkStart != emp.WorkStart ||
        day.WorkEnd != emp.WorkEnd ||
        day.BreakMinutes != 60
    );
var isDayOff = day != null && (day.WorkStart == null || day.WorkEnd == null);

selectedItem = new EmployeeWorkLogModel
{
    EmployeeID = emp.Id,
    WorkDate = SelectedDate,

    TimeFrom = isDayOff
        ? TimeSpan.Zero
        : emp.WorkStart ?? new TimeSpan(8, 0, 0),

    TimeTo = isDayOff
        ? TimeSpan.Zero
        : isCustomDay
            ? (day?.WorkEnd ?? new TimeSpan(17, 0, 0))
            : (emp.WorkEnd ?? new TimeSpan(17, 0, 0)),

    BreakMinutes = isDayOff
        ? 0
        : isCustomDay
            ? day?.BreakMinutes ?? 60
            : 60
};
}

    showPopup = true;
    useDefaultBreak = true;
    isCompanyDayOff = day != null && (day.WorkStart == null || day.WorkEnd == null);
}

async Task Save()
{
    var confirm = await JS.InvokeAsync<bool>("confirm", $"Vai saglabāt izmaiņas {SelectedDate:dd.MM.yyyy}?");
if (!confirm)
    return;

    if (selectedItem == null) return;

if (SelectedDate.Add(selectedItem.TimeTo ?? TimeSpan.Zero) <= SelectedDate.Add(selectedItem.TimeFrom ?? TimeSpan.Zero))
{
    await JS.InvokeVoidAsync("alert", "Nepareizs laika intervāls");
    return;
}

var model = new EmployeeWorkLogModel
{
    EmployeeID = selectedItem.EmployeeID,
    WorkDate = SelectedDate,
    TimeFrom = SelectedDate.Add(selectedItem.TimeFrom ?? TimeSpan.Zero).TimeOfDay,
    TimeTo = SelectedDate.Add(selectedItem.TimeTo ?? TimeSpan.Zero).TimeOfDay,
    BreakMinutes = selectedItem.BreakMinutes,
    Notes = selectedItem.Notes,
    Hours = (decimal)CalculatedHours()
};

await Http.PostAsJsonAsync("api/employeeworklog", model);

// refresh WorkLogs (vienkāršais variants)
var updated = await Http.GetFromJsonAsync<List<EmployeeWorkLogModel>>(
    "api/employeeworklog/date/" + SelectedDate.ToString("yyyy-MM-dd")
);

WorkLogs = updated ?? new();


showPopup = false;

await JS.InvokeVoidAsync("alert", "Izmaiņas saglabātas");
}

protected override async Task OnInitializedAsync()
{
    calendar = await Http.GetFromJsonAsync<List<CompanyCalendarModel>>("api/companycalendar") ?? new();
}

double CalculatedHours()
{
    if (selectedItem == null)
        return 0;

    var total = (SelectedDate.Add(selectedItem.TimeTo ?? TimeSpan.Zero) - SelectedDate.Add(selectedItem.TimeFrom ?? TimeSpan.Zero)).TotalHours;

var breaksList = GetBreaksForDay();

double breakHours = 0;

var start = selectedItem.TimeFrom ?? TimeSpan.Zero;
var end = selectedItem.TimeTo ?? TimeSpan.Zero;

foreach (var b in breaksList)
{
    if (start <= b.To && end >= b.From)
    {
        var overlapStart = start > b.From ? start : b.From;
        var overlapEnd = end < b.To ? end : b.To;

        breakHours += (overlapEnd - overlapStart).TotalHours;
    }
}

return Math.Round(total - breakHours, 2);
}

bool IsUnavailable(int employeeId)
{
    return Availability.Any(a =>
        a.EmployeeID == employeeId &&
        a.DateFrom <= SelectedDate &&
        (a.DateTo == null || a.DateTo >= SelectedDate)
    );
}

[Parameter]
public EventCallback<int?> OnEmployeeSelectedCallback { get; set; }

private async Task OnEmployeeSelected(int id)
{
    if (selectedEmployeeId == id)
        selectedEmployeeId = null;
    else
        selectedEmployeeId = id;

    await OnEmployeeSelectedCallback.InvokeAsync(selectedEmployeeId);
}

string GetAvailabilityText(int employeeId)
{
    var a = Availability.FirstOrDefault(x =>
        x.EmployeeID == employeeId &&
        x.DateFrom <= SelectedDate &&
        (x.DateTo == null || x.DateTo >= SelectedDate));

    if (a == null)
        return "";

    return a.Status switch
    {
        "VACATION" => "Atvaļinājums",
        "SICK" => "Slimības lapa",
        "ABSENT" => "Brīvdiena",
        _ => a.Status
    };
}

private List<BreakItem> breaks = new()
{
    new BreakItem(new TimeSpan(10,0,0), new TimeSpan(10,15,0)),
    new BreakItem(new TimeSpan(12,0,0), new TimeSpan(12,30,0)),
    new BreakItem(new TimeSpan(15,0,0), new TimeSpan(15,15,0))
};

class BreakItem
{
    public TimeSpan From { get; set; }
    public TimeSpan To { get; set; }

    public BreakItem(TimeSpan from, TimeSpan to)
    {
        From = from;
        To = to;
    }
}

List<BreakItem> GetBreaksForDay()
{
    var day = calendar.FirstOrDefault(x => x.WorkDate.Date == SelectedDate.Date);

    if (!string.IsNullOrEmpty(day?.BreaksJson))
    {
        var parsed = System.Text.Json.JsonSerializer.Deserialize<List<BreakDto>>(day.BreaksJson);

        if (parsed != null)
        {
            return parsed.Select(x => new BreakItem(
                TimeSpan.Parse(x.From),
                TimeSpan.Parse(x.To)
            )).ToList();
        }
    }

    // fallback (ja nav DB)
    return new()
    {
        new BreakItem(new TimeSpan(10,0,0), new TimeSpan(10,15,0)),
        new BreakItem(new TimeSpan(12,0,0), new TimeSpan(12,30,0)),
        new BreakItem(new TimeSpan(15,0,0), new TimeSpan(15,15,0))
    };
}

class BreakDto
{
    public string From { get; set; } = "";
    public string To { get; set; } = "";
}

}