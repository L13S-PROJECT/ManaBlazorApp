@using ManaApp.Models
@inject HttpClient Http
@inject IJSRuntime JS

<div class="cc-row">
<div class="cc-date-wrap">

    <input type="date"
           class="cc-date-hidden"
           value="@selectedDate.ToString("yyyy-MM-dd")"
           @onchange="OnDateChanged"
           @ref="dateInputRef" />

    <button class="cc-date-btn" @onclick="OpenDatePicker" title="Izvēlies datumu">
        📅
    </button>

<div class="cc-date-main">
    <div class="cc-date-day">
        @selectedDate.ToString("dddd")
    </div>

    <div class="cc-date-text">
        @selectedDate.ToString("dd.MM.yyyy")
    </div>
</div>

</div>

<div class="cc-status-box">

    <div>
        @if (calendar.Any(x => x.WorkDate.Date == selectedDate.Date))
        {
            <span class="cc-badge custom">Pielāgots</span>
        }
        else
        {
            <span class="cc-badge default">Standarta</span>
        }
    </div>

    @if (selectedDay != null)
    {
        <div class="cc-status-hours">
            @GetWorkingHours(selectedDay) h
        </div>
    }

    @if (!isDayOff)
{
    var isShortDay = selectedDay?.WorkStart != new TimeSpan(8, 0, 0)
              || selectedDay?.WorkEnd != new TimeSpan(17, 0, 0);

    if (isShortDay)
    {
        <div class="cc-day short">Saīsināta diena</div>
    }
    else
    {
        <div class="cc-day normal">Darba diena</div>
    }
}
else
{
    <div class="cc-day off">Brīvdiena</div>
}

</div>

@if (selectedDay != null)
{
    <div class="cc-dayoff-box">
        <label>
            <input type="checkbox" @bind="isDayOff" />
            Brīvdiena
        </label>
    </div>

<div class="cc-hours @(isDayOff || IsDbDayOff() ? "hidden" : "")">
<div class="cc-time-container">  
    <div class="cc-time-row"> 
    <div class="cc-time-group">
        <label>Darba dienas sākums:</label>
            <div class="cc-time">
                <input type="number" min="0" max="23"
                    value="@GetHours(selectedDay.WorkStart)"
                    @onchange="e => { selectedDay.WorkStart = SetTime(int.Parse(e.Value!.ToString()!), GetMinutes(selectedDay.WorkStart)); UpdateBreakActivity(); }"
                    style="width:50px;" />
                :
                <input type="number" min="0" max="59"
                    value="@GetMinutes(selectedDay.WorkStart).ToString("D2")"
                    @onchange="e => { selectedDay.WorkStart = SetTime(GetHours(selectedDay.WorkStart), int.Parse(e.Value!.ToString()!)); UpdateBreakActivity(); }"
                    style="width:50px;" />
            </div>
    </div>

    <div class="cc-time-group">       
        <label>Darba dienas beigas:</label>
            <div class="cc-time">
                <input type="number" min="0" max="23"
                    value="@GetHours(selectedDay.WorkEnd)"
                    @onchange="e => { selectedDay.WorkEnd = SetTime(int.Parse(e.Value!.ToString()!), GetMinutes(selectedDay.WorkEnd)); UpdateBreakActivity(); }"
                    style="width:50px;" />

                :

                <input type="number" min="0" max="59"
                    value="@GetMinutes(selectedDay.WorkEnd).ToString("D2")"
                    @onchange="e => { selectedDay.WorkEnd = SetTime(GetHours(selectedDay.WorkEnd), int.Parse(e.Value!.ToString()!)); UpdateBreakActivity(); }"
                    style="width:50px;" />
            </div>
    </div>
    </div>
</div>
<div class="cc-breaks-container">
    <div class="cc-breaks-left">
        <label>Pārtraukumi:</label>
        <button class="cc-btn-add"
        @onclick="AddBreak"
        title="Pievienot jaunu pārtraukumu">
    + pievienot
</button>
    </div>

    <div class="cc-breaks-list">
            @foreach (var b in breaks)
            {
                <div class="cc-break-item">
                    <div class="cc-break-row @(b.IsActive ? "" : "inactive")">
                        <input type="checkbox"
                            @bind="b.IsActive"
                            disabled="@(selectedDay?.WorkStart == null || selectedDay?.WorkEnd == null || b.From < selectedDay.WorkStart.Value || b.To > selectedDay.WorkEnd.Value)"
                            @onclick:stopPropagation="true" />
                        <input type="number" min="0" max="23"
                            value="@b.From.Hours"
                            @onchange="e => UpdateBreak(b, true, int.Parse(e.Value!.ToString()!))" />
                        :
                        <input type="number" min="0" max="59"
                            value="@b.From.Minutes"
                            @onchange="e => UpdateBreakMinutes(b, true, int.Parse(e.Value!.ToString()!))" />

                        -

                        <input type="number" min="0" max="23"
                            value="@b.To.Hours"
                            @onchange="e => UpdateBreak(b, false, int.Parse(e.Value!.ToString()!))" />
                        :
                        <input type="number" min="0" max="59"
                            value="@b.To.Minutes"
                            @onchange="e => UpdateBreakMinutes(b, false, int.Parse(e.Value!.ToString()!))" />
                    </div>
                    <button class="cc-btn-remove"
                        @onclick="() => RemoveBreak(b)"
                        @onclick:stopPropagation="true">
                        ✕
                    </button>
                </div>
            }
        </div>
    </div>
</div>

<div class="cc-notes-actions">
            <div class="cc-actions">
                
                     <button class="cc-btn save" @onclick="Save" title="Saglabāt izmaiņas">Saglabāt</button>
                

                
                    <button class="cc-btn range" @onclick="ToggleRangeMode" title="Iestatīt vairākām dienām">Periods</button>
                
    @if (showRangePopup)
        {
            <div class="cc-popup-overlay">
                        <div class="cc-popup-window">

                            <div class="cc-popup-header">
                                Periods
                            </div>
            <div class="cc-popup-body">
                <div class="cc-popup-row">
                        <div class="cc-popup-date-block">
                            <label>No:</label>
                            <div class="cc-date-wrap">
                                <input type="date"
                                    class="cc-date-hidden"
                                    value="@rangeFrom.ToString("yyyy-MM-dd")"
                                    @onchange="OnRangeFromChanged"
                                    @ref="rangeFromRef" />

                                <button class="cc-date-btn" @onclick="OpenRangeFrom">📅</button>

                                <span class="cc-date-text">
                                    @rangeFrom.ToString("dd.MM.yyyy")
                                </span>
                            </div>
                        </div>

                    <div class="cc-popup-date-block">
                        <label>Līdz:</label>
                        <div class="cc-date-wrap">
                            <input type="date"
                                class="cc-date-hidden"
                                value="@rangeTo.ToString("yyyy-MM-dd")"
                                @onchange="OnRangeToChanged"
                                @ref="rangeToRef" />

                            <button class="cc-date-btn" @onclick="OpenRangeTo">📅</button>

                            <span class="cc-date-text">
                                @rangeTo.ToString("dd.MM.yyyy")
                            </span>
                        </div>
                    </div>

                </div>

                        <div class="cc-popup-row">
                            <label class="cc-checkbox-row">
                                <input type="checkbox" @bind="isDayOff" />
                                Brīvdiena
                            </label>
                        </div>

                        <div class="cc-popup-row">
                            <label>Komentārs:</label>
                        </div>

                        <div class="cc-popup-row">
                            <input type="text" @bind="selectedDay!.Notes" class="cc-notes-input" />
                        </div>
                </div>
                        <div class="cc-popup-footer-wrapper">
                            <button class="cc-btn-save" @onclick="ApplyRange">Pielietot</button>
                            <button class="cc-btn-close" @onclick="() => showRangePopup = false">Aizvērt</button>
                        </div>
                
                </div>
            </div>
        }
            
                <button class="cc-btn reset" @onclick="Reset"
                        title="Dzēš izmaiņas tikai šai dienai un atjauno standarta darba laiku">
                    Atjaunot
                </button>
            
            </div>
    @if (selectedDay != null)
        {     
            <div class="cc-notes">
                <textarea @bind="selectedDay.Notes" placeholder="Piezīmes..."></textarea>
            </div>
        }

    
</div>
}

</div>

@code {
    private List<CompanyCalendarModel> calendar = new();
    private DateTime selectedDate = DateTime.Today;
    private CompanyCalendarModel? selectedDay;

    protected override async Task OnInitializedAsync()
    {
        calendar = await Http.GetFromJsonAsync<List<CompanyCalendarModel>>("api/companycalendar") ?? new();
        UpdateSelectedDay();
    }
private async Task OnDateChanged(ChangeEventArgs e)
{
    selectedDate = DateTime.Parse(e.Value!.ToString()!);
    UpdateSelectedDay();

    await OnDateChangedCallback.InvokeAsync(selectedDate);
}

[Parameter]
public EventCallback<DateTime> OnDateChangedCallback { get; set; }
private string ToTimeString(TimeSpan? time)
{
    return time.HasValue 
        ? time.Value.ToString(@"hh\:mm") 
        : "";
}

private TimeSpan? ParseTime(string? value)
{
    if (TimeSpan.TryParse(value, out var result))
        return result;

    return null;
}
private async Task Save()
{
    
    var confirm = await JS.InvokeAsync<bool>("confirm", "Vai saglabāt izmaiņas?");
if (!confirm)
    return;

    if (selectedDay == null)
        return;

    if (isDayOff)
    {
        selectedDay.WorkStart = null;
        selectedDay.WorkEnd = null;
    }

selectedDay.Breaks = breaks.Select(b => new CompanyCalendarBreakModel
{
    WorkDate = selectedDay.WorkDate,
    BreakStart = b.From,
    BreakEnd = b.To,
    IsActive = b.IsActive
}).ToList();

    await Http.PostAsJsonAsync("api/companycalendar", selectedDay);
var existing = calendar.FirstOrDefault(x => x.WorkDate.Date == selectedDay.WorkDate.Date);

if (existing == null)
{
    calendar.Add(selectedDay);
}
else
{
    existing.WorkStart = selectedDay.WorkStart;
    existing.WorkEnd = selectedDay.WorkEnd;
    existing.BreakMinutes = selectedDay.BreakMinutes;
    existing.Notes = selectedDay.Notes;
}

    calendar = await Http.GetFromJsonAsync<List<CompanyCalendarModel>>("api/companycalendar") ?? new();

    UpdateSelectedDay();

    await JS.InvokeVoidAsync("alert", "Izmaiņas saglabātas");

    await OnCalendarChanged.InvokeAsync();
}

private bool isDayOff
{
    get => _isDayOff;
    set
    {
        _isDayOff = value;

        if (selectedDay == null)
            return;

        if (_isDayOff)
        {
            selectedDay.WorkStart = null;
            selectedDay.WorkEnd = null;
        }
        else
        {
            selectedDay.WorkStart ??= new TimeSpan(8, 0, 0);
            selectedDay.WorkEnd ??= new TimeSpan(17, 0, 0);
            selectedDay.BreakMinutes ??= 60;
        }
    }
}

private bool _isDayOff;

private void UpdateSelectedDay()
{
    var existing = calendar.FirstOrDefault(x => x.WorkDate.Date == selectedDate.Date);

    if (existing != null)
    {
        selectedDay = existing;
        isDayOff = selectedDay.WorkStart == null || selectedDay.WorkEnd == null;
    }

        else
    {
        selectedDay = new CompanyCalendarModel { WorkDate = selectedDate };

        var isWeekend = selectedDate.DayOfWeek == DayOfWeek.Saturday 
                    || selectedDate.DayOfWeek == DayOfWeek.Sunday;

        isDayOff = isWeekend;

            if (!isDayOff)
            {
                selectedDay.WorkStart = new TimeSpan(8, 0, 0);
                selectedDay.WorkEnd = new TimeSpan(17, 0, 0);
                selectedDay.BreakMinutes = 60;
            }
    }

if (selectedDay.Breaks != null && selectedDay.Breaks.Any())
{
    breaks = selectedDay.Breaks.Select(x => new BreakItem(
        x.BreakStart,
        x.BreakEnd
    )
    {
        IsActive = x.IsActive
    }).ToList();
}
else
{
    breaks = new()
    {
        new BreakItem(new TimeSpan(10,0,0), new TimeSpan(10,15,0)),
        new BreakItem(new TimeSpan(12,0,0), new TimeSpan(12,30,0)),
        new BreakItem(new TimeSpan(15,0,0), new TimeSpan(15,15,0))
    };
}
}

private async Task Reset()
{
    if (selectedDay == null)
        return;

    var confirm = await JS.InvokeAsync<bool>("confirm", "Atjaunot uz standarta darba dienu?");
    if (!confirm)
        return;

    calendar.RemoveAll(x => x.WorkDate.Date == selectedDay.WorkDate.Date);

    UpdateSelectedDay();

    if (selectedDay != null)
    {
        selectedDay.WorkStart = new TimeSpan(8, 0, 0);
        selectedDay.WorkEnd = new TimeSpan(17, 0, 0);
        selectedDay.BreakMinutes = 60;
        isDayOff = false;
        breaks = new()
{
    new BreakItem(new TimeSpan(10,0,0), new TimeSpan(10,15,0)),
    new BreakItem(new TimeSpan(12,0,0), new TimeSpan(12,30,0)),
    new BreakItem(new TimeSpan(15,0,0), new TimeSpan(15,15,0))
};

        await Http.PostAsJsonAsync("api/companycalendar", selectedDay);
    }

    await JS.InvokeVoidAsync("alert", "Diena atjaunota kā darba diena");
}

private double GetWorkingHours(CompanyCalendarModel day)
{
    if (day.WorkStart == null || day.WorkEnd == null)
        return 0;

    var total = (day.WorkEnd.Value - day.WorkStart.Value).TotalHours;

var breaksList = breaks;

double breakHours = 0;

foreach (var b in breaksList.Where(x => x.IsActive))
{
    if (day.WorkStart <= b.To && day.WorkEnd >= b.From)
    {
        var overlapStart = day.WorkStart.Value > b.From ? day.WorkStart.Value : b.From;
        var overlapEnd = day.WorkEnd.Value < b.To ? day.WorkEnd.Value : b.To;

        breakHours += (overlapEnd - overlapStart).TotalHours;
    }
}

return total - breakHours;
}

private bool isRangeMode = false;

private DateTime rangeFrom = DateTime.Today;
private DateTime rangeTo = DateTime.Today;

private TimeSpan? rangeWorkStart = new TimeSpan(8, 0, 0);
private TimeSpan? rangeWorkEnd = new TimeSpan(17, 0, 0);
private int? rangeBreak = 60;

private bool showRangePopup = false;
private void ToggleRangeMode()
{
    showRangePopup = true;
}

private void OnRangeFromChanged(ChangeEventArgs e)
{
    rangeFrom = DateTime.Parse(e.Value!.ToString()!);
}

private void OnRangeToChanged(ChangeEventArgs e)
{
    rangeTo = DateTime.Parse(e.Value!.ToString()!);
}

private async Task ApplyRange()
{
    var confirm = await JS.InvokeAsync<bool>("confirm", "Vai pielietot izmaiņas visam izvēlētajam periodam?");
    if (!confirm)
        return;

    for (var date = rangeFrom.Date; date <= rangeTo.Date; date = date.AddDays(1))
    {
        var existing = calendar.FirstOrDefault(x => x.WorkDate.Date == date);

        var isDayOffRange = isDayOff;

        if (isDayOff)
        {
            selectedDay!.WorkStart = null;
            selectedDay.WorkEnd = null;
            selectedDay.BreakMinutes = null;
        }

var day = new CompanyCalendarModel
{
    WorkDate = date,
    WorkStart = isDayOffRange ? null : selectedDay?.WorkStart,
    WorkEnd = isDayOffRange ? null : selectedDay?.WorkEnd,
    BreakMinutes = isDayOffRange ? null : selectedDay?.BreakMinutes,
    Notes = existing?.Notes ?? selectedDay?.Notes,
    Breaks = breaks.Select(b => new CompanyCalendarBreakModel
    {
        WorkDate = date,
        BreakStart = b.From,
        BreakEnd = b.To,
        IsActive = b.IsActive
    }).ToList()
};

        await Http.PostAsJsonAsync("api/companycalendar", day);

        if (existing == null)
        {
            calendar.Add(day);
        }
        else
        {
            existing.WorkStart = day.WorkStart;
            existing.WorkEnd = day.WorkEnd;
            existing.BreakMinutes = day.BreakMinutes;
            existing.Notes = day.Notes;
        }
    }

    calendar = await Http.GetFromJsonAsync<List<CompanyCalendarModel>>("api/companycalendar") ?? new();
    UpdateSelectedDay();

    showRangePopup = false;
    await OnCalendarChanged.InvokeAsync();
    await JS.InvokeVoidAsync("alert", "Izmaiņas periodam saglabātas");
    
}


private ElementReference dateInputRef;

private async Task OpenDatePicker()
{
    await JS.InvokeVoidAsync("openDatePicker", dateInputRef);
}

private int GetHours(TimeSpan? time) => time?.Hours ?? 0;
private int GetMinutes(TimeSpan? time) => time?.Minutes ?? 0;

private TimeSpan? SetTime(int hours, int minutes)
{
    return new TimeSpan(hours, minutes, 0);
}

private ElementReference rangeFromRef;

private async Task OpenRangeFrom()
{
    await JS.InvokeVoidAsync("openDatePicker", rangeFromRef);
}

private ElementReference rangeToRef;

private async Task OpenRangeTo()
{
    await JS.InvokeVoidAsync("openDatePicker", rangeToRef);
}

private bool IsDbDayOff()
{
    return calendar.Any(x => x.WorkDate.Date == selectedDate.Date && x.WorkStart == null);
}

[Parameter]
public EventCallback OnCalendarChanged { get; set; }

private List<BreakItem> breaks = new()
{
    new BreakItem(new TimeSpan(10,0,0), new TimeSpan(10,15,0)),
    new BreakItem(new TimeSpan(12,0,0), new TimeSpan(12,30,0)),
    new BreakItem(new TimeSpan(15,0,0), new TimeSpan(15,15,0))
};

class BreakItem
{
    public TimeSpan From { get; set; }
    public TimeSpan To { get; set; }
    public bool IsActive { get; set; } = true;
    public BreakItem(TimeSpan from, TimeSpan to)
    {
        From = from;
        To = to;
    }
}

void UpdateBreak(BreakItem b, bool isFrom, int hour)
{
    if (isFrom)
        b.From = new TimeSpan(hour, b.From.Minutes, 0);
    else
        b.To = new TimeSpan(hour, b.To.Minutes, 0);

    if (b.From >= b.To)
    {
        b.To = b.From.Add(new TimeSpan(0, 15, 0));
    }

    // 🔥 OVERLAP FIX
    foreach (var other in breaks.Where(x => x != b))
    {
        var overlap =
            b.From < other.To &&
            b.To > other.From;

        if (overlap)
        {
            // nogriež līdz nākamā sākumam
            if (isFrom)
                b.From = other.To;
            else
                b.To = other.From;
        }
    }
}

void UpdateBreakMinutes(BreakItem b, bool isFrom, int min)
{
    if (isFrom)
        b.From = new TimeSpan(b.From.Hours, min, 0);
    else
        b.To = new TimeSpan(b.To.Hours, min, 0);

    if (b.From >= b.To)
    {
        b.To = b.From.Add(new TimeSpan(0, 15, 0));
    }

    // 🔥 OVERLAP FIX
    foreach (var other in breaks.Where(x => x != b))
    {
        var overlap =
            b.From < other.To &&
            b.To > other.From;

        if (overlap)
        {
            if (isFrom)
                b.From = other.To;
            else
                b.To = other.From;
        }
    }
}

void UpdateBreakActivity()
{
    if (selectedDay?.WorkStart == null || selectedDay?.WorkEnd == null)
        return;

    var workStart = selectedDay.WorkStart.Value;
    var workEnd = selectedDay.WorkEnd.Value;

    foreach (var b in breaks)
    {
        var inRange =
            b.From >= workStart &&
            b.To <= workEnd;

        //GALVENAIS FIX
        b.IsActive = inRange;
    }
}

void AddBreak()
{
    var last = breaks.LastOrDefault();

    var start = last?.To ?? (selectedDay?.WorkStart ?? new TimeSpan(8,0,0));

    breaks.Add(new BreakItem(
        start,
        start.Add(new TimeSpan(0,15,0))
    ));
}

void RemoveBreak(BreakItem b)
{
    b.IsActive = false;
}

}