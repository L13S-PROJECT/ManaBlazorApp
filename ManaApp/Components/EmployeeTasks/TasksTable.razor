@*Employee Tasks Table Component*@
@using ManaApp.Models

@if (!Tasks.Any())
{
    <p>Nav nākamo uzdevumu.</p>
}
else
{

    <table class="table">
        <thead>
            <tr>
                <th>Batch</th>
                <th>Nosaukums</th>
                <th>Detaļa</th>
                <th>Solis</th>
                <th>Statuss</th>
                <th>Apjoms</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var t in Tasks
                .OrderByDescending(t => t.Tasks_Push)
                .ThenBy(t => t.Status == 2 ? 0 : 1)
                .ThenBy(t => t.StepOrder)
                .ThenBy(t => t.TaskId))
            {
<tr class="@GetRowClass(t)"
    style="cursor: @(CanStart(t) ? "pointer" : "default")"
    @onclick="() => { if (CanStart(t)) OnSelect.InvokeAsync(t); }">
                    <td>@t.BatchCode</td>
                    <td>
                            @if (t.Assigned_To == null || t.Assigned_To == 0)
                            {
                                <span style="color:red;font-weight:bold;margin-right:4px;">!</span>
                            }
                        @t.ProductName
                    </td>
                    <td>@t.PartName</td>
                    <td>@t.StepName</td>
                    <td>
                        @StatusText(t.Status, t)
                    </td>

                    <td>
                        @if (t.StepType == 3)
                        {
                            @t.Done
                        }
                        else
                        {
                            @t.Planned
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    [Parameter] public IEnumerable<TaskRow> Tasks { get; set; } = Enumerable.Empty<TaskRow>();
    [Parameter] public Func<int, TaskRow, string> StatusText { get; set; } = default!;
    [Parameter] public Func<TaskRow, bool> CanStart { get; set; } = default!;
    [Parameter] public EventCallback<TaskRow> OnOpen { get; set; }
    [Parameter] public EventCallback<TaskRow> OnSelect { get; set; }
    [Parameter] public TaskRow? AvailableTask { get; set; }
    private string GetRowClass(TaskRow t)
    {
        if (t.Tasks_Push && t.Status == 1)
            return "task-push";

        if (t.Status == 2)
            return "table-warning";

        if (t.Status == 3)
            return "table-success";

        if (AvailableTask != null && t.TaskId == AvailableTask.TaskId)
            return "task-available";

        return "task-disabled";
    }

private TaskRow? FirstStartable =>
    Tasks.FirstOrDefault(t => t.Status == 1);

}

